<Project>
  <!-- Single source of truth for the product version across all projects. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
  </PropertyGroup>

  <!-- net10.0 everywhere. A .NET 11 preview SDK is installed on this machine;
         global.json pins the SDK to 10 and this pins the target. Do not raise
         either without a decision. Note that StemForge.Core targets net11.0 and
         is therefore never project-referenced — crateside drives stemforge-cli
         instead (docs/adr/0001-crateside-orchestrates-the-workflow.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Doc comments are written to files for the API's OpenAPI summaries (#167). Nothing requires
       one, and a <param> is written only where it says what the name cannot (CLAUDE.md), so a
       missing comment or param tag is not a fault. NoWarn rather than .editorconfig, which cannot
       reach Razor's generated code. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
</Project>
