{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Crateside.slnx",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run",
            "detail": "Run the board on localhost:5027. The way to exercise the pipeline — one clean process that will not restart under a download or a separation.",
            // The built exe rather than `dotnet run`, which holds the app in a job that kills
            // stemforge-cli when crateside exits (ADR 0042). What `dotnet run` would run, from
            // where, with the launch profile's environment.
            "type": "process",
            "command": "${workspaceFolder}/src/Crateside/bin/Debug/net10.0/Crateside.exe",
            "options": {
                "cwd": "${workspaceFolder}/src/Crateside",
                "env": {
                    "ASPNETCORE_ENVIRONMENT": "Development",
                    "ASPNETCORE_URLS": "http://localhost:5027"
                }
            },
            "dependsOn": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "detail": "Run the board with hot reload. For UI work only — see CLAUDE.md. Started by hand.",
            "type": "process",
            "command": "dotnet",
            "args": [
                "watch",
                "--project",
                "${workspaceFolder}/src/Crateside/Crateside.csproj",
                "run"
            ],
            "isBackground": true,
            // Does NOT autostart, and should not be started while anyone is editing. Hot reload
            // patches a running process in place: it updates method bodies but cannot reshape
            // objects that already exist, so a singleton keeps its old fields while its new code
            // reaches for ones that were never allocated. That is a NullReferenceException on
            // every tick of every drain loop, reported as "Hot reload succeeded". Use `run`.
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "base": "$msCompile",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*dotnet watch.*Started",
                    "endsPattern": "^.*dotnet watch.*(Exited|Waiting for a file to change)"
                }
            }
        },
        {
            "label": "test",
            "detail": "Run every test. The real-library tests assert against P:\\RYAN\\Ableton and the keytag ledger, and skip if those are absent.",
            "type": "process",
            "command": "dotnet",
            "args": ["test", "--solution", "${workspaceFolder}/Crateside.slnx"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "format",
            "detail": "Format the repo with CSharpier.",
            "type": "process",
            "command": "dotnet",
            "args": ["csharpier", "format", "${workspaceFolder}"],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "format: check",
            "detail": "Fail if anything is unformatted, without writing. What CI would run.",
            "type": "process",
            "command": "dotnet",
            "args": ["csharpier", "check", "${workspaceFolder}"],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "restore",
            "detail": "Restore packages and the local tool manifest (CSharpier).",
            "type": "process",
            "command": "dotnet",
            "args": ["restore", "${workspaceFolder}/Crateside.slnx"],
            "dependsOn": "restore: tools",
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "restore: tools",
            "type": "process",
            "command": "dotnet",
            "args": ["tool", "restore"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "clean",
            "type": "process",
            "command": "dotnet",
            "args": ["clean", "${workspaceFolder}/Crateside.slnx"],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
