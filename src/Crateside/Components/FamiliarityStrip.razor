@using Crateside.Core.Familiarity
@using Crateside.Core.Orchestration.Jobs
@using Crateside.Core.Tracks
@inject FamiliarityStore Familiarity
@inject TracksService Tracks
@inject ActionLog Actions

<ChoiceStrip Label="Familiarity" Choices="Choices" Value="@Row.Familiarity?.Written"
             Quiet="Row.Familiarity is null or { Written: null, LookedUpAt: null }"
             Note="@Note(Row.Familiarity)" Disabled="_working" OnChoose="Settle" />

@code {
    private bool _working;

    [Parameter, EditorRequired]
    public required TrackRow Row { get; set; }

    private IReadOnlyList<ChoiceStrip.Choice> Choices =>
        [
            .. FamiliarityVocabulary.All.Select(value => new ChoiceStrip.Choice(
                value,
                value,
                Row.Familiarity?.Written == value ? "settled" : null
            )),
        ];

    /// <summary>What the value rests on: the song's listeners and its article's yearly views.</summary>
    private static string Note(FamiliarityRecord? record) =>
        record switch
        {
            null or { LookedUpAt: null } => "not looked up yet",
            _ => string.Join(
                " · ",
                new[]
                {
                    record.Listeners is { } listeners
                        ? $"{listeners:N0} listeners"
                        : "no ListenBrainz match",
                    record.Pageviews is > 0 and var views
                        ? $"{views:N0} Wikipedia views a year"
                        : "no Wikipedia article",
                    record.Settled is null ? "from these numbers" : "your call",
                }
            ),
        };

    private async Task Settle(string? value)
    {
        if (value is null)
            return;

        _working = true;

        try
        {
            Familiarity.Settle(Row.Song, value);
            Actions.Record(Row.TrackKey, UserActionKind.FamiliaritySettled, value);

            await Tracks.RefreshAsync();
        }
        finally
        {
            _working = false;
        }
    }
}
