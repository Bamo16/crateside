@* The bar every page starts with. Declared once so the tabs cannot move between pages and a
   layout fix cannot land on three of the four. *@

<header class="top @Class(Shape)">
    <BrandNav Active="Active" />
    @ChildContent
</header>

@code {
    /// <summary>Which tab this page is.</summary>
    [Parameter]
    public BrandNav.Tab Active { get; set; }

    [Parameter]
    public Shapes Shape { get; set; }

    /// <summary>
    /// The cells beside the brand, which become the header's remaining columns — in
    /// <see cref="Shapes.Shade"/> only.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The three headers the app has — a closed set, so a new page chooses one rather than
    /// inventing a fourth.
    /// </summary>
    public enum Shapes
    {
        /// <summary>Brand and tabs, with room beneath before the page's own heading.</summary>
        Bar,

        /// <summary>The same, sitting directly on the content below it.</summary>
        Flush,

        /// <summary>
        /// Sticky, carrying what is running beside the brand, like a notification shade.
        /// </summary>
        Shade,
    }

    private static string Class(Shapes shape) => shape.ToString().ToLowerInvariant();
}
