@inherits LayoutComponentBase

@*
    No tabs. Every page anyone navigates to carries the header from BrandNav now, and a second
    set here would be the same three names on a different surface. What is left of this layout is
    the gutter, for the two error pages that have nowhere else to be.
*@

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
