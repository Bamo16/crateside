@using System.Globalization
@using Crateside.Core
@using Crateside.Core.Ledger
@inject KnownBuilds Builds

<div class="panel">
    <header class="head">
        <div class="titles">
            <h2>@Heading</h2>
            <p class="subtitle">
                @Summary
                @if (WindowsNote is { } windows)
                {
                    <text> · </text><a class="to-timeline" href="@WarpViewLink">@windows</a>
                }
            </p>
        </div>
        <button class="outline share" disabled title="Sharing arrives with #152 (the share card and menu).">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="M8 10V2M5 5l3-3 3 3M3 9v4h10V9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Share <span class="caret">▾</span>
        </button>
    </header>

    <div class="evidence">
        <section class="argument">
            @if (Run.Sections.Count > 1 && Run.Center is { } primary)
            {
                <h4 class="first">Centers</h4>
                <ul class="centers">
                    @foreach (var part in Run.Sections)
                    {
                        <li>
                            <span class="section-label"><ProseText Text="@part.Label" Inline="true" /></span>
                            <span class="mono center-key">@(ModeText.Arrow(part.Center, false) ?? ModeText.Tag(part.Center))</span>
                            <span class="muted">@(part.Center == primary ? "primary · the tag follows it" : null)</span>
                        </li>
                    }
                </ul>
            }

            <h3>@(Pending ? "Why the rules gave no ruling" : "Why this key")</h3>
            @if (!Pending && Run is { Candidates: [], TonicCheck: null, DecidedBy: DecidedBy.Judge })
            {
                <p class="older">An older verdict: one paragraph, as the judge wrote it, through the formatter.</p>
            }
            @if (Run.Reasoning is { Length: > 0 } reasoning)
            {
                <div class="reasoning"><ProseText Text="@reasoning" /></div>
            }
            else
            {
                <p class="muted">No reasoning was recorded for this run.</p>
            }

            @if (Run.Candidates.Count > 0)
            {
                <h4>@(Withheld ? "Still open" : "Considered")</h4>
                <ul class="considered">
                    @foreach (var candidate in Run.Candidates)
                    {
                        <li>
                            <span class="candidate-key"><ProseText Text="@candidate.Key" Inline="true" Mono="true" /></span>
                            <span class="candidate-why"><ProseText Text="@candidate.Why" Inline="true" /></span>
                        </li>
                    }
                </ul>
            }

            <h4>Human sources</h4>
            @if (Run.Sources.Count == 0)
            {
                <p class="muted">
                    @if (Pending)
                    {
                        <text>None found.</text>
                    }
                    else
                    {
                        <text>None found. Underground, non-Anglophone and recent album tracks often have no
                    human analysis at all — the verdict rests on the detectors@(Run.DecidedBy is DecidedBy.Rules ? "" : " and the chord check").</text>
                    }
                </p>
            }
            else
            {
                <ul class="sources">
                    @foreach (var source in Run.Sources.OrderByDescending(s => s.Kind))
                    {
                        <li class="source @source.Kind.ToString().ToLowerInvariant() @source.Stance.ToString().ToLowerInvariant()">
                            <span class="stance" title="@StanceTitle(source.Stance)">@StanceMark(source.Stance)</span>
                            <span class="kind" title="@KindTitle(source.Kind)">@KindLabel(source.Kind)</span>
                            <span class="said">
                                <span class="where">
                                    @if (source.Link is { } link)
                                    {
                                        <a href="@link" target="_blank" rel="noopener noreferrer">@(source.Host ?? link.ToString())</a>
                                    }
                                    @if (source.Via is { Length: > 0 } via)
                                    {
                                        <span class="via">@via</span>
                                    }
                                    @if (source.KindDisagreesWithHost)
                                    {
                                        <span class="problem" title="@HostMismatchTitle(source)">kind ≠ host</span>
                                    }
                                </span>
                                <span class="covers"><ProseText Text="@source.Covers" Inline="true" /></span>
                                @if (source.StatesKey is { Length: > 0 } stated)
                                {
                                    <span class="states-key"><ProseText Text="@ModeText.Stated(stated, source.StatesMode)" Inline="true" Mono="true" /></span>
                                    @if (source.Relation is { } relation)
                                    {
                                        <span class="relation"><ProseText Text="@relation" Inline="true" /></span>
                                    }
                                }
                                else if (source.States is { Length: > 0 } states)
                                {
                                    <span class="states"><ProseText Text="@states" Inline="true" /></span>
                                }
                                @if (source.Note is { Length: > 0 } note)
                                {
                                    <span class="note" title="The agent's note on this source."><ProseText Text="@note" Inline="true" /></span>
                                }
                            </span>
                        </li>
                    }
                </ul>
                @if (Run.Sources.Any(s => s.StatesKey is { Length: > 0 } && s.States is { Length: > 0 }))
                {
                    <details class="source-prose">
                        <summary>What each source actually said</summary>
                        <ul>
                            @foreach (var source in Run.Sources.Where(s => s.States is { Length: > 0 }))
                            {
                                <li><span class="host">@(source.Host ?? source.Via ?? "source")</span> <ProseText Text="@source.States" Inline="true" /></li>
                            }
                        </ul>
                    </details>
                }
            }

            @if (Run.FirstPass is { } firstPass)
            {
                <details class="first-pass">
                    <summary>First pass: withheld<span class="tail">@FirstPassTail</span></summary>
                    <div class="first-body"><ProseText Text="@firstPass" /></div>
                </details>
            }
        </section>

        <section class="measurements">
            @if (Run.Direction is { Length: > 0 } || Ear is not null)
            {
                <div class="direction">
                    @if (Run.Direction is { Length: > 0 } direction)
                    {
                        <h4 class="first">Your note to the judge</h4>
                        <p class="note-to-judge">"@direction"</p>
                    }
                    @if (Ear is { } ear)
                    {
                        <p class="ear-line">
                            Your ear: <span class="mono"><ProseText Text="@(ModeText.Stated(ear.StatesKey, ear.StatesMode) ?? ear.States)" Inline="true" Mono="true" /></span>
                            @if (ear.Note is { Length: > 0 } weight)
                            {
                                <text> · </text><ProseText Text="@weight" Inline="true" />
                            }
                            · run of @Run.Timestamp.ToLocalTime().ToString("d MMM, h:mm tt")
                        </p>
                    }
                </div>
            }

            @if (Run.Algorithms.Count > 0)
            {
                <h3>What the detectors reported</h3>
                <DetectorRows Algorithms="Run.Algorithms" Heads="true" />
                @if (Run.LateReading is { } late)
                {
                    <p class="muted late-reading">@late.Note(BuildLabel(late.Sha256))</p>
                }
            }
            else
            {
                <p class="muted no-readings">This run has no detector readings.</p>
            }

            @if (Run.Backers is { } backers)
            {
                <p class="backers">
                    keydetect is backed by
                    @(backers switch
                    {
                        [] => "neither madmom nor Essentia",
                        [var one] => $"{Shown(one)} only",
                        _ => "both madmom and Essentia",
                    })
                </p>
            }

            @if (Run.Agreement.FirstOrDefault(p => p.IsRelative) is { } split)
            {
                <p class="relative-split" title="@StatusTitle("relative")">
                    <strong>Relative split</strong>
                    @split.Detectors
                    landed on relative keys. Nothing in the numbers above can break this tie —
                    only the cadence or a human source.
                </p>
            }

            @if (Run.TonicCheck is { Length: > 0 } tonicCheck)
            {
                <h4>Tonic check</h4>
                <div class="tonic-check"><ProseText Text="@tonicCheck" /></div>
            }

            @if (Run.Chords.Count > 0)
            {
                var progression = Progression.Fold(Run.Chords);
                var folds = progression.Any(segment => segment.IsLoop);

                <div class="chords-head">
                    <h4>Chord progression</h4>
                    <span class="chords-count">@("chord".ToQuantity(Run.Chords.Count))@(folds && !_chordsOpen ? " · loops folded" : null)</span>
                    @if (folds)
                    {
                        <button class="link" @onclick="() => _chordsOpen = !_chordsOpen">@(_chordsOpen ? "Fold the loops" : $"Show all {Run.Chords.Count}")</button>
                    }
                </div>

                @if (_chordsOpen || !folds)
                {
                    <p class="chords all">@string.Join(' ', Run.Chords.Select(JudgeProse.Chord))</p>
                }
                else
                {
                    <p class="chords">
                        @foreach (var (segment, index) in progression.Select((segment, index) => (segment, index)))
                        {
                            @if (index > 0)
                            {
                                <span class="sep"> · </span>
                            }
                            <span class="run">@segment.Arrowed@if (segment.IsLoop) { <span class="repeats">&nbsp;×@segment.Repeats</span> }</span>
                        }
                    </p>
                }
            }

            <h4>Tempo</h4>
            @if (Tempo is { } tempo)
            {
                var shown = TempoFormat.Format(tempo);
                <p class="tempo">
                    <strong class="mono @(shown.IsApproximate ? "approx" : null) @(shown.IsEstimate ? "estimate" : null)">@shown.Text</strong>
                    <span class="tempo-note">@shown.Note</span>
                </p>
                <ul class="tempo-sources">
                    @foreach (var line in TempoFormat.Others(tempo))
                    {
                        <li>
                            <span class="label">@line.Label</span>
                            <span class="mono figure @(line.Figure?.IsApproximate is true ? "approx" : null)">@(line.Figure?.Text ?? "—")<span class="pad">@(line.Figure?.Padding ?? ".00")</span></span>
                            <span class="comment @(line.IsConflict ? "conflict" : null)">@line.Comment</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="tempo"><span class="muted">Not measured.</span></p>
            }

            <p class="provenance muted">
                Recorded @Run.Timestamp.ToLocalTime().ToString($"yyyy-MM-dd {CultureInfo.CurrentCulture.DateTimeFormat.ShortTimePattern}")
                @if (Run.InputKind is { Length: > 0 } kind)
                {
                    <text> from the @kind.Replace('_', ' ')</text>
                }
            </p>
        </section>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required RunEvidence Run { get; set; }

    /// <summary>The head line: <c>Why E major</c>, or <c>Why no key</c> for a withheld verdict.</summary>
    [Parameter, EditorRequired]
    public required string Heading { get; set; }

    /// <summary>What the verdict rested on, in one line under the head.</summary>
    [Parameter]
    public string? Summary { get; set; }

    /// <summary>Whether the run is no verdict at all: the evidence of a track the rules left open.</summary>
    [Parameter]
    public bool Pending { get; set; }

    /// <summary>Whether the verdict is WITHHELD, whose Considered keys are still open.</summary>
    [Parameter]
    public bool Withheld { get; set; }

    /// <summary>Where the warp view is, for the note that leads to the windows drawn there; null where there is none.</summary>
    [Parameter]
    public string? WarpViewLink { get; set; }

    /// <summary>The song's headline tempo; the panel lists its other sources under it.</summary>
    [Parameter]
    public TrackTempo? Tempo { get; set; }

    private bool _chordsOpen;

    private string? BuildLabel(string? sha256) =>
        sha256 is null
            ? null
            : Builds
                .All(FfmpegFilter.Keydetect)
                .FirstOrDefault(known => known.Build.Sha256.Equals(sha256, StringComparison.OrdinalIgnoreCase))
                ?.Build.Label;

    /// <summary>What the user said they hear, recorded as a source of its own kind.</summary>
    private EvidenceSource? Ear => Run.Sources.FirstOrDefault(source => source.Kind is SourceKind.Ear);

    private string? WindowsNote =>
        WarpViewLink is not null && Run.Windows is { Count: > 0 } windows
            ? windows.Select(window => window.AskedBy).Distinct().ToList() switch
            {
                [WindowAsker.User] => $"{"window".ToQuantity(windows.Count)} of yours on the timeline ↑",
                [WindowAsker.Judge] or [null] => $"{windows.Count} judge's {"window".ToQuantity(windows.Count, ShowQuantityAs.None)} on the timeline ↑",
                _ => $"{"window".ToQuantity(windows.Count)} on the timeline ↑",
            }
            : null;

    private string FirstPassTail =>
        Run.Windows.Count(window => window.AskedBy is not WindowAsker.User) is > 0 and var asked
            ? $" · asked for {"window".ToQuantity(asked)}"
            : string.Empty;

    /// <summary>A backer as the detector table names it.</summary>
    private static string Shown(string backer) =>
        backer switch
        {
            "essentia_edma" => "Essentia",
            _ => backer,
        };

    private static string StanceMark(SourceStance stance) =>
        stance switch
        {
            SourceStance.Agrees => "✓",
            SourceStance.Dissents => "✗",
            _ => "·",
        };

    private static string StanceTitle(SourceStance stance) =>
        stance switch
        {
            SourceStance.Agrees => "This source names the same key as the verdict.",
            SourceStance.Dissents =>
                "This source names a different key. Not necessarily a defect — an algorithmic dissent does not demote a verdict — but read the note.",
            _ => "This source said something that is not a key, so there is nothing to compare.",
        };

    private static string HostMismatchTitle(EvidenceSource source) =>
        $"Recorded as {source.RecordedKind}, but its host is cataloged as "
        + $"{KindLabel(source.KindFromHost)}. Worth a look: filing a chord recognizer as anything "
        + "else is the mistake the hard rule exists to prevent.";

    private static string KindLabel(SourceKind kind) =>
        kind switch
        {
            SourceKind.Authoritative => "authoritative",
            SourceKind.Corroborating => "corroborating",
            SourceKind.Algorithmic => "algorithmic",
            SourceKind.ChordRecognizer => "chords only",
            SourceKind.Unclassified => "unclassified",
            _ => "no link",
        };

    private static string KindTitle(SourceKind kind) =>
        kind switch
        {
            SourceKind.Authoritative =>
                "Human analysis or published sheet music. Authoritative on the tonic.",
            SourceKind.Corroborating => "Human transcription. Solid, but consensus-dependent.",
            SourceKind.Algorithmic =>
                "Shares the failure modes this tool exists to catch — corroboration only, never the answer.",
            SourceKind.ChordRecognizer =>
                "An automatic chord recognizer. Its chords are evidence; its key is another algorithm's guess and may never be the basis of a verdict.",
            SourceKind.Unclassified => "Neither recorded nor a host the catalog lists — read the agent's note.",
            _ => "No link to judge by.",
        };

    private static string StatusTitle(string status) =>
        status.ToLowerInvariant() switch
        {
            "relative" =>
                "The dangerous one: relative keys share every note, so no confidence value can break this tie — only the cadence, or a human source.",
            "single" => "Only one of the two produced an answer, so there was nothing to compare.",
            _ => "The two disagree outright.",
        };
}
