@using System.Globalization
@using Crateside.Core.Ledger

<div class="evidence">
    <section class="argument">
        <h3>Why this key</h3>
        @if (Run.Reasoning is { Length: > 0 } reasoning)
        {
            <p class="reasoning">@reasoning</p>
        }
        else
        {
            <p class="muted">No reasoning was recorded for this run.</p>
        }

        @if (Run.Sections.Count > 1 && Run.Centre is { } primary)
        {
            <h4>Centres</h4>
            <ul class="centres">
                @foreach (var part in Run.Sections)
                {
                    <li>
                        <span class="section-label">@part.Label</span>
                        <span class="mono centre-key">@(ModeText.Arrow(part.Centre, false) ?? ModeText.Tag(part.Centre))</span>
                        <span class="muted">@(part.Centre == primary ? "primary · the tag follows it" : null)</span>
                    </li>
                }
            </ul>
        }

        <h4>Human sources</h4>
        @if (Run.Sources.Count == 0)
        {
            <p class="muted">
                None found. Underground, non-Anglophone and recent album tracks often have no
                human analysis at all — the verdict rests on the detectors and the chord check.
            </p>
        }
        else
        {
            <ul class="sources">
                @foreach (var source in Run.Sources.OrderByDescending(s => s.Kind))
                {
                    <li class="source @source.Kind.ToString().ToLowerInvariant() @source.Stance.ToString().ToLowerInvariant()">
                        <span class="stance" title="@StanceTitle(source.Stance)">@StanceMark(source.Stance)</span>
                        <span class="kind" title="@KindTitle(source.Kind)">@KindLabel(source.Kind)</span>
                        <span class="said">
                            <span class="where">
                                @if (source.Link is { } link)
                                {
                                    <a href="@link" target="_blank" rel="noopener noreferrer">@(source.Host ?? link.ToString())</a>
                                }
                                @if (source.Via is { Length: > 0 } via)
                                {
                                    <span class="via">@via</span>
                                }
                                @if (source.KindDisagreesWithHost)
                                {
                                    <span class="problem" title="@HostMismatchTitle(source)">kind ≠ host</span>
                                }
                            </span>
                            <span class="covers">@source.Covers</span>
                            @if (source.StatesKey is { Length: > 0 } stated)
                            {
                                <span class="states-key">@ModeText.Stated(stated, source.StatesMode)</span>
                                @if (source.Relation is { } relation)
                                {
                                    <span class="relation">@relation</span>
                                }
                            }
                            else if (source.States is { Length: > 0 } states)
                            {
                                <span class="states">@states</span>
                            }
                            @if (source.Note is { Length: > 0 } note)
                            {
                                <span class="note" title="The agent's note on this source.">@note</span>
                            }
                        </span>
                    </li>
                }
            </ul>
            @if (Run.Sources.Any(s => s.StatesKey is { Length: > 0 } && s.States is { Length: > 0 }))
            {
                <details class="source-prose">
                    <summary>What each source actually said</summary>
                    <ul>
                        @foreach (var source in Run.Sources.Where(s => s.States is { Length: > 0 }))
                        {
                            <li><span class="host">@(source.Host ?? source.Via ?? "source")</span> @source.States</li>
                        }
                    </ul>
                </details>
            }
        }
    </section>

    <section class="measurements">
        @if (Run.Direction is { Length: > 0 } || Ear is not null)
        {
            <div class="direction">
                @if (Run.Direction is { Length: > 0 } direction)
                {
                    <h4>Your note to the judge</h4>
                    <p class="note-to-judge">"@direction"</p>
                }
                @if (Ear is { } ear)
                {
                    <p class="ear-line">
                        Your ear: <span class="mono">@(ModeText.Stated(ear.StatesKey, ear.StatesMode) ?? ear.States)</span>
                        @if (ear.Note is { Length: > 0 } weight)
                        {
                            <text> · @weight</text>
                        }
                        · run of @Run.Timestamp.ToLocalTime().ToString("d MMM, h:mm tt")
                    </p>
                }
            </div>
        }

        @if (Run.Readings.Count > 0)
        {
            <h3>Windows</h3>
            @if (SharedWhy is { } shared)
            {
                <details class="source-prose">
                    <summary>Why the judge asked for these windows</summary>
                    <p>“@shared”</p>
                </details>
            }
            @foreach (var reading in Run.Readings)
            {
                var yours = reading.Window.AskedBy is WindowAsker.User;

                <div class="window @(yours ? "yours" : "judges")">
                    <div class="window-who">
                        <span class="who-line">
                            <span class="who">@(yours ? "yours" : "judge")</span>
                            <span class="window-label">@(reading.Window.Label ?? (yours ? "Window" : "Asked for"))</span>
                        </span>
                        <span class="mono span">@WindowSpan(reading.Window)</span>
                        <span class="why">
                            @(yours
                                ? "Given by you."
                                : SharedWhy is null && reading.Window.Why is { Length: > 0 } why
                                    ? $"The judge asked for it: “{why}” crateside ran it unattended."
                                    : "The judge asked for it, and crateside ran it unattended.")
                        </span>
                    </div>
                    <div class="window-readings">
                        <table class="algorithms">
                            <tbody>
                                @foreach (var algorithm in reading.Algorithms)
                                {
                                    <tr>
                                        <th>@algorithm.Name</th>
                                        <td class="algo-key">@(algorithm.Key ?? "—")</td>
                                        <td class="detail">
                                            @if (algorithm.Error is { Length: > 0 } error)
                                            {
                                                <span class="problem">@error</span>
                                            }
                                            else if (algorithm.Confidence is { } confidence)
                                            {
                                                <span>@confidence.ToString("F3")</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <span class="became">
                            @(reading.Section is { } section
                                ? $"→ section {section.Label}: {ModeText.Named(section.Centre)}"
                                : "→ no section: the judge did not place this window as a centre of its own")
                        </span>
                    </div>
                </div>
            }
        }

        @if (Run.Readings.Count > 0)
        {
            <details class="whole-file">
                <summary>The whole file <span class="muted">· @WholeFile</span></summary>
                @Measurements
            </details>
        }
        else
        {
            @Measurements
        }
    </section>
</div>

@code {
    private const int CompactChordLimit = 24;

    [Parameter, EditorRequired]
    public required RunEvidence Run { get; set; }

    /// <summary>Trims to what answers "why this key" at a glance.</summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>The song's headline tempo; the panel lists its other sources under it.</summary>
    [Parameter]
    public TrackTempo? Tempo { get; set; }

    /// <summary>What the user said they hear, recorded as a source of its own kind.</summary>
    /// <summary>The judge's one reason for asking, when every window it asked for carries the same one.</summary>
    private string? SharedWhy =>
        Run.Readings.Where(reading => reading.Window.AskedBy is not WindowAsker.User)
            .Select(reading => reading.Window.Why)
            .ToList() is [_, _, ..] whys
        && whys.Distinct().ToList() is [{ Length: > 0 } why]
            ? why
            : null;

    private EvidenceSource? Ear => Run.Sources.FirstOrDefault(source => source.Kind is SourceKind.Ear);

    private static string WindowSpan(RunWindow window) =>
        window.Bars is { } bars
            ? $"bars {bars.First}–{bars.Last} · {JudgeText.Time(window)}"
            : JudgeText.Time(window);

    /// <summary>The whole-file detectors in a phrase: agreed, or split how many ways.</summary>
    private string WholeFile =>
        Run.Algorithms.Select(algorithm => algorithm.Key).OfType<string>().Distinct(StringComparer.OrdinalIgnoreCase).ToList() switch
        {
            [] => "no reading",
            [var one] => $"agreed on {KeyText.Spell(one)}",
            var keys => $"split {keys.Count.ToWords()} ways: {string.Join(", ", keys.Select(KeyText.Spell))}",
        };

    private RenderFragment Measurements =>
        @<div class="whole">
        <h3>What the detectors reported</h3>

        <table class="algorithms">
            <tbody>
                @foreach (var algorithm in Run.Algorithms)
                {
                    <tr>
                        <th>@algorithm.Name</th>
                        <td class="algo-key">@(algorithm.Key ?? "—")</td>
                        <td class="detail">
                            @if (algorithm.Error is { Length: > 0 } error)
                            {
                                <span class="problem">@error</span>
                            }
                            else
                            {
                                @if (algorithm.Confidence is { } confidence)
                                {
                                    <span>@confidence.ToString("F3")</span>
                                    @if (algorithm.Flag is { Length: > 0 } flag)
                                    {
                                        <span class="flag @flag.ToLowerInvariant()">@flag</span>
                                    }
                                }
                                @if (algorithm.RunnerUpKey is { } runnerUp)
                                {
                                    <span title="How close second place was.">
                                        runner-up @runnerUp @((algorithm.RunnerUpRatio ?? algorithm.RunnerUpConfidence) is { } r ? $"({r:F3})" : null)
                                    </span>
                                }
                                @if (algorithm.Reranked is true)
                                {
                                    <span title="The chord rerank changed keydetect's answer.">reranked</span>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Run.Backers is { } backers)
        {
            <p class="backers">
                keydetect is backed by
                @(backers switch
                {
                    [] => "neither madmom nor edma",
                    [var one] => $"{Shown(one)} only",
                    _ => "both madmom and edma",
                })
            </p>
        }

        @if (Run.Agreement.FirstOrDefault(p => p.IsRelative) is { } split)
        {
            <p class="relative-split" title="@StatusTitle("relative")">
                <strong>Relative split</strong>
                <span class="pair">@split.Pair</span>
                landed on relative keys. Nothing in the numbers above can break this tie —
                only the cadence or a human source.
            </p>
        }

        @if (Run.TonicCheck is { Length: > 0 } tonicCheck)
        {
            <h4>Tonic check</h4>
            <p class="tonic-check">@tonicCheck</p>
        }

        @if (Run.Chords.Count > 0)
        {
            <h4>Chord progression</h4>
            <p class="chords">
                @string.Join(" → ", Compact ? Run.Chords.Take(CompactChordLimit) : Run.Chords)
                @if (Compact && Run.Chords.Count > CompactChordLimit)
                {
                    <span class="muted"> (+@(Run.Chords.Count - CompactChordLimit) more)</span>
                }
            </p>
        }

        @if (!Compact && Run.KeyEvents.Count > 0)
        {
            <details class="flicker-fold">
                <summary>Key flicker · @("change".ToQuantity(Run.KeyEvents.Count))</summary>
                <ul class="flicker">
                    @foreach (var e in Run.KeyEvents)
                    {
                        <li><span class="t">@e.Seconds.ToString("F2")s</span> @e.Key <span class="r">r=@e.R.ToString("F2")</span></li>
                    }
                </ul>
            </details>
        }

        <h4>Tempo</h4>
        @if (Tempo is { } tempo)
        {
            var shown = TempoFormat.Format(tempo);
            <p class="tempo">
                <strong class="mono @(shown.IsApproximate ? "approx" : null) @(shown.IsEstimate ? "estimate" : null)">@shown.Text</strong>
                <span class="tempo-note">@shown.Note</span>
            </p>
            <ul class="tempo-sources">
                @foreach (var line in TempoFormat.Others(tempo))
                {
                    <li>
                        <span class="label">@line.Label</span>
                        <span class="mono figure @(line.Figure?.IsApproximate is true ? "approx" : null)">@(line.Figure?.Text ?? "—")<span class="pad">@(line.Figure?.Padding ?? ".00")</span></span>
                        <span class="comment @(line.IsConflict ? "conflict" : null)">@line.Comment</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="tempo"><span class="muted">Not measured.</span></p>
        }

        <p class="provenance muted">
            Recorded @Run.Timestamp.ToLocalTime().ToString($"yyyy-MM-dd {CultureInfo.CurrentCulture.DateTimeFormat.ShortTimePattern}")
            @if (Run.InputKind is { Length: > 0 } kind)
            {
                <text> from the @kind.Replace('_', ' ')</text>
            }
        </p>
        </div>;

    /// <summary>A backer as the detector table names it.</summary>
    private static string Shown(string backer) =>
        backer switch
        {
            "essentia_edma" => "edma",
            _ => backer,
        };

    private static string StanceMark(SourceStance stance) =>
        stance switch
        {
            SourceStance.Agrees => "✓",
            SourceStance.Dissents => "✗",
            _ => "·",
        };

    private static string StanceTitle(SourceStance stance) =>
        stance switch
        {
            SourceStance.Agrees => "This source names the same key as the verdict.",
            SourceStance.Dissents =>
                "This source names a different key. Not necessarily a defect — an algorithmic dissent does not demote a verdict — but read the note.",
            _ => "This source said something that is not a key, so there is nothing to compare.",
        };

    private static string HostMismatchTitle(EvidenceSource source) =>
        $"Recorded as {source.RecordedKind}, but its host is catalogued as "
        + $"{KindLabel(source.KindFromHost)}. Worth a look: filing a chord recogniser as anything "
        + "else is the mistake the hard rule exists to prevent.";

    private static string KindLabel(SourceKind kind) =>
        kind switch
        {
            SourceKind.Authoritative => "authoritative",
            SourceKind.Corroborating => "corroborating",
            SourceKind.Algorithmic => "algorithmic",
            SourceKind.ChordRecogniser => "chords only",
            SourceKind.Unclassified => "unclassified",
            _ => "no link",
        };

    private static string KindTitle(SourceKind kind) =>
        kind switch
        {
            SourceKind.Authoritative =>
                "Human analysis or published sheet music. Authoritative on the tonic.",
            SourceKind.Corroborating => "Human transcription. Solid, but consensus-dependent.",
            SourceKind.Algorithmic =>
                "Shares the failure modes this tool exists to catch — corroboration only, never the answer.",
            SourceKind.ChordRecogniser =>
                "An automatic chord recogniser. Its chords are evidence; its key is another algorithm's guess and may never be the basis of a verdict.",
            SourceKind.Unclassified => "Neither recorded nor a host the catalog lists — read the agent's note.",
            _ => "No link to judge by.",
        };

    private static string StatusTitle(string status) =>
        status.ToLowerInvariant() switch
        {
            "relative" =>
                "The dangerous one: relative keys share every note, so no confidence value can break this tie — only the cadence, or a human source.",
            "single" => "Only one of the two produced an answer, so there was nothing to compare.",
            _ => "The two disagree outright.",
        };
}
