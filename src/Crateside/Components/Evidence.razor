@using Crateside.Core.Ledger

<div class="evidence">
    <section class="argument">
        <h3>Why this key</h3>
        @if (Run.Reasoning is { Length: > 0 } reasoning)
        {
            <p class="reasoning">@reasoning</p>
        }
        else
        {
            <p class="muted">No reasoning was recorded for this run.</p>
        }

        <h4>Human sources</h4>
        @if (Run.Sources.Count == 0)
        {
            <p class="muted">
                None found. Underground, non-Anglophone and recent album tracks often have no
                human analysis at all — the verdict rests on the detectors and the chord check.
            </p>
        }
        else
        {
            <ul class="sources">
                @foreach (var source in Run.Sources.OrderByDescending(s => s.Kind))
                {
                    <li class="source @source.Kind.ToString().ToLowerInvariant() @source.Stance.ToString().ToLowerInvariant()">
                        <span class="stance" title="@StanceTitle(source.Stance)">@StanceMark(source.Stance)</span>
                        <span class="kind" title="@KindTitle(source.Kind)">@KindLabel(source.Kind)</span>
                        @if (source.Link is { } link)
                        {
                            <a href="@link" target="_blank" rel="noopener noreferrer">@(source.Host ?? link.ToString())</a>
                        }
                        @if (source.Via is { Length: > 0 } via)
                        {
                            <span class="via">@via</span>
                        }
                        @if (source.StatesKey is { Length: > 0 } stated)
                        {
                            <span class="states-key">@stated@(source.StatesMode is { Length: > 0 } m ? $" ({m})" : null)</span>
                        }
                        else if (source.States is { Length: > 0 } states)
                        {
                            <span class="states">@states</span>
                        }
                        @if (source.Note is { Length: > 0 } note)
                        {
                            <span class="note" title="The agent's note on this source.">@note</span>
                        }
                        @if (source.KindDisagreesWithHost)
                        {
                            <span class="problem" title="@HostMismatchTitle(source)">kind ≠ host</span>
                        }
                    </li>
                }
            </ul>
            @if (Run.Sources.Any(s => s.StatesKey is { Length: > 0 } && s.States is { Length: > 0 }))
            {
                <details class="source-prose">
                    <summary>What each source actually said</summary>
                    <ul>
                        @foreach (var source in Run.Sources.Where(s => s.States is { Length: > 0 }))
                        {
                            <li><span class="host">@(source.Host ?? source.Via ?? "source")</span> @source.States</li>
                        }
                    </ul>
                </details>
            }
        }
    </section>

    <section class="measurements">
        <h3>What the detectors reported</h3>

        <table class="algorithms">
            <tbody>
                @foreach (var algorithm in Run.Algorithms)
                {
                    <tr>
                        <th>@algorithm.Name</th>
                        <td class="algo-key">@(algorithm.Key ?? "—")</td>
                        <td class="detail">
                            @if (algorithm.Error is { Length: > 0 } error)
                            {
                                <span class="problem">@error</span>
                            }
                            else if (algorithm.RunnerUpKey is { } runnerUp)
                            {
                                <span title="CREMA reports no usable confidence; this is how close second place was.">
                                    runner-up @runnerUp @(algorithm.RunnerUpRatio is { } r ? $"({r:F3})" : null)
                                </span>
                            }
                            else if (algorithm.Confidence is { } confidence)
                            {
                                <span>@confidence.ToString("F3")</span>
                                @if (algorithm.Flag is { Length: > 0 } flag)
                                {
                                    <span class="flag @flag.ToLowerInvariant()">@flag</span>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Run.Agreement.FirstOrDefault(p => p.IsRelative) is { } split)
        {
            <p class="relative-split" title="@StatusTitle("relative")">
                <strong>Relative split</strong>
                <span class="pair">@split.Pair</span>
                landed on relative keys. Nothing in the numbers above can break this tie —
                only the cadence or a human source.
            </p>
        }

        @if (Run.TonicCheck is { Length: > 0 } tonicCheck)
        {
            <h4>Tonic check</h4>
            <p class="tonic-check">@tonicCheck</p>
        }

        @if (Run.Chords.Count > 0)
        {
            <h4>Chord progression</h4>
            <p class="chords">
                @string.Join(" → ", Compact ? Run.Chords.Take(CompactChordLimit) : Run.Chords)
                @if (Compact && Run.Chords.Count > CompactChordLimit)
                {
                    <span class="muted"> (+@(Run.Chords.Count - CompactChordLimit) more)</span>
                }
            </p>
        }

        @if (!Compact && Run.KeyEvents.Count > 0)
        {
            <h4>Key flicker</h4>
            <ul class="flicker">
                @foreach (var e in Run.KeyEvents)
                {
                    <li><span class="t">@e.Seconds.ToString("F2")s</span> @e.Key <span class="r">r=@e.R.ToString("F2")</span></li>
                }
            </ul>
        }

        <h4>Tempo</h4>
        <p class="tempo">
            @if (Run.Bpm is { } bpm)
            {
                <strong>@Math.Round(bpm)</strong>
                <span class="muted">from @(Run.BpmSource ?? "unknown")</span>
            }
            else
            {
                <span class="muted">No recommendation recorded.</span>
            }
            @if (Run.BeatdetectBpm is { } rough)
            {
                <span class="beatdetect @(Run.BpmConflicts ? "conflict" : null)"
                      title="The runner's own estimate, kept as a cross-check. Frequently wrong, especially by a factor of two.">
                    beatdetect @rough.ToString("F1")
                </span>
            }
            @if (Run.BpmConflicts)
            {
                <span class="problem"
                      title="Not a clean half or double, so this is not just a tempo-octave choice — one of the two is simply wrong.">
                    conflict
                </span>
            }
        </p>

        <p class="provenance muted">
            Recorded @Run.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            @if (Run.InputKind is { Length: > 0 } kind)
            {
                <text> from the @kind.Replace('_', ' ')</text>
            }
        </p>
    </section>
</div>

@code {
    private const int CompactChordLimit = 24;

    [Parameter, EditorRequired]
    public required RunEvidence Run { get; set; }

    /// <summary>Trims to what answers "why this key" at a glance.</summary>
    [Parameter]
    public bool Compact { get; set; }

    private static string StanceMark(SourceStance stance) =>
        stance switch
        {
            SourceStance.Agrees => "✓",
            SourceStance.Dissents => "✗",
            _ => "·",
        };

    private static string StanceTitle(SourceStance stance) =>
        stance switch
        {
            SourceStance.Agrees => "This source names the same key as the verdict.",
            SourceStance.Dissents =>
                "This source names a different key. Not necessarily a defect — an algorithmic dissent does not demote a verdict — but read the note.",
            _ => "This source said something that is not a key, so there is nothing to compare.",
        };

    private static string HostMismatchTitle(EvidenceSource source) =>
        $"Recorded as {source.RecordedKind}, but its host is catalogued as "
        + $"{KindLabel(source.KindFromHost)}. Worth a look: filing a chord recogniser as anything "
        + "else is the mistake the hard rule exists to prevent.";

    private static string KindLabel(SourceKind kind) =>
        kind switch
        {
            SourceKind.Authoritative => "authoritative",
            SourceKind.Corroborating => "corroborating",
            SourceKind.Algorithmic => "algorithmic",
            SourceKind.ChordRecogniser => "chords only",
            SourceKind.Unclassified => "unclassified",
            _ => "no link",
        };

    private static string KindTitle(SourceKind kind) =>
        kind switch
        {
            SourceKind.Authoritative =>
                "Human analysis or published sheet music. Authoritative on the tonic.",
            SourceKind.Corroborating => "Human transcription. Solid, but consensus-dependent.",
            SourceKind.Algorithmic =>
                "Shares the failure modes this tool exists to catch — corroboration only, never the answer.",
            SourceKind.ChordRecogniser =>
                "An automatic chord recogniser. Its chords are evidence; its key is another algorithm's guess and may never be the basis of a verdict.",
            SourceKind.Unclassified => "Neither recorded nor a host the catalog lists — read the agent's note.",
            _ => "No link to judge by.",
        };

    private static string StatusTitle(string status) =>
        status.ToLowerInvariant() switch
        {
            "relative" =>
                "The dangerous one: relative keys share every note, so no confidence value can break this tie — only the cadence, or a human source.",
            "single" => "Only one of the two produced an answer, so there was nothing to compare.",
            _ => "The two disagree outright.",
        };
}
