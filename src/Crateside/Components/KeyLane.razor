@using Crateside.Core.Ledger
@using Crateside.Core.Warps

@if (!Plan.IsEmpty)
{
    <span class="gutter key-gutter">
        <span class="key-name">Key</span>
        <span class="gist">@Gist</span>
        @foreach (var unplaced in Plan.Unplaced)
        {
            <span class="mono unplaced"><ProseText Text="@unplaced.Label" Inline="true" /> · @KeyStrip.Short(unplaced.Center): no window placed it</span>
        }
    </span>
    <div class="key-strip">
        @foreach (var band in Plan.Bands)
        {
            var (left, right) = (Math.Clamp(X(band.Start), 0, 100), Math.Clamp(X(band.End), 0, 100));
            @if (right > left)
            {
                <button type="button" class="key-band @(band.FromWindow ? "from-window" : null) @(band.Section is { Length: > 0 } ? "pickable" : null) @(IsPicked(band) ? "picked" : null) @(X(band.Start) < 0 ? "open-left" : null) @(X(band.End) > 100 ? "open-right" : null)" style="left: @P(left)%; width: @P(right - left)%" title="@Title(band)" data-start="@P(band.Start)"
                     @onclick="() => PickAsync(band)">
                    @if ((right - left) / 100 * PlotPixels >= 56)
                    {
                        <span class="mono key-label">@KeyStrip.Text(Run, band)</span>
                    }
                </button>
            }
        }
        @Bands
    </div>
}

@if (!Plan.IsEmpty || Run.Chords is not [])
{
    <span class="gutter chord-gutter">
        <span class="key-name">Chords</span>
        @if (Run.Chords is [])
        {
            <span class="gist">none read</span>
        }
        else if (ChordBands is [])
        {
            <span class="gist">chord times pending: reading the track again</span>
        }
    </span>
    <div class="chord-strip">
        @foreach (var band in ChordBands)
        {
            var (left, right) = (Math.Clamp(X(band.Start), 0, 100), Math.Clamp(X(band.End), 0, 100));
            @if (right > left)
            {
                <button type="button" class="key-band chord-band @(X(band.Start) < 0 ? "open-left" : null) @(X(band.End) > 100 ? "open-right" : null)" style="left: @P(left)%; width: @P(right - left)%" title="@ChordTitle(band)" data-start="@P(band.Start)">
                    @if ((right - left) / 100 * PlotPixels >= band.Label.Length * ChordCharacterPixels + ChordLabelPadding)
                    {
                        <span class="mono chord-label">@band.Label</span>
                    }
                </button>
            }
        }
        @Bands
    </div>
}

@code {
    /// <summary>The pixels a plot is at the page's width cap, for deciding whether a label has room.</summary>
    private const double PlotPixels = 832;

    /// <summary>The pixels a chord's name takes per character, and what its block needs besides.</summary>
    private const double ChordCharacterPixels = 7;
    private const double ChordLabelPadding = 6;

    [Parameter, EditorRequired]
    public required RunEvidence Run { get; set; }

    /// <summary>The track's length in seconds.</summary>
    [Parameter, EditorRequired]
    public double Seconds { get; set; }

    /// <summary>The stretch of the track in view, in seconds.</summary>
    [Parameter, EditorRequired]
    public double From { get; set; }

    [Parameter, EditorRequired]
    public double To { get; set; }

    /// <summary>The label of the section whose findings are shown below; null for the whole track.</summary>
    [Parameter]
    public string? SelectedSection { get; set; }

    [Parameter]
    public EventCallback<string?> SelectedSectionChanged { get; set; }

    /// <summary>The window bands that run through every row, drawn over this one too.</summary>
    [Parameter]
    public RenderFragment? Bands { get; set; }

    private bool IsPicked(KeyBand band) =>
        band.Section is { Length: > 0 } label
        && string.Equals(label, SelectedSection, StringComparison.OrdinalIgnoreCase);

    private Task PickAsync(KeyBand band) =>
        band.Section is { Length: > 0 } label
            ? SelectedSectionChanged.InvokeAsync(IsPicked(band) ? null : label)
            : Task.CompletedTask;

    private KeyStripPlan Plan => KeyStrip.Plan(Run, Seconds);

    private IReadOnlyList<ChordBand> ChordBands => ChordStrip.Plan(Run, Seconds);

    private string Gist =>
        Run.Center is { } center
            ? Run.Sections.Select(section => section.Center).Distinct().Count() switch
            {
                <= 1 => $"{ModeText.Named(center)}, one center",
                var centers when Plan.Bands.Any(band => band.FromWindow) =>
                    $"{ModeText.Named(center)}, {centers} centers, placed from your windows",
                var centers => $"{ModeText.Named(center)}, {centers} centers",
            }
            : "no key";

    internal static string Title(KeyBand band) =>
        $"{(band.Section is { Length: > 0 } named ? named + " · " : null)}{ModeText.Named(band.Center)} · ▶ from {WarpWording.Time(band.Start)}{(band.FromWindow ? " · from a window" : null)}";

    internal static string ChordTitle(ChordBand band) => $"{band.Label} · ▶ from {WarpWording.Time(band.Start)}";

    private double X(double seconds) => (seconds - From) / (To - From) * 100;

    private static string P(double value) => value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
