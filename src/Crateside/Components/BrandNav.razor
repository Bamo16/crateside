@*
    The tabs, written down once.

    Two pages carry their own header now instead of sitting under a shared one, and a nav copied
    into both would drift apart the first time a third page appeared — which is exactly what
    adding Settings was.
*@

<div class="cell brand-cell">
    <span class="brand">crateside</span>
    <nav>
        <a class="tab @(Active is Tab.Tracks ? "active" : null)" href="tracks">Tracks</a>
        <a class="tab @(Active is Tab.Partners ? "active" : null)" href="partners">Partners</a>
        <a class="tab @(Active is Tab.Settings ? "active" : null)" href="settings">Settings</a>
    </nav>
</div>

@code {
    public enum Tab
    {
        Tracks,
        Partners,
        Settings,
    }

    [Parameter]
    public Tab Active { get; set; }
}
