<div class="cell brand-cell">
    <a class="brand" href="">
        <img src="@Assets["brand/mark.svg"]" width="18" height="18" alt="" />
        crateside
    </a>
    <nav>
        <a class="tab @(Active is Tab.Dashboard ? "active" : null)" href="">Dashboard</a>
        <a class="tab @(Active is Tab.Tracks ? "active" : null)" href="tracks">Tracks</a>
        <a class="tab @(Active is Tab.Tools ? "active" : null)" href="tools">Tools</a>
        <a class="tab @(Active is Tab.Settings ? "active" : null)" href="settings">Settings</a>
    </nav>
</div>

@code {
    public enum Tab
    {
        Dashboard,
        Tracks,
        Tools,
        Settings,
    }

    [Parameter]
    public Tab Active { get; set; }
}
