<div class="cell brand-cell">
    <a class="brand" href="">
        <img src="@Assets["brand/mark.svg"]" width="18" height="18" alt="" />
        crateside
    </a>
    <nav>
        <a class="tab @(Active is Tab.Tracks ? "active" : null)" href="">Tracks</a>
        <a class="tab @(Active is Tab.Library ? "active" : null)" href="library">Library</a>
        <a class="tab @(Active is Tab.Partners ? "active" : null)" href="partners">Partners</a>
        <a class="tab @(Active is Tab.Settings ? "active" : null)" href="settings">Settings</a>
    </nav>
</div>

@code {
    public enum Tab
    {
        Tracks,
        Library,
        Partners,
        Settings,
    }

    [Parameter]
    public Tab Active { get; set; }
}
