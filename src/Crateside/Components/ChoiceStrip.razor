@if (Inline)
{
    @if (Value is { } settled)
    {
        <span class="inline-value">@settled</span>
    }
    else if (!Quiet)
    {
        <div class="choices">
            @foreach (var choice in Choices)
            {
                <button class="choice @choice.Tone" disabled="@Disabled" @onclick="() => Choose(choice.Value)">
                    @choice.Text
                </button>
            }
        </div>
    }
}
else if (Quiet)
{
    <div class="tag-line">
        <span class="tag-label">@Label</span>
        <span class="tag-value quiet">@Note</span>
    </div>
}
else if (Value is { } value && !_changing)
{
    <div class="tag-line">
        <span class="tag-label">@Label</span>
        <span class="tag-value">@value</span>
        <button class="outline" disabled="@Disabled" @onclick="() => _changing = true">Change</button>
    </div>
    @if (Note is { Length: > 0 } note)
    {
        <span class="tag-detail">@note</span>
    }
}
else
{
    <div class="choice-strip">
        <span class="tag-label">@Label</span>
        <div class="choices">
            @foreach (var choice in Choices)
            {
                <button class="choice @choice.Tone" disabled="@Disabled" @onclick="() => Choose(choice.Value)">
                    @choice.Text
                </button>
            }
        </div>
        @if (Note is { Length: > 0 } note)
        {
            <span class="choice-note">@note</span>
        }
    </div>
}

@code {
    private bool _changing;

    [Parameter, EditorRequired]
    public required string Label { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<Choice> Choices { get; set; }

    /// <summary>The settled answer, which folds the strip to one line; null while it is still open.</summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>Nothing to choose from yet, so the strip is one line saying so, with no button.</summary>
    [Parameter]
    public bool Quiet { get; set; }

    [Parameter]
    public string? Note { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Chips alone, or the settled value as plain text: the Tags to answer view's cell.</summary>
    [Parameter]
    public bool Inline { get; set; }

    [Parameter]
    public EventCallback<string?> OnChoose { get; set; }

    private async Task Choose(string? value)
    {
        _changing = false;

        await OnChoose.InvokeAsync(value);
    }

    /// <param name="Tone"><c>settled</c> (filled), <c>suggested</c> (dashed amber), or null.</param>
    public sealed record Choice(string? Value, string Text, string? Tone);
}
