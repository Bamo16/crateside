@* Tools' title and sub-tabs, one per tool, around the tool's own body (handoff 09). *@

<PageHeader Active="BrandNav.Tab.Tools" Shape="PageHeader.Shapes.Bar" />

<div class="body">
    <header class="page-header">
        <h1>Tools</h1>
        <p class="subtitle">Small helpers for building a mashup, used on the spot.</p>
    </header>

    <nav class="tools">
        @foreach (var tool in Enum.GetValues<Tool>())
        {
            <a class="@(tool == Active ? "current" : null)" href="@Href(tool, Key)">@Label(tool)</a>
        }
    </nav>

    <div class="tool">
        @ChildContent
    </div>
</div>

@code {
    [Parameter]
    public Tool Active { get; set; }

    /// <summary>The key picked here, carried to the other tools as their default.</summary>
    [Parameter]
    public Crateside.Core.Pairing.MusicKey? Key { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    public enum Tool
    {
        Partners,
        RePitch,
    }

    public static string Href(Tool tool, Crateside.Core.Pairing.MusicKey? key) =>
        $"tools/{tool.ToString().ToLowerInvariant()}{(key is null ? string.Empty : $"?key={Uri.EscapeDataString(key.LedgerName)}")}";

    private static string Label(Tool tool) =>
        tool switch
        {
            Tool.RePitch => "Re-Pitch",
            _ => tool.ToString(),
        };
}
