@using Crateside.Core.Genres
@using Crateside.Core.Orchestration.Jobs
@using Crateside.Core.Tracks
@inject GenreStore Genres
@inject TracksService Tracks
@inject ActionLog Actions

@if (Shape is Shapes.Cell)
{
    @switch (Row.Genre)
    {
        case { IsSettled: true } settled:
            <span class="cell-value">@Settled(settled)</span>
            break;
        case { LookedUpAt: not null, Suggested: { } suggested }:
            <button class="cell-chip" title="@($"Use {suggested}. {Heard(Row.Genre)}")" disabled="@_working"
                    @onclick="() => SettleGenre(suggested)" @onclick:stopPropagation="true">
                @suggested
            </button>
            break;
        case { LookedUpAt: not null }:
            <span class="cell-chip choose" title="No suggestion: open the row to choose">choose</span>
            break;
    }
}
else
{
    <ChoiceStrip Label="Genre" Choices="Choices" Value="@Settled(Row.Genre)" Quiet="IsQuiet(Row.Genre)"
                 Note="@Heard(Row.Genre)" Disabled="_working" OnChoose="SettleGenre" Inline="Shape is Shapes.Chips" />
}

@code {
    private bool _working;

    [Parameter, EditorRequired]
    public required TrackRow Row { get; set; }

    [Parameter]
    public Shapes Shape { get; set; }

    private IReadOnlyList<ChoiceStrip.Choice> Choices =>
        [
            .. GenreVocabulary.All.Select(genre => new ChoiceStrip.Choice(genre, genre, GenreTone(Row.Genre, genre))),
            new(null, "none of these", GenreTone(Row.Genre, null)),
        ];

    private static string? GenreTone(GenreRecord? record, string? genre) =>
        record switch
        {
            { IsSettled: true } when record.Genre == genre => "settled",
            { IsSettled: false, Suggested: { } suggested } when suggested == genre => "suggested",
            _ => null,
        };

    private static string? Settled(GenreRecord? record) =>
        record is { IsSettled: true } ? record.Genre ?? "none of these" : null;

    private static bool IsQuiet(GenreRecord? record) =>
        record is null or { IsSettled: false, LookedUpAt: null };

    public static string Heard(GenreRecord? record) =>
        record switch
        {
            null or { LookedUpAt: null } => "not looked up yet",
            { Heard.Count: 0 } => "the sources know nothing of it",
            { LearnedFrom: { } artist } => $"from your answers for {artist}",
            { IsSettled: true } => string.Empty,
            _ => $"heard: {string.Join(", ", record.Heard.Take(4))}",
        };

    private async Task SettleGenre(string? genre)
    {
        _working = true;

        try
        {
            Genres.Settle(Row.Song, genre);
            Actions.Record(Row.TrackKey, UserActionKind.GenreSettled, genre ?? "none of these");

            await Tracks.RefreshAsync();
        }
        finally
        {
            _working = false;
        }
    }

    /// <summary>The stack's strip, chips alone for the Tags to answer view, or the collapsed row's cell (#65).</summary>
    public enum Shapes
    {
        Strip,
        Chips,
        Cell,
    }
}
