@using Crateside.Core.Queue

<section class="queue-section @Tone">
    <h2>@Title <span class="count">@Items.Count</span></h2>
    <p class="detail">@Detail</p>

    <ul class="queue-items">
        @foreach (var item in Items)
        {
            <li class="@(item.IsUnavailable ? "unavailable" : null)">
                @if (OnPinToggled.HasDelegate)
                {
                    <input type="checkbox" title="Include in the next batch regardless of age"
                           checked="@(Pinned?.Contains(item.PlaylistItemId) is true)"
                           @onchange="() => OnPinToggled.InvokeAsync(item.PlaylistItemId)" />
                }
                <a href="@item.WatchUrl" target="_blank" rel="noopener">@item.Title</a>
                @if (item.ChannelTitle is { Length: > 0 } channel)
                {
                    <span class="channel">@channel</span>
                }
                @if (PremiumOutlookReader.AdvisoryFor(item.PremiumOutlook) is { } advisory)
                {
                    <span class="flag outlook @item.PremiumOutlook.ToString().ToLowerInvariant()"
                          title="@advisory">
                        @(item.PremiumOutlook is PremiumOutlook.VideoUpload ? "video upload" : "unknown")
                    </span>
                }
                @if (item.IsUnavailable)
                {
                    <span class="flag gone"
                          title="Deleted or made private upstream — it can never become processed.">
                        unavailable
                    </span>
                }
                @if (HoldReason?.Invoke(item.VideoId) is { Length: > 0 } reason)
                {
                    <span class="hold-reason">@reason</span>
                }
                @if (OnHoldToggled.HasDelegate)
                {
                    @* Held is a bucket, not a flag the drainer checks, so this button is the
                       only thing standing between a wrong-version upload and the GPU. *@
                    <button class="hold" title="@(IsHeld ? "Put this back in the work list" : "Leave this alone — crateside will not work it")"
                            @onclick="() => OnHoldToggled.InvokeAsync(item)">
                        @(IsHeld ? "release" : "hold")
                    </button>
                }
                @if (OnRemove.HasDelegate)
                {
                    <button class="remove" title="Remove this item from the playlist"
                            @onclick="() => OnRemove.InvokeAsync(item)">✕</button>
                }
            </li>
        }
    </ul>
</section>

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<QueueItem> Items { get; set; }

    [Parameter]
    public string? Detail { get; set; }

    [Parameter]
    public string? Tone { get; set; }

    /// <summary>Supplied only for the section where pinning makes sense — the work list.</summary>
    [Parameter]
    public ISet<string>? Pinned { get; set; }

    [Parameter]
    public EventCallback<string> OnPinToggled { get; set; }

    /// <summary>Supplied only where removing by hand is meaningful — done and stalled.</summary>
    [Parameter]
    public EventCallback<QueueItem> OnRemove { get; set; }

    /// <summary>Holds and releases. Supplied on the work list and on the held section.</summary>
    [Parameter]
    public EventCallback<QueueItem> OnHoldToggled { get; set; }

    /// <summary>True when this section <em>is</em> the held one, so the button reads "release".</summary>
    [Parameter]
    public bool IsHeld { get; set; }

    /// <summary>Looks up why a track is held, for the held section.</summary>
    [Parameter]
    public Func<string, string?>? HoldReason { get; set; }
}
