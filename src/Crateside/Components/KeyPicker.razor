@using Crateside.Core
@using Crateside.Core.Ledger
@using Crateside.Core.Orchestration
@using Crateside.Core.Orchestration.Jobs
@using Crateside.Core.Orchestration.Loop
@using Crateside.Core.Orchestration.Verdict
@using Crateside.Core.Pairing
@using Crateside.Core.Tracks
@implements IDisposable
@inject PersonsKey Person
@inject TracksService Tracks
@inject StageSignals Signals
@inject ActionLog Actions

@if (Row.HasUpload && (Needs || Row.Verdict is not null))
{
    <section class="picker @(Needs ? "needed" : "optional")" id="decide">
        @if (Needs)
        {
            <h2>Decide its key</h2>
            <p class="lead">@Lead</p>
            @ChoiceList()
        }
        else
        {
            <details>
                <summary>Set the key yourself</summary>
                <p class="lead">Your choice replaces @(Row.Key is { } key ? KeyText.Spell(key) : "the verdict") for this song and is tagged as it stands.</p>
                @ChoiceList()
            </details>
        }

        @if (_problem is { } problem)
        {
            <p class="problem">@problem</p>
        }
    </section>
}

@code {
    private readonly CancellationTokenSource _circuit = new();

    private bool _working;
    private string? _problem;
    private string _other = string.Empty;

    [Parameter, EditorRequired]
    public required TrackRow Row { get; set; }

    [Parameter]
    public RunEvidence? Run { get; set; }

    /// <summary>No key crateside can tag with, and the person is the one left to give it.</summary>
    private bool Needs =>
        Row.WaitingForPerson || Row.Verdict is { Confidence: KeyConfidence.Withheld or KeyConfidence.Low };

    private string Lead =>
        Row.WaitingForPerson
            ? "crateside's rules could not settle this one and no judge is set up. Pick the key you hear; it is recorded as your call and the stems are tagged with it."
            : "The verdict gave no key to tag with. Pick the key you hear; it is recorded as your call and the stems are tagged with it.";

    private IReadOnlyList<KeyChoice> Choices => Person.ChoicesFor(BarJudging.OrderFor(Row), Run);

    public void Dispose()
    {
        _circuit.Cancel();
        _circuit.Dispose();
    }

    private async Task Choose(MusicKey key)
    {
        _working = true;
        _problem = null;

        try
        {
            var outcome = Person.Choose(BarJudging.OrderFor(Row), key);

            if (outcome is RecordOutcome.Refused(var field, var why))
            {
                _problem = $"The ledger refused it: {field}: {why}";

                return;
            }

            Actions.Record(Row.VideoId, UserActionKind.KeyChosen, key.LedgerName);
            Signals.Wake(JobStage.Handoff, JobStage.Tagging);
            await Tracks.RefreshAsync(_circuit.Token);
        }
        catch (OperationCanceledException) { }
        finally
        {
            _working = false;
        }
    }

    private Task ChooseOther() =>
        MusicKey.FromString(_other) is { } key ? Choose(key) : Task.CompletedTask;

    private RenderFragment ChoiceList() =>
        @<div class="choices">
            @foreach (var choice in Choices)
            {
                <button class="choice" disabled="@_working" @onclick="() => Choose(choice.Key)">
                    <span class="mono key">@KeyText.Spell(choice.Key.LedgerName)</span>
                    <span class="by">@string.Join(", ", choice.NamedBy)</span>
                </button>
            }
            <div class="any">
                <label for="any-key">Any key</label>
                <select id="any-key" @bind="_other">
                    <option value="">—</option>
                    @foreach (var key in MusicKey.AllKeys.OrderBy(key => key.Chromatic).ThenBy(key => key.Mode))
                    {
                        <option value="@key.LedgerName">@KeyText.Spell(key.LedgerName)</option>
                    }
                </select>
                <button class="outline" disabled="@(_working || _other.Length is 0)" @onclick="ChooseOther">Use this key</button>
            </div>
        </div>;
}
