@using Crateside.Core.Warps

<span class="zoom">
    <button class="outline small" data-goto hidden></button>
    <span class="mono readout" data-readout></span>
    <span class="gridpick" role="group" aria-label="Beat grid" title="The beat grid behind the waveforms">
        <span class="faint">Grid</span>
        @foreach (var choice in Enum.GetValues<GridDensity>())
        {
            <button class="outline small" data-grid="@choice.ToString().ToLowerInvariant()" aria-pressed="@(choice == Grid ? "true" : "false")">@choice</button>
        }
    </span>
    <button class="outline mono nav" data-zoom-out title="Zoom out (Ctrl + wheel)" aria-label="Zoom out">−</button>
    <button class="outline mono nav" data-zoom-in title="Zoom in (Ctrl + wheel)" aria-label="Zoom in">+</button>
    <button class="outline mono nav" data-earlier title="Earlier" aria-label="Earlier">‹</button>
    <button class="outline mono nav" data-later title="Later" aria-label="Later">›</button>
</span>

@code {
    [Parameter, EditorRequired]
    public GridDensity Grid { get; set; }
}
