    /// <summary>The middle of a window in the view, as a percentage of the plot, for the drawer's caret.</summary>
    private double WindowCenter(WarpGroup group, RunWindow window)
    {
        var (from, to) = View(group);

        return (Math.Clamp(X(window.Start, from, to), 0, 100) + Math.Clamp(X(window.End, from, to), 0, 100)) / 2;
    }

