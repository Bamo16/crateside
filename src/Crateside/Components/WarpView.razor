@using System.Globalization
@using System.Text
@using AbleKit.Analysis
@using Crateside.Core
@using Crateside.Core.Ableton
@using Crateside.Core.Ledger
@using Crateside.Core.Orchestration.Verdict
@using Crateside.Core.Quota
@using Crateside.Core.Tempo
@using Crateside.Core.Tracks
@using Crateside.Core.Warps
@using Microsoft.Extensions.Options
@implements IAsyncDisposable
@inject StemWarpReader Reader
@inject WarpActions Actions
@inject WarpTrueUp TrueUp
@inject LiveAnalyses Waiting
@inject CratesidePaths Paths
@inject TracksService Tracks
@inject BarJudging Judging
@inject QuotaGuard Guard
@inject IOptions<JudgeOptions> Judge
@inject IJSRuntime Js

@if (_group is { } group && (group.Stems.Count > 0 || (Row.HasUpload && Judge.Value.IsConfigured)))
{
    var wording = Wording(group);
    var (from, to) = View(group);
    var selected = Selected(group);

    <section class="warp" id="warp-view" @ref="_section" @onkeydown="OnKey">
        <div class="head">
            <span class="section-label">@(group.Stems.Count > 0 ? "Warp" : "Judge")</span>
            @if (group.Stems.Count > 0)
            {
                <span class="group-line @(group.OnTheirOwn.Any() ? "loud" : null)">@GroupLine(group, wording)</span>
            }
            @if (Row.HasUpload && Judge.Value.IsConfigured && _form is null && BarRun is not { IsRunning: true })
            {
                <button class="outline small" @onclick="() => Open(group)">Judge again</button>
            }
            @if (group.Lender is not null)
            {
                <span class="zoom">
                    @if (_zoom is not Zoom.Whole)
                    {
                        <span class="mono where-in">@ViewLabel(group, from, to)</span>
                        <button class="outline mono nav" title="Earlier" @onclick="() => Move(group, -1)">‹</button>
                        <button class="outline mono nav" title="Later" @onclick="() => Move(group, 1)">›</button>
                    }
                    @foreach (var zoom in Enum.GetValues<Zoom>())
                    {
                        <button class="pill @(zoom == _zoom ? "on plain" : "off")" @onclick="() => SetZoom(group, zoom)">@ZoomLabel(zoom)</button>
                    }
                </span>
            }
        </div>

        @if (_form is { } form)
        {
            var unreadable = form.Unreadable(group);
            var audio = Judging.AudioFor(Row);

            <div class="judge-form">
                <div class="form-head">
                    <span class="form-label">@form.Title(group)</span>
                    <span class="unit-note">
                        @(form.InBars
                            ? "Bars as Live's ruler numbers them: bar 1 is the warp's 1.1.1, and bars before it are -1, -2…"
                            : "No warp yet, so ranges are in minutes and seconds. Warp it in Live and the form takes bars.")
                    </span>
                </div>
                <div class="range-row heads">
                    <span></span>
                    <span>@(form.InBars ? "Bars" : "From – to")</span>
                    <span>Label</span>
                    <span>Note to the judge</span>
                    <span></span>
                </div>
                @foreach (var (line, index) in form.Lines.Select((line, index) => (line, index)))
                {
                    <div class="range-row @(unreadable.Contains(index + 1) ? "unreadable" : null)">
                        <span class="mono number">@(index + 1)</span>
                        <input class="mono range-field" @bind="line.Range" @bind:event="oninput"
                               placeholder="@(form.InBars ? "33–48, 106-end" : "0:45–1:07")" aria-label="Range @(index + 1)" />
                        <input @bind="line.Label" @bind:event="oninput" placeholder="e.g. Opening, Final chorus" aria-label="Label" />
                        <input @bind="line.Note" @bind:event="oninput" placeholder="Note to the judge (optional)"
                               aria-label="Note to the judge" @onkeydown="key => AddOnEnter(key, form, index)" />
                        <button class="remove" title="Remove this range" @onclick="() => form.Remove(line)">×</button>
                        @if (form.Stretch(line, group) is { } stretch)
                        {
                            <span class="stretch faint">@stretch</span>
                        }
                    </div>
                }
                <div class="range-row add">
                    <span></span>
                    <button class="add-line" @onclick="form.Add">+ another range <span class="faint">@(group.Stems.Count > 0 ? "· or drag on the ruler below" : null)</span></button>
                </div>
                <div class="hear">
                    <span></span>
                    <span class="hear-label">What you hear</span>
                    <span class="hear-fields">
                        <input class="mono ear @(form.EarIsUnreadable ? "unreadable" : null)" @bind="form.Ear" @bind:event="oninput"
                               placeholder="C♯ min" aria-label="What you hear" />
                        <select @bind="form.EarMode" aria-label="Mode">
                            <option value="">mode, if you know it</option>
                            @foreach (var mode in Enum.GetValues<DiatonicMode>())
                            {
                                <option value="@mode">@mode</option>
                            }
                        </select>
                        <span class="hint">optional · @EarHint (<a href="settings">Settings</a>)</span>
                    </span>
                </div>
                <div class="cost">
                    <span class="cost-line">
                        @if (unreadable is [var first, ..])
                        {
                            <span class="problem">
                                Range @first doesn't read as @(form.InBars ? "bars, such as 33–48" : "minutes and seconds, such as 0:45–1:07").
                            </span>
                        }
                        else
                        {
                            @CostLine(form.Windows(group).Count, audio is null)
                        }
                    </span>
                    <span class="actions">
                        <button class="primary" disabled="@(unreadable.Count > 0 || form.EarIsUnreadable)"
                                @onclick="() => StartRun(form, group, audio)">@form.Title(group)</button>
                        <button class="outline" @onclick="() => _form = null">Cancel</button>
                    </span>
                </div>
            </div>
        }
        else if (BarRun is { IsRunning: true } running)
        {
            <div class="judge-running">
                <span class="steps">
                    <span class="chip @(JudgeText.Phase(running) is 0 ? "running" : "done")">@(JudgeText.Phase(running) is 0 ? "●" : "✓") Detecting windows</span>
                    <span class="chip @(JudgeText.Phase(running) is 1 ? "running" : null)">@(JudgeText.Phase(running) is 1 ? "●" : "○") Judging</span>
                    <span class="chip">○ Recorded</span>
                </span>
                <span class="run-line">@JudgeText.Step(running, window => Span(group, window))</span>
                <span class="leave">@JudgeText.Leave</span>
            </div>
        }
        else if (BarRun is { Outcome: not null } finished && DoneLine(finished) is { } done)
        {
            <div class="judge-done">
                <span class="done-line">@done</span>
                @if (finished.Outcome.IsSuccess)
                {
                    <a href="@EvidenceLink">Why this key ↓</a>
                }
            </div>
            @if (finished is { JudgeAsked: [_, ..] asked, JudgeAskedAt: { } askedAt })
            {
                <div class="judge-done">
                    <span class="done-line faint">
                        The judge asked for @string.Join(", ", asked.Select(window => Span(group, window))) (@askedAt.ToLocalTime().ToString("d MMM, h:mm tt"))
                        and crateside ran them unattended. Yours are solid; the judge's are dashed.
                    </span>
                </div>
            }
        }

        @if (group.Stems.Count > 0)
        {
            <div class="grid">
                @if (_zoom is not Zoom.Whole && group.Stems.FirstOrDefault(stem => stem.Sidecar is not null) is { } whole)
                {
                    <span class="gutter faint">Whole track · click to move</span>
                    <div class="strip">
                        <svg viewBox="0 0 @Columns 20" preserveAspectRatio="none">
                            <path d="@Wave(whole, 0, group.Seconds, 20, mono: true)" />
                        </svg>
                        <div class="view-box" style="left: @P(from / group.Seconds * 100)%; width: @P((to - from) / group.Seconds * 100)%"></div>
                        <div class="strip-hits">
                            @for (var i = 0; i < StripColumns; i++)
                            {
                                var at = (i + 0.5) / StripColumns * group.Seconds;
                                <span @onpointerdown="() => CenterOn(group, at)" @onpointerenter="pointer => Drag(group, at, pointer)"></span>
                            }
                        </div>
                    </div>
                }

                @{ var bands = Bands(group); var clipWord = ClipWord(group, from, to); }
                <span class="gutter faint ruler-gutter">
                    <span>@(group.Lender is null ? "Time" : "Bar")</span>
                    @if (_form is not null)
                    {
                        <span class="drag-hint">drag here to add a range</span>
                    }
                </span>
                <div class="ruler @(bands.Count > 0 || _form is not null ? "tall" : null) @(_form is not null ? "dragging" : null)"
                     data-snaps="@(_form is null ? null : string.Join(',', SnapBounds(group, from, to).Select(F)))">
                    @if (group.Lender is null)
                    {
                        @foreach (var at in TimeTicks(from, to))
                        {
                            <span class="tick numbered" style="left: @P(X(at, from, to))%"></span>
                            <span class="mono bar-number" style="left: @P(X(at, from, to))%">@TempoFormat.Clock(at)</span>
                        }
                    }
                    @BandsIn(bands, from, to, tags: true)
                    @if (group.Lender?.Loop is { } loop)
                    {
                        var (loopLeft, loopRight) = (Math.Clamp(X(loop.Start, from, to), 0, 100), Math.Clamp(X(loop.End, from, to), 0, 100));
                        @if (loopRight > loopLeft)
                        {
                            <div class="loop @(loop.On ? "on" : null) @(X(loop.Start, from, to) < 0 ? "open-left" : null) @(X(loop.End, from, to) > 100 ? "open-right" : null)"
                                 style="left: @P(loopLeft)%; width: @P(loopRight - loopLeft)%"
                                 title="@LoopTitle(loop)"></div>
                        }
                        @if (X(loop.End, from, to) is >= 0 and <= 92)
                        {
                            <span class="mono loop-word" style="left: calc(@P(X(loop.End, from, to))% + 4px)">@(loop.On ? "loop" : "loop off")</span>
                        }
                    }
                    @foreach (var (at, bar, numbered, beat) in BarTicks(group, from, to))
                    {
                        <span class="tick @(numbered ? "numbered" : null) @(beat ? "beat" : null)" style="left: @P(X(at, from, to))%"></span>
                        @if (numbered && !UnderClipWord(clipWord, X(at, from, to)))
                        {
                            <span class="mono bar-number" style="left: @P(X(at, from, to))%">@bar</span>
                        }
                    }
                    @if (clipWord is var (clipX, toLeft))
                    {
                        <span class="notch" style="left: @P(clipX)%"
                              title="Clip start · @WarpWording.Time(group.Lender!.Clip.Start) · bar @StartBar(group)"></span>
                        <span class="mono clip-word @(toLeft ? "left" : null)" style="left: @P(clipX)%">clip start</span>
                    }
                    @if (_form is { } dragged)
                    {
                        @foreach (var (line, index) in dragged.Lines.Select((line, index) => (line, index)))
                        {
                            @if (dragged.Window(line, group) is { } window)
                            {
                                var (left, right) = (X(window.Start, from, to), X(window.End, from, to));
                                @if (left is >= 0 and <= 100)
                                {
                                    <span class="edge" style="left: @P(left)%" data-line="@index" data-side="start" data-fixed="@F(right / 100)"></span>
                                }
                                @if (right is >= 0 and <= 100)
                                {
                                    <span class="edge" style="left: @P(right)%" data-line="@index" data-side="end" data-fixed="@F(left / 100)"></span>
                                }
                            }
                        }
                    }
                </div>

                @if (group.SharedAllMarkers is { Count: > 1 })
                {
                    var (figure, low, high, drifts) = TempoScale(group);
                    <span class="gutter tempo-gutter">
                        <span class="faint">Tempo from the markers</span>
                        @if (Headline is { } headline)
                        {
                            <span><span class="mono figure">@headline.Text</span> <span class="note">@headline.Brief</span></span>
                        }
                    </span>
                    <div class="tempo-line" title="@("marker".ToQuantity(group.SharedMarkers.Count)) · @Headline?.Note">
                        <svg viewBox="0 0 @Columns 40" preserveAspectRatio="none">
                            <line class="dashed" x1="0" x2="@Columns" y1="@P(Y(figure, low, high))" y2="@P(Y(figure, low, high))" />
                            <path d="@TempoPath(group, from, to, low, high)" />
                        </svg>
                        @if (drifts)
                        {
                            <span class="mono range high">@((int)high)</span>
                            <span class="mono range low">@((int)low)</span>
                        }
                        @BandsIn(bands, from, to, tags: false)
                    </div>
                }

                @if (OffGrid(group) is { } off)
                {
                    <span class="gutter off-gutter">
                        <span class="off-head">
                            <span class="off-title">Off the grid</span>
                            @if (off.CanTrueUp && _confirming is Confirming.None && _working is null && _trueUp is { Plan: TrueUpPlan.Retype })
                            {
                                <button class="outline small" @onclick="() => _confirming = Confirming.TrueUp">True up</button>
                            }
                        </span>
                        <span class="mono off-figure">@off.Figure</span>
                        @if (off.Runs is { } runs)
                        {
                            <span class="off-runs">@runs</span>
                        }
                    </span>
                    <div class="off-line">
                        <svg viewBox="0 0 @Columns 72" preserveAspectRatio="none">
                            <line class="dashed" x1="0" x2="@Columns" y1="36" y2="36" />
                            @if (off.Points(from, to) is { Count: > 1 } points)
                            {
                                <polyline points="@string.Join(' ', points.Select(point => $"{P(point.X / 100 * Columns)},{P(point.Y / 100 * 72)}"))" />
                            }
                        </svg>
                        @foreach (var point in off.Points(from, to))
                        {
                            <span class="off-dot" style="left: @P(point.X)%; top: @P(point.Y)%"></span>
                        }
                        <span class="mono off-label top">audio early +30 ms</span>
                        <span class="mono off-label bottom">late −30 ms</span>
                        @BandsIn(bands, from, to, tags: false)
                    </div>
                    @if (off.CanTrueUp && Row.Bpm is { } tempo && group.Lender is { } canonical)
                    {
                        <div class="off-status">
                            @if (Working(canonical))
                            {
                                <span class="working"><span class="dot"></span>@(_trueUp is { Plan: TrueUpPlan.Retype working } ? WarpWording.TrueUpWorking(working) : "Retyping the warp…")</span>
                            }
                            else if (_confirming is Confirming.TrueUp && _trueUp is { Plan: TrueUpPlan.Retype plan, Siblings: var siblings })
                            {
                                <div class="confirm">
                                    <span class="control-label asking">True up the warp</span>
                                    <span class="status">@wording.TrueUpQuestion(plan)</span>
                                    <span class="actions">
                                        <button class="danger" @onclick="() => TrueUpAsync(canonical, plan, siblings)">True up my warp</button>
                                        <button class="outline" @onclick="() => _confirming = Confirming.None">Cancel</button>
                                    </span>
                                </div>
                            }
                            else if (Done(canonical, Confirming.TrueUp) is { } done)
                            {
                                <span class="status @(done.Good ? "done" : "failed")">@done.Text(Clock.Ago(done.At))</span>
                            }
                            else
                            {
                                <span class="status @(_working is null && _trueUp is { Plan: TrueUpPlan.Retype } ? null : "faint")">
                                    @(_working is not null
                                        ? "Not while a change is under way."
                                        : _trueUp switch
                                        {
                                            null => "Checking the warp against the audio…",
                                            { Plan: TrueUpPlan.Retype ready } => wording.TrueUpStatus(tempo, ready),
                                            { Plan: var refused } => WarpWording.TrueUpRefusal(refused),
                                        })
                                </span>
                            }
                        </div>
                    }
                }

                @foreach (var stem in group.Stems)
                {
                    var chip = Working(stem) ? new WarpChip("Writing", ChipStyle.Teal) : wording.Chip(stem);
                    var isSelected = stem == selected;
                    var parts = group.PartsFrom(stem);

                    <div class="lane @(isSelected ? "selected" : null)" @onclick="() => Select(stem)">
                        <span class="gutter lane-gutter">
                            <span class="name">@NameOf(stem.Path)</span>
                            <span class="wchip @Style(chip.Style)">@chip.Label</span>
                            <span class="sub">@(Working(stem) ? $"writing {wording.Name(group.Lender!.Path)}'s warp" : wording.Sub(stem))</span>
                        </span>
                        <div class="plot">
                            @if (stem.Sidecar is null)
                            {
                                <div class="empty @(stem.Owner is WarpOwner.WaitingForLive ? "waiting" : null)">
                                    @(stem.Owner is WarpOwner.WaitingForLive ? "No warp · waiting for Live to open it" : "No overview · Live has not opened this file")
                                </div>
                            }
                            else
                            {
                                <svg class="overview" viewBox="0 0 @Columns 45" preserveAspectRatio="none">
                                    <path d="@Wave(stem, from, to, 45, mono: false)" />
                                </svg>

                                var markers = stem.Markers;
                                var flags = FlagsFit(markers, from, to);
                                @for (var i = 0; i < markers.Count; i++)
                                {
                                    var marker = markers[i];
                                    var x = X(marker.Seconds, from, to);
                                    if (x is < 0 or > 100)
                                        continue;
                                    <span class="marker-line @(flags ? null : "dense")" style="left: @P(x)%"></span>
                                    <span class="@(flags ? "flag" : "flag-tick")" style="left: @P(x)%" title="@MarkerTitle(stem, i)"></span>
                                }

                                @if (_zoom is not Zoom.Whole)
                                {
                                    @foreach (var at in stem.TransientTimes)
                                    {
                                        var x = X(at, from, to);
                                        if (x is < 0 or > 100)
                                            continue;
                                        <span class="transient" style="left: @P(x)%"></span>
                                    }
                                }

                                @if (X(stem.Clip.Start, from, to) is >= 0 and <= 100 and var stemClipX)
                                {
                                    <div class="clip-line" style="left: @P(stemClipX)%"></div>
                                }
                            }
                            @if (parts is { } parting && wording.Name(group.Lender!.Path) is var sibling)
                            {
                                <div class="differs" style="left: @P(Math.Max(0, X(parting, from, to)))%"
                                     title="Differs from @sibling from @TempoFormat.Clock(parting)"></div>
                            }
                            @BandsIn(bands, from, to, tags: false)
                        </div>
                    </div>
                }

                @if (Run is not null)
                {
                    <KeyLane Run="Run" Seconds="group.Seconds" From="from" To="to" Bands="BandsIn(bands, from, to, tags: false)" />
                }

                <span class="gutter"></span>
                <div class="axis">
                    @foreach (var at in TimeTicks(from, to))
                    {
                        <span class="mono" style="left: @P(X(at, from, to))%">@TempoFormat.Clock(at)</span>
                    }
                </div>
            </div>

            @if (OpenReading is { } open)
            {
                <WindowDrawer Run="Run!" Reading="open.Reading" Index="open.Index" Span="@DrawerSpan(group, open.Reading.Window)"
                              At="WindowCenter(group, open.Reading.Window)" OnClose="() => _openWindow = null" OnStep="StepWindow" />
            }

            @if (selected is not null)
            {
                var chip = Working(selected) ? new WarpChip("Writing", ChipStyle.Teal) : wording.Chip(selected);
                var sample = Row.Samples.FirstOrDefault(sample => sample.Path == selected.Path);

                <div class="detail">
                    <div class="detail-head">
                        <span class="file">@Path.GetFileName(selected.Path)</span>
                        <span class="wchip @Style(chip.Style)">@chip.Label</span>
                    </div>

                    <div class="facts">
                        @foreach (var (label, value, note, tone) in Facts(selected, sample, wording, group))
                        {
                            <div class="fact">
                                <span class="fact-label">@label</span>
                                <span class="mono fact-value @tone">@value</span>
                                <span class="fact-note">@note</span>
                            </div>
                        }
                    </div>

                    <p class="provenance">@wording.Sentence(selected)</p>
                    @if (selected.Starter is { } starter)
                    {
                        <p class="starter-why mono">@WarpWording.StarterWhy(starter)</p>
                    }

                    <div class="controls">
                        <div class="control">
                            <div class="label-line">
                                <span class="control-label @(_confirming is Confirming.Reapply ? "asking" : null)">Re-apply crateside's warp</span>
                                @if (wording.CanReapply(selected) && _confirming is Confirming.None && _working is null)
                                {
                                    <button class="outline" @onclick="() => _confirming = Confirming.Reapply">Re-apply</button>
                                }
                            </div>
                            @if (Working(selected))
                            {
                                <span class="working"><span class="dot"></span>Writing @wording.Name(group.Lender!.Path)'s warp…</span>
                                <span class="status">Your warp is backed up.</span>
                            }
                            else if (_confirming is Confirming.Reapply)
                            {
                                <span class="status">@wording.ReapplyQuestion(selected)</span>
                                <span class="actions">
                                    <button class="danger" @onclick="() => ReapplyAsync(selected)">@wording.ReapplyConfirm(selected)</button>
                                    <button class="outline" @onclick="() => _confirming = Confirming.None">Cancel</button>
                                </span>
                            }
                            else if (Done(selected, Confirming.Reapply) is { } done)
                            {
                                <span class="status @(done.Good ? "done" : "failed")">@done.Text(Clock.Ago(done.At))</span>
                            }
                            else
                            {
                                <span class="status @(wording.CanReapply(selected) && _working is null ? null : "faint")">
                                    @(_working is not null ? "Not while a change is under way." : wording.ReapplyStatus(selected))
                                </span>
                            }
                        </div>

                        <div class="control">
                            <div class="label-line">
                                <span class="control-label @(_confirming is Confirming.LetLive || selected.Owner is WarpOwner.WaitingForLive ? "asking" : null)">Let Live analyze</span>
                                @if (WarpWording.CanLetLiveAnalyze(selected) && _confirming is Confirming.None && _working is null)
                                {
                                    <button class="outline" @onclick="() => _confirming = Confirming.LetLive">Let Live analyze</button>
                                }
                            </div>
                            @if (_confirming is Confirming.LetLive)
                            {
                                <span class="status">@wording.LetLiveQuestion(selected)</span>
                                <span class="actions">
                                    <button class="danger" @onclick="() => LetLiveAnalyze(selected)">Send to Recycle Bin</button>
                                    <button class="outline" @onclick="() => _confirming = Confirming.None">Cancel</button>
                                </span>
                            }
                            else if (selected.Owner is WarpOwner.PuttingBack)
                            {
                                <span class="working"><span class="dot"></span>@wording.LetLiveStatus(selected, Folder(selected))</span>
                            }
                            else if (Done(selected, Confirming.LetLive) is { } done)
                            {
                                <span class="status @(done.Good ? "done" : "failed")">@done.Text(Clock.Ago(done.At))</span>
                            }
                            else
                            {
                                <span class="status @(selected.Owner is WarpOwner.WaitingForLive ? "now" : WarpWording.CanLetLiveAnalyze(selected) && _working is null ? null : "faint")">
                                    @(_working is not null && selected.Owner is not WarpOwner.WaitingForLive ? "Not while a change is under way." : wording.LetLiveStatus(selected, Folder(selected)))
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </section>
}

@code {
    private const int Columns = 832;
    private const int StripColumns = 100;

    /// <summary>The pixels a plot is at the page's width cap, for deciding whether flags have room.</summary>
    private const double PlotPixels = 832;

    private const double FlagRoom = 9;

    [Parameter, EditorRequired]
    public required TrackRow Row { get; set; }

    /// <summary>The sample whose lane is selected, shared with the sample list.</summary>
    [Parameter]
    public string? SelectedPath { get; set; }

    [Parameter]
    public EventCallback<string> SelectedPathChanged { get; set; }

    /// <summary>The verdict's evidence, whose windows are drawn as bands once recorded.</summary>
    [Parameter]
    public RunEvidence? Run { get; set; }

    /// <summary>Raised by the band's invitation: each new value opens the form.</summary>
    [Parameter]
    public int OpenRequests { get; set; }

    private BarForm? _form;
    private int? _openWindow;
    private ElementReference _section;
    private IJSObjectReference? _drag;
