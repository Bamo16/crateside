@using System.Globalization
@using System.Text
@using AbleKit.Analysis
@using Crateside.Core
@using Crateside.Core.Ableton
@using Crateside.Core.Tempo
@using Crateside.Core.Tracks
@using Crateside.Core.Warps
@implements IDisposable
@inject StemWarpReader Reader
@inject WarpActions Actions
@inject WarpTrueUp TrueUp
@inject LiveAnalyses Waiting
@inject CratesidePaths Paths
@inject TracksService Tracks

@if (_group is { Stems.Count: > 0 } group)
{
    var wording = Wording(group);
    var (from, to) = View(group);
    var selected = Selected(group);

    <section class="warp" id="warp-view">
        <div class="head">
            <span class="section-label">Warp</span>
            <span class="group-line @(group.OnTheirOwn.Any() ? "loud" : null)">@GroupLine(group, wording)</span>
            @if (group.Lender is not null)
            {
                <span class="zoom">
                    @if (_zoom is not Zoom.Whole)
                    {
                        <span class="mono where-in">@ViewLabel(group, from, to)</span>
                        <button class="outline mono nav" title="Earlier" @onclick="() => Move(group, -1)">‹</button>
                        <button class="outline mono nav" title="Later" @onclick="() => Move(group, 1)">›</button>
                    }
                    @foreach (var zoom in Enum.GetValues<Zoom>())
                    {
                        <button class="pill @(zoom == _zoom ? "on plain" : "off")" @onclick="() => SetZoom(group, zoom)">@ZoomLabel(zoom)</button>
                    }
                </span>
            }
        </div>

        <div class="grid">
            @if (_zoom is not Zoom.Whole && group.Stems.FirstOrDefault(stem => stem.Sidecar is not null) is { } whole)
            {
                <span class="gutter faint">Whole track · click to move</span>
                <div class="strip">
                    <svg viewBox="0 0 @Columns 20" preserveAspectRatio="none">
                        <path d="@Wave(whole, 0, group.Seconds, 20, mono: true)" />
                    </svg>
                    <div class="view-box" style="left: @P(from / group.Seconds * 100)%; width: @P((to - from) / group.Seconds * 100)%"></div>
                    <div class="strip-hits">
                        @for (var i = 0; i < StripColumns; i++)
                        {
                            var at = (i + 0.5) / StripColumns * group.Seconds;
                            <span @onpointerdown="() => CentreOn(group, at)" @onpointerenter="pointer => Drag(group, at, pointer)"></span>
                        }
                    </div>
                </div>
            }

            <span class="gutter faint">Bar</span>
            <div class="ruler">
                @if (group.Lender?.Loop is { } loop)
                {
                    var (loopLeft, loopRight) = (Math.Clamp(X(loop.Start, from, to), 0, 100), Math.Clamp(X(loop.End, from, to), 0, 100));
                    @if (loopRight > loopLeft)
                    {
                        <div class="loop @(loop.On ? "on" : null) @(X(loop.Start, from, to) < 0 ? "open-left" : null) @(X(loop.End, from, to) > 100 ? "open-right" : null)"
                             style="left: @P(loopLeft)%; width: @P(loopRight - loopLeft)%"
                             title="@LoopTitle(loop)"></div>
                    }
                    @if (X(loop.End, from, to) is >= 0 and <= 92)
                    {
                        <span class="mono loop-word" style="left: calc(@P(X(loop.End, from, to))% + 4px)">@(loop.On ? "loop" : "loop off")</span>
                    }
                }
                @foreach (var (at, bar, numbered, beat) in BarTicks(group, from, to))
                {
                    <span class="tick @(numbered ? "numbered" : null) @(beat ? "beat" : null)" style="left: @P(X(at, from, to))%"></span>
                    @if (numbered)
                    {
                        <span class="mono bar-number" style="left: @P(X(at, from, to))%">@bar</span>
                    }
                }
                @if (group.Lender is { } lender)
                {
                    var clipStart = lender.Clip.Start;
                    <span class="notch" style="left: @P(X(clipStart, from, to))%"
                          title="Clip start · @WarpWording.Time(clipStart) · bar 1.1"></span>
                }
            </div>

            @if (group.SharedAllMarkers is { Count: > 1 })
            {
                var (figure, low, high, drifts) = TempoScale(group);
                <span class="gutter tempo-gutter">
                    <span class="faint">Tempo from the markers</span>
                    @if (Headline is { } headline)
                    {
                        <span><span class="mono figure">@headline.Text</span> <span class="note">@headline.Brief</span></span>
                    }
                </span>
                <div class="tempo-line" title="@("marker".ToQuantity(group.SharedMarkers.Count)) · @Headline?.Note">
                    <svg viewBox="0 0 @Columns 40" preserveAspectRatio="none">
                        <line class="dashed" x1="0" x2="@Columns" y1="@P(Y(figure, low, high))" y2="@P(Y(figure, low, high))" />
                        <path d="@TempoPath(group, from, to, low, high)" />
                    </svg>
                    @if (drifts)
                    {
                        <span class="mono range high">@((int)high)</span>
                        <span class="mono range low">@((int)low)</span>
                    }
                </div>
            }

            @if (OffGrid(group) is { } off)
            {
                <span class="gutter off-gutter">
                    <span class="off-head">
                        <span class="off-title">Off the grid</span>
                        @if (off.CanTrueUp && _confirming is Confirming.None && _working is null && _trueUp is { Plan: TrueUpPlan.Retype })
                        {
                            <button class="outline small" @onclick="() => _confirming = Confirming.TrueUp">True up</button>
                        }
                    </span>
                    <span class="mono off-figure">@off.Figure</span>
                    @if (off.Runs is { } runs)
                    {
                        <span class="off-runs">@runs</span>
                    }
                </span>
                <div class="off-line">
                    <svg viewBox="0 0 @Columns 72" preserveAspectRatio="none">
                        <line class="dashed" x1="0" x2="@Columns" y1="36" y2="36" />
                        @if (off.Points(from, to) is { Count: > 1 } points)
                        {
                            <polyline points="@string.Join(' ', points.Select(point => $"{P(point.X / 100 * Columns)},{P(point.Y / 100 * 72)}"))" />
                        }
                    </svg>
                    @foreach (var point in off.Points(from, to))
                    {
                        <span class="off-dot" style="left: @P(point.X)%; top: @P(point.Y)%"></span>
                    }
                    <span class="mono off-label top">audio early +30 ms</span>
                    <span class="mono off-label bottom">late −30 ms</span>
                </div>
                @if (off.CanTrueUp && Row.Bpm is { } tempo && group.Lender is { } canonical)
                {
                    <div class="off-status">
                        @if (Working(canonical))
                        {
                            <span class="working"><span class="dot"></span>@(_trueUp is { Plan: TrueUpPlan.Retype working } ? WarpWording.TrueUpWorking(working) : "Retyping the warp…")</span>
                        }
                        else if (_confirming is Confirming.TrueUp && _trueUp is { Plan: TrueUpPlan.Retype plan, Siblings: var siblings })
                        {
                            <div class="confirm">
                                <span class="control-label asking">True up the warp</span>
                                <span class="status">@wording.TrueUpQuestion(plan)</span>
                                <span class="actions">
                                    <button class="danger" @onclick="() => TrueUpAsync(canonical, plan, siblings)">True up my warp</button>
                                    <button class="outline" @onclick="() => _confirming = Confirming.None">Cancel</button>
                                </span>
                            </div>
                        }
                        else if (Done(canonical, Confirming.TrueUp) is { } done)
                        {
                            <span class="status @(done.Good ? "done" : "failed")">@done.Text(Clock.Ago(done.At))</span>
                        }
                        else
                        {
                            <span class="status @(_working is null && _trueUp is { Plan: TrueUpPlan.Retype } ? null : "faint")">
                                @(_working is not null
                                    ? "Not while a change is under way."
                                    : _trueUp switch
                                    {
                                        null => "Checking the warp against the audio…",
                                        { Plan: TrueUpPlan.Retype ready } => wording.TrueUpStatus(tempo, ready),
                                        { Plan: var refused } => WarpWording.TrueUpRefusal(refused),
                                    })
                            </span>
                        }
                    </div>
                }
            }

            @foreach (var stem in group.Stems)
            {
                var chip = Working(stem) ? new WarpChip("Writing", ChipStyle.Teal) : wording.Chip(stem);
                var isSelected = stem == selected;
                var parts = group.PartsFrom(stem);

                <div class="lane @(isSelected ? "selected" : null)" @onclick="() => Select(stem)">
                    <span class="gutter lane-gutter">
                        <span class="name">@NameOf(stem.Path)</span>
                        <span class="wchip @Style(chip.Style)">@chip.Label</span>
                        <span class="sub">@(Working(stem) ? $"writing {wording.Name(group.Lender!.Path)}'s warp" : wording.Sub(stem))</span>
                    </span>
                    <div class="plot">
                        @if (stem.Sidecar is null)
                        {
                            <div class="empty @(stem.Owner is WarpOwner.WaitingForLive ? "waiting" : null)">
                                @(stem.Owner is WarpOwner.WaitingForLive ? "No warp · waiting for Live to open it" : "No overview · Live has not opened this file")
                            </div>
                        }
                        else
                        {
                            <svg class="overview" viewBox="0 0 @Columns 45" preserveAspectRatio="none">
                                <path d="@Wave(stem, from, to, 45, mono: false)" />
                            </svg>

                            var markers = stem.Markers;
                            var flags = FlagsFit(markers, from, to);
                            @for (var i = 0; i < markers.Count; i++)
                            {
                                var marker = markers[i];
                                var x = X(marker.Seconds, from, to);
                                if (x is < 0 or > 100)
                                    continue;
                                <span class="marker-line @(flags ? null : "dense")" style="left: @P(x)%"></span>
                                <span class="@(flags ? "flag" : "flag-tick")" style="left: @P(x)%" title="@MarkerTitle(stem, i)"></span>
                            }

                            @if (_zoom is not Zoom.Whole)
                            {
                                @foreach (var at in stem.TransientTimes)
                                {
                                    var x = X(at, from, to);
                                    if (x is < 0 or > 100)
                                        continue;
                                    <span class="transient" style="left: @P(x)%"></span>
                                }
                            }

                            var (clipStart, clipEnd) = stem.Clip;
                            @if (X(clipStart, from, to) > 0)
                            {
                                <div class="outside" style="left: 0; width: @P(Math.Min(100, X(clipStart, from, to)))%"></div>
                            }
                            @if (X(clipEnd, from, to) < 100)
                            {
                                <div class="outside" style="left: @P(Math.Max(0, X(clipEnd, from, to)))%; right: 0"></div>
                            }
                        }
                        @if (parts is { } parting && wording.Name(group.Lender!.Path) is var sibling)
                        {
                            <div class="differs" style="left: @P(Math.Max(0, X(parting, from, to)))%"
                                 title="Differs from @sibling from @TempoFormat.Clock(parting)"></div>
                        }
                    </div>
                </div>
            }

            <span class="gutter"></span>
            <div class="axis">
                @foreach (var at in TimeTicks(from, to))
                {
                    <span class="mono" style="left: @P(X(at, from, to))%">@TempoFormat.Clock(at)</span>
                }
            </div>
        </div>

        @if (selected is not null)
        {
            var chip = Working(selected) ? new WarpChip("Writing", ChipStyle.Teal) : wording.Chip(selected);
            var sample = Row.Samples.FirstOrDefault(sample => sample.Path == selected.Path);

            <div class="detail">
                <div class="detail-head">
                    <span class="file">@Path.GetFileName(selected.Path)</span>
                    <span class="wchip @Style(chip.Style)">@chip.Label</span>
                </div>

                <div class="facts">
                    @foreach (var (label, value, note, tone) in Facts(selected, sample, wording, group))
                    {
                        <div class="fact">
                            <span class="fact-label">@label</span>
                            <span class="mono fact-value @tone">@value</span>
                            <span class="fact-note">@note</span>
                        </div>
                    }
                </div>

                <p class="provenance">@wording.Sentence(selected)</p>

                <div class="controls">
                    <div class="control">
                        <div class="label-line">
                            <span class="control-label @(_confirming is Confirming.Reapply ? "asking" : null)">Re-apply crateside's warp</span>
                            @if (wording.CanReapply(selected) && _confirming is Confirming.None && _working is null)
                            {
                                <button class="outline" @onclick="() => _confirming = Confirming.Reapply">Re-apply</button>
                            }
                        </div>
                        @if (Working(selected))
                        {
                            <span class="working"><span class="dot"></span>Writing @wording.Name(group.Lender!.Path)'s warp…</span>
                            <span class="status">Your warp is backed up.</span>
                        }
                        else if (_confirming is Confirming.Reapply)
                        {
                            <span class="status">@wording.ReapplyQuestion(selected)</span>
                            <span class="actions">
                                <button class="danger" @onclick="() => ReapplyAsync(selected)">@wording.ReapplyConfirm(selected)</button>
                                <button class="outline" @onclick="() => _confirming = Confirming.None">Cancel</button>
                            </span>
                        }
                        else if (Done(selected, Confirming.Reapply) is { } done)
                        {
                            <span class="status @(done.Good ? "done" : "failed")">@done.Text(Clock.Ago(done.At))</span>
                        }
                        else
                        {
                            <span class="status @(wording.CanReapply(selected) && _working is null ? null : "faint")">
                                @(_working is not null ? "Not while a change is under way." : wording.ReapplyStatus(selected))
                            </span>
                        }
                    </div>

                    <div class="control">
                        <div class="label-line">
                            <span class="control-label @(_confirming is Confirming.LetLive || selected.Owner is WarpOwner.WaitingForLive ? "asking" : null)">Let Live analyse</span>
                            @if (WarpWording.CanLetLiveAnalyse(selected) && _confirming is Confirming.None && _working is null)
                            {
                                <button class="outline" @onclick="() => _confirming = Confirming.LetLive">Let Live analyse</button>
                            }
                        </div>
                        @if (_confirming is Confirming.LetLive)
                        {
                            <span class="status">@wording.LetLiveQuestion(selected)</span>
                            <span class="actions">
                                <button class="danger" @onclick="() => LetLiveAnalyse(selected)">Send to Recycle Bin</button>
                                <button class="outline" @onclick="() => _confirming = Confirming.None">Cancel</button>
                            </span>
                        }
                        else if (selected.Owner is WarpOwner.PuttingBack)
                        {
                            <span class="working"><span class="dot"></span>@wording.LetLiveStatus(selected, Folder(selected))</span>
                        }
                        else if (Done(selected, Confirming.LetLive) is { } done)
                        {
                            <span class="status @(done.Good ? "done" : "failed")">@done.Text(Clock.Ago(done.At))</span>
                        }
                        else
                        {
                            <span class="status @(selected.Owner is WarpOwner.WaitingForLive ? "now" : WarpWording.CanLetLiveAnalyse(selected) && _working is null ? null : "faint")">
                                @(_working is not null && selected.Owner is not WarpOwner.WaitingForLive ? "Not while a change is under way." : wording.LetLiveStatus(selected, Folder(selected)))
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </section>
}

@code {
    private const int Columns = 832;
    private const int StripColumns = 100;

    /// <summary>The pixels a plot is at the page's width cap, for deciding whether flags have room.</summary>
    private const double PlotPixels = 832;

    private const double FlagRoom = 9;

    [Parameter, EditorRequired]
    public required TrackRow Row { get; set; }

    /// <summary>The sample whose lane is selected, shared with the sample list.</summary>
    [Parameter]
    public string? SelectedPath { get; set; }

    [Parameter]
    public EventCallback<string> SelectedPathChanged { get; set; }

    private GridReport? _offGrid;

    /// <summary>The Off the grid row's content for the track's canonical warp, when it is a steady one the check ran on (#96).</summary>
    private OffGridRow? OffGrid(WarpGroup group) =>
        Row.Bpm is { Source: TempoSource.Warp, Warp.Shape: TempoShape.Steady } tempo
        && _offGrid is { } report
        && Wording(group) is var wording
            ? new OffGridRow(tempo, report, wording.CanTrueUp(tempo))
            : null;

    private sealed record OffGridRow(TrackTempo Tempo, GridReport Report, bool CanTrueUp)
    {
        private const double ScaleMs = 30;

        /// <summary>Each 10 s window's median offset as a point in the plot, in percent; early is up.</summary>
        public IReadOnlyList<(double X, double Y)> Points(double from, double to) =>
            [
                .. Report
                    .Windows.Select(window =>
                        (
                            X: ((window.Start + window.End) / 2 - from) / (to - from) * 100,
                            Y: 50 + Math.Clamp(window.OffsetMs, -ScaleMs, ScaleMs) / ScaleMs * 50
                        )
                    )
                    .Where(point => point.X is >= 0 and <= 100),
            ];

        public string Figure =>
            (Tempo.Off, Tempo.Unconfirmed, Report.Windows.Count) switch
            {
                ({ DriftMs: { } _ }, _, _) => $"{TempoFormat.ByTheEnd(Tempo)} by the end",
                (_, { Reason: TrueUpReason.Steps }, _) => "steps in its grid",
                (_, not null, _) or (_, _, 0) => "too few transients",
                _ => "holds",
            };

        public string? Runs =>
            Tempo.Off is { DriftMs: { } ms }
                ? $"runs {TempoFormat.Runs(Tempo)} · grid falls {(ms < 0 ? "behind" : "ahead")}"
                : null;
    }

    private WarpGroup? _group;
    private string? _stamp;
    private Zoom _zoom = Zoom.Whole;
    private double _centreBeat;
    private Confirming _confirming;
    private string? _working;
    private ActionDone? _done;
    private (TrueUpPlan Plan, WarpSiblings Siblings)? _trueUp;
    private string? _trueUpKey;
    private Timer? _poll;

    private enum Zoom
    {
        Whole,
        Bars32,
        Bars8,
    }

    private enum Confirming
    {
        None,
        Reapply,
        LetLive,
        TrueUp,
    }

    private sealed record ActionDone(string Path, Confirming Action, bool Good, DateTimeOffset At, Func<string, string> Text);

    private FormattedTempo? Headline => Row.Bpm is { } tempo ? TempoFormat.Format(tempo) : null;

    protected override void OnInitialized() =>
        _poll = new Timer(_ => _ = InvokeAsync(Poll), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));

    protected override void OnParametersSet()
    {
        Reload(force: false);
        EnsureTrueUp();
    }

    public void Dispose() => _poll?.Dispose();

    private void Poll()
    {
        if (Reload(force: false))
        {
            EnsureTrueUp();
            StateHasChanged();
        }
    }

    /// <summary>Re-reads the sidecars when any changed on disk; whether it did.</summary>
    private bool Reload(bool force)
    {
        var paths = LanePaths();
        var stamp = Stamp(paths);

        if (!force && stamp == _stamp)
            return false;

        _stamp = stamp;
        _group = WarpGroup.Of([.. paths.Select(Reader.Read)]);
        _offGrid = _group.Lender is { } lender ? WarpTrueUp.Check(lender) : null;

        return true;
    }

    /// <summary>The samples cut from the upload most of the track's samples share, in the sample list's order.</summary>
    private List<string> LanePaths()
    {
        var upload = Row
            .Samples.GroupBy(sample => sample.SourceVideoId)
            .OrderByDescending(cut => cut.Count())
            .Select(cut => cut.Key)
            .FirstOrDefault();

        return
        [
            .. Row
                .Samples.Where(sample => sample.SourceVideoId == upload && sample.Path is { Length: > 0 })
                .Select(sample => sample.Path),
        ];
    }

    private string Stamp(IEnumerable<string> paths)
    {
        var stamp = new StringBuilder();

        foreach (var path in paths)
        {
            var sidecar = new FileInfo($"{path}.asd");
            stamp.Append(path)
                .Append(sidecar.Exists ? $":{sidecar.Length}:{sidecar.LastWriteTimeUtc.Ticks}" : ":-")
                .Append(Waiting.Of(path) is null ? null : ":w")
                .Append('|');
        }

        return stamp.ToString();
    }

    private WarpWording Wording(WarpGroup group) => new(group, NameOf);

    private string NameOf(string path) =>
        Row.Samples.FirstOrDefault(sample => string.Equals(sample.Path, path, StringComparison.OrdinalIgnoreCase))?.Label
        ?? Path.GetFileNameWithoutExtension(path);

    private StemWarp? Selected(WarpGroup group) =>
        group.Stems.FirstOrDefault(stem => string.Equals(stem.Path, SelectedPath, StringComparison.OrdinalIgnoreCase))
        ?? group.OnTheirOwn.FirstOrDefault()
        ?? group.Stems.FirstOrDefault(stem => stem.Owner is WarpOwner.Borrowed)
        ?? group.Stems.FirstOrDefault();

    private async Task Select(StemWarp stem)
    {
        if (stem.Path == SelectedPath)
            return;

        _confirming = Confirming.None;
        SelectedPath = stem.Path;
        await SelectedPathChanged.InvokeAsync(stem.Path);
    }

    private bool Working(StemWarp stem) => _working == stem.Path;

    private ActionDone? Done(StemWarp stem, Confirming action) =>
        _done is { } done && done.Path == stem.Path && done.Action == action ? done : null;

    private string Folder(StemWarp stem) =>
        Path.GetDirectoryName(stem.Path) is { } folder
        && folder.Equals(Path.TrimEndingDirectorySeparator(Paths.LibraryFolder), StringComparison.OrdinalIgnoreCase)
            ? "the library"
            : "Staging";

    private async Task ReapplyAsync(StemWarp stem)
    {
        _confirming = Confirming.None;
        _working = stem.Path;
        StateHasChanged();

        var siblings = WarpSiblings.Of(Row.Samples.Select(sample => sample.Path).Where(path => path is { Length: > 0 }));
        var target = WarpSiblings.Read(stem.Path);
        var outcome = target is null
            ? new WarpOutcome.Failed("its tags do not say which upload it was cut from")
            : await Actions.ReapplyAsync(stem.Path, siblings.AuthoritiesFor(target), siblings.SameKindAs(target));

        _working = null;
        _done = new ActionDone(
            stem.Path,
            Confirming.Reapply,
            outcome is WarpOutcome.Written,
            DateTimeOffset.UtcNow,
            ago => outcome switch
            {
                WarpOutcome.Written => $"Re-applied {ago}. Your previous warp is backed up.",
                WarpOutcome.SiblingsDisagree => "Not re-applied: the stems it could take a warp from hold different ones.",
                WarpOutcome.LengthsDiffer(var sibling, _, _) => $"Not re-applied: {NameOf(sibling)} is a different length.",
                WarpOutcome.NoWarpedSibling => "Not re-applied: no stem of this upload has a saved warp.",
                WarpOutcome.Failed(var error) => $"Not re-applied: {error}",
                _ => "Not re-applied.",
            }
        );
        Reload(force: true);
        await Tracks.EnsureFreshAsync(TimeSpan.Zero);
    }

    /// <summary>Checks the track's warp once per change to it, so the control says up front whether a true-up is on offer.</summary>
    private void EnsureTrueUp()
    {
        if (_group is not { Lender: { } lender } group || !Wording(group).CanTrueUp(Row.Bpm))
        {
            (_trueUpKey, _trueUp) = (null, null);

            return;
        }

        var key = $"{_stamp}|{Row.Bpm?.Off?.Bpm}";

        if (key == _trueUpKey)
            return;

        (_trueUpKey, _trueUp) = (key, null);
        _ = PlanTrueUpAsync(lender.Path, key);
    }

    private async Task PlanTrueUpAsync(string path, string key)
    {
        var guides = Directory.Exists(Paths.KeptWarpGuides) ? Directory.EnumerateFiles(Paths.KeptWarpGuides) : [];
        var siblings = WarpSiblings.Of(
            Row.Samples
                .Select(sample => sample.Path)
                .Where(sample => sample is { Length: > 0 })
                .Concat(guides)
                .Where(file => !file.EndsWith(".asd", StringComparison.OrdinalIgnoreCase))
        );
        var plan = WarpSiblings.Read(path) is { } song
            ? await Task.Run(() => TrueUp.Plan(siblings, song, rephase: true))
            : new TrueUpPlan.Failed("its tags do not say which upload it was cut from");

        if (key != _trueUpKey)
            return;

        _trueUp = (plan, siblings);
        await InvokeAsync(StateHasChanged);
    }

    private async Task TrueUpAsync(StemWarp stem, TrueUpPlan.Retype plan, WarpSiblings siblings)
    {
        _confirming = Confirming.None;
        _working = stem.Path;
        StateHasChanged();

        var outcome = await TrueUp.ApplyAsync(plan, siblings);

        _working = null;
        _done = new ActionDone(
            stem.Path,
            Confirming.TrueUp,
            outcome is TrueUpOutcome.Retyped,
            DateTimeOffset.UtcNow,
            ago => WarpWording.TrueUpDone(outcome, ago)
        );
        Reload(force: true);
        await Tracks.EnsureFreshAsync(TimeSpan.Zero);
    }

    private async Task LetLiveAnalyse(StemWarp stem)
    {
        _confirming = Confirming.None;

        var outcome = Actions.LetLiveAnalyse(stem.Path);

        _done = outcome is LetLiveOutcome.Sent
            ? null
            : new ActionDone(
                stem.Path,
                Confirming.LetLive,
                false,
                DateTimeOffset.UtcNow,
                _ => outcome is LetLiveOutcome.Failed(var error) ? $"Not sent: {error}" : "Not sent: it has no warp file."
            );
        Reload(force: true);
        await Tracks.EnsureFreshAsync(TimeSpan.Zero);
    }

    private string GroupLine(WarpGroup group, WarpWording wording)
    {
        var stems = "stem".ToQuantity(group.Stems.Count);

        return (group.OnTheirOwn.Select(stem => NameOf(stem.Path)).ToList(), group.Lender) switch
        {
            ([var one], _) => $"{stems} · {one} warped on its own",
            ({ Count: > 1 } several, _) => $"{stems} · {several.Humanize()} warped on their own",
            (_, { Sidecar.Warp.Mode: var mode } lender) =>
                $"{stems} · one warp · {"marker".ToQuantity(lender.Markers.Count)} · {WarpWording.Mode(mode)}",
            _ => $"{stems} · not warped yet",
        };
    }

    private static string ZoomLabel(Zoom zoom) =>
        zoom switch
        {
            Zoom.Bars32 => "32 bars",
            Zoom.Bars8 => "8 bars",
            _ => "Whole track",
        };

    private static int BarsOf(Zoom zoom) => zoom switch { Zoom.Bars32 => 32, Zoom.Bars8 => 8, _ => 0 };

    private void SetZoom(WarpGroup group, Zoom zoom)
    {
        var fromWhole = _zoom is Zoom.Whole;

        _zoom = zoom;

        if (zoom is not Zoom.Whole)
            _centreBeat = Clamped(
                group,
                fromWhole ? group.ClipStartBeat + BarsOf(zoom) * group.BeatsPerBar / 2.0 : _centreBeat
            );
    }

    private void Move(WarpGroup group, int direction) =>
        _centreBeat = Clamped(group, _centreBeat + direction * BarsOf(_zoom) * group.BeatsPerBar / 2.0);

    /// <summary>Follows the pointer across the strip while its button is held.</summary>
    private void Drag(WarpGroup group, double seconds, PointerEventArgs pointer)
    {
        if ((pointer.Buttons & 1) is not 0)
            CentreOn(group, seconds);
    }

    /// <summary>Centres the view near a point, starting it on a bar line so it reads in whole bars.</summary>
    private void CentreOn(WarpGroup group, double seconds)
    {
        if (group.BeatAt(seconds) is not { } beat)
            return;

        var half = BarsOf(_zoom) * group.BeatsPerBar / 2.0;
        var bar = Math.Round((beat - half - group.ClipStartBeat) / group.BeatsPerBar);
        _centreBeat = Clamped(group, group.ClipStartBeat + bar * group.BeatsPerBar + half);
    }

    /// <summary>Keeps the whole window inside the track, so it never runs off either end.</summary>
    private double Clamped(WarpGroup group, double centreBeat)
    {
        if (group.BeatAt(0) is not { } first || group.BeatAt(group.Seconds) is not { } last)
            return centreBeat;

        var half = BarsOf(_zoom) * group.BeatsPerBar / 2.0;

        return first + half >= last - half ? (first + last) / 2 : Math.Clamp(centreBeat, first + half, last - half);
    }

    private (double From, double To) View(WarpGroup group)
    {
        if (_zoom is Zoom.Whole || group.Lender is null)
            return (0, Math.Max(group.Seconds, 1));

        var span = BarsOf(_zoom) * group.BeatsPerBar;

        return group.SecondsAt(_centreBeat - span / 2.0) is { } start
            && group.SecondsAt(_centreBeat + span / 2.0) is { } end
            && end > start
            ? (start, end)
            : (0, Math.Max(group.Seconds, 1));
    }

    private string ViewLabel(WarpGroup group, double from, double to) =>
        $"bars {Bar(group, from)}–{Bar(group, to) - 1} · {TempoFormat.Clock(from)}–{TempoFormat.Clock(to)}";

    private static int Bar(WarpGroup group, double seconds) =>
        group.BeatAt(seconds) is { } beat
            ? (int)Math.Round((beat - group.ClipStartBeat) / group.BeatsPerBar) + 1
            : 0;

    private IEnumerable<(double At, int Bar, bool Numbered, bool Beat)> BarTicks(WarpGroup group, double from, double to)
    {
        if (group.Lender is null || group.BeatAt(from) is not { } first || group.BeatAt(to) is not { } last)
            yield break;

        var perBar = group.BeatsPerBar;
        var (tickEvery, numberEvery) = _zoom switch
        {
            Zoom.Whole => (4, 16),
            Zoom.Bars32 => (1, 4),
            _ => (1, 1),
        };

        for (var bar = (int)Math.Floor((first - group.ClipStartBeat) / perBar) + 1; ; bar++)
        {
            var beat = group.ClipStartBeat + (bar - 1) * perBar;

            if (beat > last)
                yield break;

            if (group.SecondsAt(beat) is not { } at)
                continue;

            if (bar >= 1 && (bar - 1) % tickEvery is 0)
                yield return (at, bar, (bar - 1) % numberEvery is 0, false);

            if (_zoom is Zoom.Bars8)
            {
                for (var i = 1; i < perBar; i++)
                {
                    if (group.SecondsAt(beat + i) is { } inBar)
                        yield return (inBar, bar, false, true);
                }
            }
        }
    }

    private IEnumerable<double> TimeTicks(double from, double to)
    {
        var every = _zoom switch
        {
            Zoom.Whole => 30,
            Zoom.Bars32 => 10,
            _ => 2,
        };

        for (var at = Math.Ceiling(from / every) * every; at <= to; at += every)
            yield return at;
    }

    private (double Figure, double Low, double High, bool Drifts) TempoScale(WarpGroup group)
    {
        if (Row.Bpm is { Source: TempoSource.Warp, Range: { } range } drifting)
            return (drifting.Value, TempoFormat.Edge(range.Low, up: false), TempoFormat.Edge(range.High, up: true), true);

        var figure = Row.Bpm is { Source: TempoSource.Warp, Value: var value }
            ? value
            : group.Lender?.Sidecar?.Warp.TempoAt(group.Lender.Clip.Start) ?? 120;

        return (figure, figure - 1, figure + 1, false);
    }

    private static double Y(double bpm, double low, double high) =>
        Math.Clamp(40 - (bpm - low) / (high - low) * 40, 1, 39);

    private static string TempoPath(WarpGroup group, double from, double to, double low, double high)
    {
        var markers = group.SharedAllMarkers;
        var path = new StringBuilder();

        for (var i = 0; i < markers.Count - 1; i++)
        {
            var span = markers[i + 1].Seconds - markers[i].Seconds;

            if (span <= 0)
                continue;

            var bpm = (markers[i + 1].Beat - markers[i].Beat) / span * 60;
            var start = i is 0 ? from : markers[i].Seconds;
            var end = i == markers.Count - 2 ? to : markers[i + 1].Seconds;
            var (x1, x2) = (Math.Clamp(X(start, from, to), 0, 100), Math.Clamp(X(end, from, to), 0, 100));

            if (x2 <= x1)
                continue;

            var y = Y(bpm, low, high);
            path.Append(path.Length is 0 ? 'M' : 'L')
                .Append(P(x1 * Columns / 100)).Append(',').Append(P(y))
                .Append('L').Append(P(x2 * Columns / 100)).Append(',').Append(P(y));
        }

        return path.ToString();
    }

    /// <summary>Each channel's envelope as one filled shape per channel, Left above Right.</summary>
    private static string Wave(StemWarp stem, double from, double to, double height, bool mono)
    {
        var channels = stem.Overview(from, to, Columns);

        if (channels is [])
            return string.Empty;

        IReadOnlyList<(float Min, float Max)[]> drawn = mono ? [Merged(channels)] : channels;
        var gap = drawn.Count > 1 ? 2.0 : 0;
        var each = (height - gap * (drawn.Count - 1)) / drawn.Count;
        var path = new StringBuilder();

        for (var channel = 0; channel < drawn.Count; channel++)
        {
            var centre = channel * (each + gap) + each / 2;
            var column = drawn[channel];

            path.Append('M');
            for (var x = 0; x < column.Length; x++)
                path.Append(P(x + 0.5)).Append(',').Append(P(centre - column[x].Max * each / 2)).Append(' ');
            for (var x = column.Length - 1; x >= 0; x--)
                path.Append(P(x + 0.5)).Append(',').Append(P(centre - Math.Min(column[x].Min, column[x].Max - 0.02f) * each / 2)).Append(' ');
            path.Append('Z');
        }

        return path.ToString();
    }

    private static (float Min, float Max)[] Merged(IReadOnlyList<(float Min, float Max)[]> channels) =>
        [
            .. Enumerable
                .Range(0, channels[0].Length)
                .Select(x => (channels.Min(channel => channel[x].Min), channels.Max(channel => channel[x].Max))),
        ];

    /// <summary>Whether every pair of visible markers is far enough apart to draw flags rather than ticks.</summary>
    private static bool FlagsFit(IReadOnlyList<WarpMarker> markers, double from, double to)
    {
        var visible = markers.Select(marker => X(marker.Seconds, from, to)).Where(x => x is >= 0 and <= 100).ToList();

        return visible.Zip(visible.Skip(1)).All(pair => (pair.Second - pair.First) / 100 * PlotPixels >= FlagRoom);
    }

    private static string MarkerTitle(StemWarp stem, int i)
    {
        var markers = stem.Sidecar!.Warp.Markers;
        var marker = markers[i];
        var head = $"Marker {i + 1} of {stem.Markers.Count} · {WarpWording.Time(marker.Seconds)}";

        if (i == stem.Markers.Count - 1)
            return head;

        var span = markers[i + 1].Seconds - marker.Seconds;

        return span > 0
            ? $"{head} · {WarpWording.Tempo((markers[i + 1].Beat - marker.Beat) / span * 60)} to the next"
            : head;
    }

    private static IEnumerable<(string Label, string Value, string Note, string? Tone)> Facts(
        StemWarp stem,
        TrackSample? sample,
        WarpWording wording,
        WarpGroup group
    )
    {
        if (stem.Sidecar is not { } sidecar)
        {
            foreach (var label in new[] { "Tempo", "Mode", "Markers", "Transients", "Clip", "Loop", "Default clip" })
                yield return (label, "—", string.Empty, "faint");

            yield break;
        }

        var tempo = sample?.Tempo is { } warp ? TrackTempo.Of(warp, null, null) : null;
        yield return tempo is not null && TempoFormat.Format(tempo) is var formatted
            ? ("Tempo", formatted.Text, formatted.Brief, formatted.IsApproximate ? "approx" : null)
            : sidecar.Warp.TempoAt(stem.Clip.Start) is { } own
                ? ("Tempo", WarpWording.Tempo(own), stem.Owner is WarpOwner.Starter ? "crateside's reading" : string.Empty, null)
                : ("Tempo", "—", string.Empty, "faint");

        yield return ("Mode", WarpWording.Mode(sidecar.Warp.Mode), string.Empty, null);
        yield return ("Markers", $"{stem.Markers.Count}", wording.MarkersNote(stem), null);
        yield return ("Transients", $"{sidecar.Audio.Transients.Count}", WarpWording.TransientsNote(stem), null);

        var (clipStart, clipEnd) = stem.Clip;
        yield return (
            "Clip",
            $"{WarpWording.Time(clipStart)}–{WarpWording.Time(clipEnd)}",
            stem.IsWarped ? StartsAt(group, clipStart) : string.Empty,
            null
        );

        yield return stem.Loop is { } loop && loop is var (loopStart, loopEnd, on)
            ? ("Loop", $"{WarpWording.Time(loopStart)}–{WarpWording.Time(loopEnd)}", on ? "on" : "off", null)
            : ("Loop", "—", string.Empty, "faint");

        yield return sidecar.IsDefaultClipSaved
            ? ("Default clip", "saved", "Live uses it", null)
            : ("Default clip", "not saved", "Live ignores it", null);
    }

    private static string StartsAt(WarpGroup group, double seconds)
    {
        if (group.BeatAt(seconds) is not { } beat)
            return string.Empty;

        var bar = (beat - group.ClipStartBeat) / group.BeatsPerBar + 1;

        return Math.Abs(bar - Math.Round(bar)) < 0.01
            ? $"starts at bar {Math.Round(bar):0}"
            : $"starts at bar {bar.ToString("0.##", CultureInfo.InvariantCulture)}";
    }

    private static string LoopTitle((double Start, double End, bool On) loop) =>
        $"Loop {WarpWording.Time(loop.Start)}–{WarpWording.Time(loop.End)}{(loop.On ? null : " · off")}";

    private static double X(double seconds, double from, double to) => (seconds - from) / (to - from) * 100;

    private static string P(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private static string Style(ChipStyle style) => style.ToString().ToLowerInvariant();
}
