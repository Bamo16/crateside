    private string CostLine(int windows, bool download) =>
        (download ? "crateside no longer holds this track's full mix, so it downloads it again first, without separating it. " : null)
        + (windows is 0
            ? "With no ranges it judges the whole track again: one judge session of about 37k tokens."
            : $"Runs now, while you watch: the detectors over {"window".ToQuantity(windows)}, then one judge session of about 37k tokens.")
        + (Guard.Hold is { Used: not null }
            ? $" Background judging is paused at {QuotaGuard.WeeklyLimit:N0}% of the week; this one is yours, so it runs anyway."
            : null);

    private void StartRun(BarForm form, WarpGroup group, string? audio)
    {
        if (Judging.TryStart(BarJudging.OrderFor(Row), form.Direction(group, audio)))
            _form = null;
    }

    /// <summary>A window's span in bars where the warp can say, else in time.</summary>
    private static string Span(WarpGroup group, RunWindow window) =>
        JudgeRanges.BarsOf(group, window.Start, window.End) is { } bars
            ? $"bars {bars.First}–{bars.Last}"
            : JudgeText.Span(window);

    /// <summary>What the finished run came to, or null once there is nothing new to say.</summary>
    private string? DoneLine(BarRun run)
    {
        if (run.Outcome is { IsSuccess: false, Error: var error })
            return $"Not recorded: {error}. The form is open again with your ranges.";

        if (Row.Verdict is not { } verdict || verdict.Timestamp < run.StartedAt)
            return "Recorded. Reading it back…";

        var ago = Clock.Ago(verdict.Timestamp);

        if (verdict is { Confidence: KeyConfidence.Withheld })
            return $"Withheld again {ago}. The form is open again with your ranges, so a second try is one edit away.";

        var key = verdict.Center is { } center ? ModeText.Named(center) : KeyText.Spell(verdict.Key);
        // A window in another center is a section of the song, not a dissent, so it is named rather than counted.
        var yours = Run?.Readings.Where(reading => reading.Window.AskedBy is WindowAsker.User).ToList() ?? [];
        var elsewhere = yours
            .Where(reading => reading.Section is { } section && section.Center != verdict.Center)
            .Select(reading => $"{reading.Section!.Label}: {ModeText.Named(reading.Section.Center)}")
            .ToList();
        var agreement = (yours.Count, elsewhere) switch
        {
            (0, _) => null,
            (2, []) when yours.All(reading => reading.Section is not null) => " Both windows agreed.",
            (_, []) when yours.All(reading => reading.Section is not null) => " Every window agreed.",
            (_, []) => null,
            _ => $" {string.Join("; ", elsewhere)}.",
        };
        var kept = (run.Direction.Note is not null, run.Direction.Ear is not null) switch
        {
            (true, true) => " Your note and your ear are kept with the run.",
            (true, false) => " Your note is kept with the run.",
            (false, true) => " Your ear is kept with the run.",
            _ => null,
        };

        return $"Recorded {ago}: {key}, {KeyText.Confidence(verdict.Confidence)}.{agreement}{kept}";
    }

    /// <summary>A run that ended without a verdict reopens the form with its ranges, once.</summary>
    private void ReopenIfWithheld()
    {
        if (
            BarRun is not { FinishedAt: { } finishedAt } run
            || finishedAt == _reopenedAfter
            || _form is not null
            || _group is null
        )
            return;

        var withheld =
            run.Outcome is { IsSuccess: false }
            || Row.Verdict is { Confidence: KeyConfidence.Withheld } verdict && verdict.Timestamp >= run.StartedAt;

        if (!withheld)
            return;

        _reopenedAfter = finishedAt;
        _form = BarForm.From(run, _group.Lender is not null);
    }

    private void OnJudgingChanged() =>
        _ = InvokeAsync(() =>
        {
            ReopenIfWithheld();
            StateHasChanged();
        });

    private List<Band> Bands(WarpGroup group)
    {
        if (_form is { } form)
            return
            [
                .. form
                    .Lines.Select((line, index) => (Window: form.Window(line, group), Line: line, Number: index + 1))
                    .Where(pair => pair.Window is not null)
                    .Select(pair => new Band(pair.Window!.Start, pair.Window.End, $"{pair.Number} · {pair.Line.Range.Trim()}", "yours", pair.Number - 1)),
            ];

        if (BarRun is { IsRunning: true } run)
        {
            var reading = run.Step is JudgeStep.DetectingWindow(var number, _, _) ? number : 0;
            var judgesTurn = run.JudgeAsked.Count > 0;
            var detecting = JudgeText.Phase(run) is 0;

            return
            [
                .. run.Direction.Windows.Select((window, index) =>
                    (!judgesTurn && detecting, reading - (index + 1)) switch
                    {
                        (true, 0) => new Band(window.Start, window.End, $"{index + 1} · reading…", "reading"),
                        (true, < 0) => new Band(window.Start, window.End, $"{index + 1} · {Span(group, window)}", "yours"),
                        _ => new Band(window.Start, window.End, $"{index + 1} · read", "yours"),
                    }
                ),
                .. run.JudgeAsked.Select((window, index) =>
                    new Band(
                        window.Start,
                        window.End,
                        $"judge · {Span(group, window)}",
                        detecting && reading == index + 1 ? "reading" : "judge"
                    )
                ),
            ];
        }

        return
        [
            .. Run?.Readings.Select((reading, index) =>
                reading switch
                {
                    { Window.AskedBy: WindowAsker.User, Section: { } section } =>
                        new Band(reading.Window.Start, reading.Window.End, $"{section.Label} · {ModeText.Tag(section.Center)}", "yours", Window: index),
                    { Window: { AskedBy: WindowAsker.User, Label: { Length: > 0 } label } } =>
                        new Band(reading.Window.Start, reading.Window.End, label, "yours", Window: index),
                    { Window.AskedBy: WindowAsker.User } =>
                        new Band(reading.Window.Start, reading.Window.End, Span(group, reading.Window), "yours", Window: index),
                    _ => new Band(reading.Window.Start, reading.Window.End, $"judge · {Span(group, reading.Window)}", "judge", Window: index),
                }
            ) ?? [],
        ];
    }

    private RenderFragment BandsIn(IReadOnlyList<Band> bands, double from, double to, bool tags) =>
        @<text>
            @foreach (var band in bands)
            {
                var (left, right) = (Math.Clamp(X(band.Start, from, to), 0, 100), Math.Clamp(X(band.End, from, to), 0, 100));
                @if (right > left)
                {
                    <div class="jband @band.Style @(band.Window is { } window && window == _openWindow ? "open" : null)" style="left: @P(left)%; width: @P(right - left)%" data-line="@band.Line">
                        @if (tags && band.Window is { } opens)
                        {
                            <button class="mono jtag" aria-expanded="@(opens == _openWindow ? "true" : "false")" title="@band.Tag · @(opens == _openWindow ? "close this window" : "what this window settled")" @onclick="() => ToggleWindow(opens)">@band.Tag</button>
                        }
                        else if (tags)
                        {
                            <span class="mono jtag" title="@band.Tag">@band.Tag</span>
                        }
                    </div>
                }
            }
        </text>;

    /// <summary>Where a drag on the ruler snaps, as fractions of the view: each bar line, or every few seconds without a warp.</summary>
    private static IEnumerable<double> SnapBounds(WarpGroup group, double from, double to)
    {
        if (group.Lender is not null)
        {
            if (group.BeatAt(from) is not { } first || group.BeatAt(to) is not { } last)
                yield break;

            for (var index = group.Bars.IndexAt(first); index <= group.Bars.IndexAt(last) + 1; index++)
            {
                if (group.SecondsAt(index * group.Bars.BeatsPerBar) is { } at && X(at, from, to) is >= 0 and <= 100 and var x)
                    yield return x / 100;
            }

            yield break;
        }

        var step = Math.Max(1, (int)Math.Ceiling((to - from) / 200));

        for (var second = (int)Math.Ceiling(from / step) * step; second <= to; second += step)
            yield return X(second, from, to) / 100;
    }

    /// <summary>A range let go on the ruler, as fractions of the view: whole bars, or whole seconds without a warp.</summary>
    [JSInvokable]
    public void DropRange(int line, double start, double end)
    {
        if (_form is not { } form || _group is not { } group)
            return;

        var (from, to) = View(group);
        var (startSeconds, endSeconds) = (from + start * (to - from), from + end * (to - from));

        if (!form.InBars)
            form.Place(line, (int)Math.Round(startSeconds), (int)Math.Round(endSeconds));
        else if (group.BeatAt(startSeconds) is { } first && group.BeatAt(endSeconds) is { } last)
            form.Place(line, group.Bars.BarAt(first + 0.001), group.Bars.BarAt(last - 0.001));

        StateHasChanged();
    }

    private GridReport? _offGrid;

    /// <summary>The Off the grid row's content for the track's canonical warp, when it is a steady one the check ran on (#96).</summary>
    private OffGridRow? OffGrid(WarpGroup group) =>
        Row.Bpm is { Source: TempoSource.Warp, Warp.Shape: TempoShape.Steady } tempo
        && _offGrid is { } report
        && Wording(group) is var wording
            ? new OffGridRow(tempo, report, wording.CanTrueUp(tempo))
            : null;

    private sealed record OffGridRow(TrackTempo Tempo, GridReport Report, bool CanTrueUp)
    {
        private const double ScaleMs = 30;

        /// <summary>Each 10 s window's median offset as a point in the plot, in percent; early is up.</summary>
        public IReadOnlyList<(double X, double Y)> Points(double from, double to) =>
            [
                .. Report
                    .Windows.Select(window =>
                        (
                            X: ((window.Start + window.End) / 2 - from) / (to - from) * 100,
                            Y: 50 + Math.Clamp(window.OffsetMs, -ScaleMs, ScaleMs) / ScaleMs * 50
                        )
                    )
                    .Where(point => point.X is >= 0 and <= 100),
            ];

        public string Figure =>
            (Tempo.Off, Tempo.Unconfirmed, Report.Windows.Count) switch
            {
                ({ DriftMs: { } _ }, _, _) => $"{TempoFormat.ByTheEnd(Tempo)} by the end",
                (_, { Reason: TrueUpReason.Steps }, _) => "steps in its grid",
                (_, not null, _) or (_, _, 0) => "too few transients",
                _ => "holds",
            };

        public string? Runs =>
            Tempo.Off is { DriftMs: { } ms }
                ? $"runs {TempoFormat.Runs(Tempo)} · grid falls {(ms < 0 ? "behind" : "ahead")}"
                : null;
    }

