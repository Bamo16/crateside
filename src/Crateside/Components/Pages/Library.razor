@page "/library"
@layout Crateside.Components.Layout.BareLayout
@using System.Globalization
@using Crateside.Core.Genres
@using Crateside.Core.Library
@using Crateside.Core.Orchestration.Edits
@using Crateside.Core.Tracks
@using Humanizer
@rendermode InteractiveServer
@inject LibrarySummary Summary
@inject GenreStore GenreRecords
@inject TracksService Tracks
@inject TrackAdd Adding

<PageTitle>Library · crateside</PageTitle>

<PageHeader Active="BrandNav.Tab.Library" Shape="PageHeader.Shapes.Bar" />

<div class="body">
    <header class="page-header">
        <div>
            <h1>Library</h1>
            <p class="subtitle">
                What is finished and filed, by key, one count per track however many samples it
                has. Counted from <strong>Ableton's own index</strong>, what the browser shows.
            </p>
        </div>
        <button class="refresh" @onclick="Reread" disabled="@_reading">
            @(_reading ? "Reading…" : "Re-read")
        </button>
    </header>

    @if (_distribution.FileCount is 0)
    {
        <p class="empty">Nothing to count — @_distribution.Root is not readable from here.</p>
    }
    else
    {
        <p class="summary">
            <strong>@_distribution.KeyedTrackCount</strong> of
            @("track".ToQuantity(_distribution.TrackCount)) carry a key, across
            @("key".ToQuantity(Represented)) of 24.
            @("file".ToQuantity(_distribution.FileCount)) in all.
        </p>

        @if (Unjudged.Count > 0)
        {
            <p class="unjudged">
                <strong>@("upload".ToQuantity(Unjudged.Count))</strong> here
                @(Unjudged.Count is 1 ? "was" : "were") never judged: tagged by hand before
                crateside, so the audit cannot check their keys.
                <button class="queue" @onclick="QueueUnjudged" disabled="@_reading">
                    Queue them for judging
                </button>
                Nothing is cut. Each is fetched and detected now, about 44 MB of audio apiece that
                stays until it is judged: one per idle Claude window, when Settings has that on.
            </p>
        }
        @if (_queued is { } queued)
        {
            <p class="unjudged">Queued @("upload".ToQuantity(queued)) for judging.</p>
        }

        @if (_distribution.PerishableCount > 0)
        {
            <p class="perishable">
                <strong>@("key".ToQuantity(_distribution.PerishableCount))</strong> here are not
                backed by an entry in the folder's tag store. Ableton shows them, but the next
                time anything writes that store — tagging a file in this folder by hand will do
                it — they are reconciled away. crateside backs them within a few minutes of
                starting.
            </p>
        }

        <table class="distribution">
            <thead>
                <tr>
                    <th>Key</th>
                    <th>Camelot</th>
                    <th class="bar-head">Tracks</th>
                    <th class="numeric">Count</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var count in Ordered)
                {
                    <tr class="@(count.Tracks is 0 ? "empty-bucket" : null)">
                        <td class="key">@count.Key.Name</td>
                        <td class="camelot">@count.Key.CamelotCode</td>
                        <td class="bar-cell">
                            <span class="bar @(count.Key.Mode.ToString().ToLowerInvariant())"
                                  style="width: @Width(count)%"></span>
                        </td>
                        <td class="numeric">@count.Tracks</td>
                    </tr>
                }
            </tbody>
        </table>

        <section class="genres">
            <h2>By genre</h2>
            <p class="subtitle">
                <strong>@("track".ToQuantity(_distribution.UngenredCount))</strong> carry no genre
                yet. That means nobody has settled one, not that they have none: a genre is settled
                on each track's row, and written within a few minutes.
            </p>

            <table class="distribution">
                <thead>
                    <tr>
                        <th>Genre</th>
                        <th class="bar-head">Tracks</th>
                        <th class="numeric">Count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var genre in _distribution.Genres.OrderByDescending(g => g.Tracks))
                    {
                        <tr class="@(genre.Tracks is 0 ? "empty-bucket" : null)">
                            <td class="key">@genre.Genre</td>
                            <td class="bar-cell">
                                <span class="bar" style="width: @GenreWidth(genre)%"></span>
                            </td>
                            <td class="numeric">@genre.Tracks</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (_gaps.Count > 0)
            {
                <h3>What the sources called the rest</h3>
                <p class="subtitle">
                    Songs settled as none of the list, or that the sources could not place on it. A
                    label that keeps coming up is a genre the list may want.
                </p>
                <ul class="gaps">
                    @foreach (var gap in _gaps.Take(15))
                    {
                        <li><span>@gap.Label</span> <span class="numeric">@("song".ToQuantity(gap.Songs))</span></li>
                    }
                </ul>
            }
        </section>

        @if (_distribution.Unkeyed.Count > 0)
        {
            <section class="unkeyed">
                <h2>@("file".ToQuantity(_distribution.Unkeyed.Count)) with no key</h2>
                <p class="subtitle">
                    Not a gap in what crateside can see — Ableton holds no key for these either.
                </p>
                <ul>
                    @foreach (var file in _distribution.Unkeyed)
                    {
                        <li>@file</li>
                    }
                </ul>
            </section>
        }
    }
</div>

@code {
    private KeyDistribution _distribution = null!;
    private IReadOnlyList<GenreGap> _gaps = [];
    private bool _reading;
    private int? _queued;

    private IReadOnlyList<TrackRowFacts> Unjudged =>
        [
            .. (Tracks.Current?.Rows ?? [])
                .Where(row => row is { IsLibraryOnly: true, Verdict: null, IsAddedByUrl: false })
                .Select(row => row.Facts),
        ];

    private async Task QueueUnjudged()
    {
        _reading = true;

        try
        {
            _queued = Adding.QueueUnjudged(Unjudged);

            await Tracks.RefreshAsync();
        }
        finally
        {
            _reading = false;
        }
    }

    private IEnumerable<KeyCount> Ordered =>
        _distribution.Counts.OrderByDescending(c => c.Tracks).ThenBy(c => c.Key);

    private int Represented => _distribution.Counts.Count(c => c.Tracks > 0);

    protected override void OnInitialized()
    {
        _distribution = Summary.Current;
        _gaps = GenreGaps.From(GenreRecords.Read().Values);
    }

    private async Task Reread()
    {
        _reading = true;

        _distribution = await Task.Run(Summary.Refresh);
        _gaps = GenreGaps.From(GenreRecords.Read().Values);

        _reading = false;
    }

    private string GenreWidth(GenreCount genre) =>
        (_distribution.Genres.Max(g => g.Tracks) is var largest and > 0
            ? genre.Tracks * 100.0 / largest
            : 0).ToString("0.#", CultureInfo.InvariantCulture);

    private string Width(KeyCount count) =>
        (_distribution.Largest is 0 ? 0 : count.Tracks * 100.0 / _distribution.Largest).ToString(
            "0.#",
            CultureInfo.InvariantCulture
        );
}
