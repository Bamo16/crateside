@page "/queue"
@using Crateside.Core.Queue
@inject QueueService QueueService
@rendermode InteractiveServer

<PageTitle>Queue — crateside</PageTitle>

<header class="page-header">
    <div>
        <h1>Queue</h1>
        <p class="subtitle">What is in the playlist, what is already done, and what is new.</p>
    </div>
    <button class="refresh" @onclick="Load" disabled="@(_loading || !QueueService.IsConfigured)">
        @(_loading ? "Reading…" : "Refresh")
    </button>
</header>

@if (!QueueService.HasCredential)
{
    @* The key is the one thing the UI cannot set — it is a secret and stays out of the app. *@
    <div class="notice">
        <strong>No API key.</strong>
        Set it once from the repo root, then restart:
        <pre><code>dotnet user-secrets set "Queue:ApiKey" "&lt;key&gt;" --project src\Crateside\Crateside.csproj</code></pre>
        A read-only key restricted to the YouTube Data API is enough. See
        <code>docs/secrets.md</code>.
    </div>
}

<div class="playlist-setting">
    <label>
        <span>Playlist</span>
        <input type="text" placeholder="Playlist ID, or paste the playlist URL"
               @bind="_playlistInput" @bind:event="oninput" />
    </label>
    <button @onclick="SavePlaylist" disabled="@(!HasPendingChange)">Save</button>
    @if (_settingProblem is { } problem)
    {
        <span class="problem">@problem</span>
    }
    else if (QueueService.PlaylistId is { Length: > 0 } current)
    {
        <a class="open" href="@($"https://www.youtube.com/playlist?list={current}")"
           target="_blank" rel="noopener">Open on YouTube</a>
    }
</div>

@if (!QueueService.IsConfigured)
{
    <p class="empty">Set a playlist to read.</p>
}
else if (_error is { } error)
{
    @* Never render an unreadable queue as an empty one — they mean opposite things. *@
    <div class="notice error">
        <strong>Could not read the playlist.</strong>
        @error
    </div>
}
else if (_view is null)
{
    <p class="empty">Reading the playlist…</p>
}
else if (_view.Items.Count == 0)
{
    <p class="empty">The playlist is empty. Nothing is waiting to be worked.</p>
}
else
{
    <p class="summary">
        @_view.Items.Count queued —
        <strong>@_view.Outstanding.Count new</strong>,
        @_view.FullyProcessed.Count done@(_view.Stalled.Count > 0
            ? $", {_view.Stalled.Count} stalled" : "").
    </p>

    @if (_view.Outstanding.Count > 0)
    {
        <QueueSection Title="New" Items="_view.Outstanding"
                      Detail="Not yet detected. This is the work list — paste these into a detect-key session." />
    }

    @if (_view.Stalled.Count > 0)
    {
        <QueueSection Title="Stalled" Items="_view.Stalled" Tone="warn"
                      Detail="A verdict was recorded but no stems are on disk — a separation that died partway, or stems that were deleted. These stay queued deliberately." />
    }

    @if (_view.FullyProcessed.Count > 0)
    {
        <QueueSection Title="Done" Items="_view.FullyProcessed" Tone="muted"
                      Detail="Fully processed: a verdict and stems on disk. These are what the deletion step would remove." />
    }
}

@code {
    private QueueView? _view;
    private string? _error;
    private string? _settingProblem;
    private string _playlistInput = string.Empty;
    private bool _loading;

    private bool HasPendingChange =>
        PlaylistReference.Parse(_playlistInput) != QueueService.PlaylistId
        && !string.IsNullOrWhiteSpace(_playlistInput);

    protected override async Task OnInitializedAsync()
    {
        _playlistInput = QueueService.PlaylistId ?? string.Empty;
        await Load();
    }

    private async Task SavePlaylist()
    {
        _settingProblem = PlaylistReference.Problem(PlaylistReference.Parse(_playlistInput));

        if (_settingProblem is not null)
            return;

        QueueService.SetPlaylist(_playlistInput);
        _playlistInput = QueueService.PlaylistId ?? string.Empty;
        _view = null;

        await Load();
    }

    private async Task Load()
    {
        if (!QueueService.IsConfigured)
            return;

        _loading = true;
        _error = null;

        try
        {
            _view = await QueueService.ReadAsync();
        }
        catch (QueueUnavailableException e)
        {
            _view = null;
            _error = e.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
