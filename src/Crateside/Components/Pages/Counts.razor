@page "/counts"
@layout Crateside.Components.Layout.BareLayout
@rendermode InteractiveServer

@implements IAsyncDisposable

@using System.Globalization
@using System.Text
@using Crateside.Core.Beats
@using Crateside.Core.Familiarity
@using Crateside.Core.Genres
@using Crateside.Core.Library
@using Crateside.Core.Orchestration.Edits
@using Crateside.Core.Tracks
@using Humanizer

@inject LibrarySummary Summary
@inject GenreStore GenreRecords
@inject FamiliarityStore FamiliarityRecords
@inject TracksService Tracks
@inject BeatReader Beats
@inject TrackAdd Adding
@inject IJSRuntime Js

<PageTitle>Counts · crateside</PageTitle>

<PageHeader Active="BrandNav.Tab.Counts" Shape="PageHeader.Shapes.Bar" />

<div class="body">
    <header class="page-header">
        <div>
            <h1>Counts</h1>
            @if (_distribution.FileCount > 0)
            {
                <p class="subtitle">
                    What is finished and filed, counted one per song however many samples it has.
                    <span class="mono">@_distribution.TrackCount.ToString("N0")</span> songs,
                    <span class="mono">@_distribution.KeyedTrackCount.ToString("N0")</span> with a key
                    across <span class="mono">@Represented</span> of 24 keys,
                    <span class="mono">@_distribution.FileCount.ToString("N0")</span> files.
                </p>
            }
        </div>
        <button class="refresh" @onclick="Reread" disabled="@_reading">
            @(_reading ? "Reading…" : "Re-read")
        </button>
    </header>

    @if (_distribution.FileCount is 0)
    {
        <p class="empty">Nothing to count — @_distribution.Root is not readable from here.</p>
    }
    else
    {
        @if (_queued is { } queued)
        {
            <div class="band" id="never-judged">
                <span class="band-label">Never judged</span>
                <span class="band-value">Queued <span class="mono">@queued</span> for judging</span>
            </div>
        }
        else if (Unjudged.Count > 0)
        {
            <div class="band" id="never-judged">
                <div class="band-line">
                    <span class="band-label">Never judged</span>
                    <button class="outline" @onclick="QueueUnjudged" disabled="@_reading">
                        Queue them for judging
                    </button>
                </div>
                <span class="band-value">
                    <span class="mono">@Unjudged.Count</span>
                    @("upload".ToQuantity(Unjudged.Count, ShowQuantityAs.None)) tagged by hand before crateside
                </span>
                <p class="band-status">
                    The audit cannot check their keys. Queuing cuts nothing: each is fetched and
                    detected, about 44 MB apiece until judged, one per idle Claude window when
                    Settings has that on.
                </p>
            </div>
        }

        <div class="grid">
            <nav class="index" @ref="_index">
                <span class="index-head">On this page</span>
                @foreach (var entry in Index)
                {
                    <a href="counts#@entry.Id" data-panel="@entry.Id">
                        <span>@entry.Label</span>
                        <span class="mono count">@entry.Count</span>
                    </a>
                }
            </nav>

            <div class="panels">
                <section id="p-key">
                    <h3>By key</h3>

                    <table class="distribution">
                        <thead>
                            <tr>
                                <th class="name-col">Key</th>
                                <th class="camelot-col">Camelot</th>
                                <th>Songs</th>
                                <th class="numeric count-col">Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var count in _allKeys ? Ordered : Ordered.Take(KeysShown))
                            {
                                <tr class="@(count.Tracks is 0 ? "empty-bucket" : null)">
                                    <td>@count.Key.Name</td>
                                    <td class="camelot mono">@count.Key.CamelotCode</td>
                                    <td class="bar-cell">
                                        <span class="bar @count.Key.Mode.ToString().ToLowerInvariant()"
                                              style="width: @Percent(count.Tracks, _distribution.Largest)"></span>
                                    </td>
                                    <td class="numeric">@count.Tracks</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="fold">
                        @if (_allKeys)
                        {
                            <text>All 24 keys · <button class="link" @onclick="() => _allKeys = false">fewer</button></text>
                        }
                        else
                        {
                            <text>Showing the top @KeysShown · <button class="link" @onclick="() => _allKeys = true">all 24 keys</button></text>
                        }
                    </p>

                    @if (_distribution.PerishableCount > 0)
                    {
                        <p class="footnote">
                            <span class="mono">@_distribution.PerishableCount</span> of these keys
                            @(_distribution.PerishableCount is 1 ? "is" : "are") not yet backed by the
                            folder's tag store, so a hand edit there would drop them. crateside backs
                            them within a few minutes of starting.
                        </p>
                    }
                </section>

                @if (_tempo.Warped > 0)
                {
                    <section id="p-tempo">
                        <h3>By tempo</h3>
                        <p class="lead">
                            The BPM from each warp, set by ear.
                            @if (_tempo.Warped == _distribution.TrackCount)
                            {
                                <text>All <span class="mono">@_tempo.Warped</span> songs are warped.</text>
                            }
                            else
                            {
                                <text><span class="mono">@_tempo.Warped</span> of <span class="mono">@_distribution.TrackCount</span> songs are warped.</text>
                            }
                            The solid part of a bar is the tempos that ten or more songs share.
                        </p>

                        <table class="distribution">
                            <thead>
                                <tr>
                                    <th class="name-col">BPM</th>
                                    <th>Songs</th>
                                    <th class="numeric count-col">Count</th>
                                    <th class="peaks-col">Shared by @TempoCounts.SharedBy or more</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bin in _tempo.Bins)
                                {
                                    <tr class="@(bin.Songs is 0 ? "empty-bucket" : null)">
                                        <td class="mono">@bin.Label</td>
                                        <td class="bar-cell">
                                            <span class="bar split" style="width: @Percent(bin.Songs, _tempo.Largest)">
                                                <span class="peak" style="width: @Percent(bin.PeakSongs, bin.Songs)"></span>
                                            </span>
                                        </td>
                                        <td class="numeric">@bin.Songs</td>
                                        <td class="peaks mono">
                                            @string.Join("  ", bin.Peaks.Select(peak => $"{peak.Bpm} ×{peak.Songs}"))
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <p class="shapes">
                            <span>Steady <span class="mono value">@_tempo.Steady</span></span>
                            <span>Mostly steady <span class="mono value">@_tempo.MostlySteady</span></span>
                            <span>Drifting <span class="mono value">@_tempo.Drifting</span>, counted at their median</span>
                        </p>

                        @if (_drift.Any(count => count.Judged > 0))
                        {
                            <p class="shapes">
                                <span>beatdetect flags as drifting</span>
                                @foreach (var count in _drift)
                                {
                                    <span>@count.Shape.Humanize() <span class="mono value">@count.Flagged</span> of <span class="mono">@count.Judged</span></span>
                                }
                            </p>
                        }
                    </section>
                }

                <section id="p-genre">
                    <h3>By genre</h3>
                    <p class="lead">
                        <span class="mono">@_distribution.UngenredCount</span>
                        @("song".ToQuantity(_distribution.UngenredCount, ShowQuantityAs.None))
                        carry no genre yet: nobody has settled one.
                        <a href="tracks?filter=TagsToAnswer">Answer them on Tracks</a>
                    </p>

                    <table class="distribution">
                        <tbody>
                            @foreach (var genre in _distribution.Genres.OrderByDescending(g => g.Tracks))
                            {
                                <tr class="@(genre.Tracks is 0 ? "empty-bucket" : null)">
                                    <td class="wide-name-col">@genre.Genre</td>
                                    <td class="bar-cell">
                                        <span class="bar" style="width: @Percent(genre.Tracks, GenreLargest)"></span>
                                    </td>
                                    <td class="numeric count-col">@genre.Tracks</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (_gaps.Count > 0)
                    {
                        <h4>What the sources called the rest</h4>
                        <p class="lead">
                            Songs settled as none of the list, or that the sources could not place on
                            it. A label that keeps coming up is a genre the list may want.
                        </p>
                        <ul class="gaps">
                            @foreach (var gap in _gaps.Take(15))
                            {
                                <li><span>@gap.Label</span> <span class="numeric">@("song".ToQuantity(gap.Songs))</span></li>
                            }
                        </ul>
                    }
                </section>

                <section id="p-familiarity">
                    <h3>By familiarity</h3>

                    <table class="distribution">
                        <tbody>
                            @foreach (var (value, songs) in _familiarity)
                            {
                                <tr class="@(value is null ? "empty-bucket" : null)">
                                    <td class="wide-name-col">@(value ?? "Not answered")</td>
                                    <td class="bar-cell">
                                        <span class="bar" style="width: @Percent(songs, _familiarity.Max(f => f.Songs))"></span>
                                    </td>
                                    <td class="numeric count-col">@songs</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>

                @if (_artists.Artists.Count > 0)
                {
                    <section id="p-artist">
                        <h3>By artist</h3>
                        <p class="lead">
                            Artists with three or more songs, by first credited name:
                            <span class="mono">@_artists.Artists.Count</span> of
                            <span class="mono">@_artists.AllArtists</span>. The rest have one or two each.
                        </p>

                        <table class="distribution">
                            <thead>
                                <tr>
                                    <th class="artist-col">Artist</th>
                                    <th>Songs</th>
                                    <th class="numeric count-col">Count</th>
                                    <th class="keys-col">Keys</th>
                                    <th class="bpm-col">BPM</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var artist in _allArtists ? _artists.Artists : _artists.Artists.Take(ArtistsShown))
                                {
                                    <tr>
                                        <td class="artist" title="@artist.Artist">@artist.Artist</td>
                                        <td class="bar-cell">
                                            <span class="bar" style="width: @Percent(artist.Songs, _artists.Largest)"></span>
                                        </td>
                                        <td class="numeric">@artist.Songs</td>
                                        <td class="quiet mono">@string.Join(" ", artist.Keys)</td>
                                        <td class="quiet mono">@artist.BpmRange</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (_artists.Artists.Count > ArtistsShown)
                        {
                            <p class="fold">
                                @if (_allArtists)
                                {
                                    <text>All @_artists.Artists.Count · <button class="link" @onclick="() => _allArtists = false">fewer</button></text>
                                }
                                else
                                {
                                    <text>Showing @ArtistsShown of @_artists.Artists.Count · <button class="link" @onclick="() => _allArtists = true">all @_artists.Artists.Count</button></text>
                                }
                            </p>
                        }
                    </section>
                }

                @if (_detectors.Songs > 0)
                {
                    <section id="p-detectors">
                        <h3>Detectors against the warps</h3>
                        <p class="lead">
                            How often each detector's BPM matches the one set by ear, on the
                            <span class="mono">@_detectors.Songs</span> songs that have both.
                            beatdetect is read by crateside on each instrumental@(Beats.Build is { } build ? $" with ffmpeg {build.Version}" : null).
                        </p>

                        <div class="detectors">
                            <div class="det-row det-head">
                                <span>Reads the tempo</span>
                                @foreach (var detector in Detectors)
                                {
                                    <span>@DetectorHead(detector)</span>
                                }
                            </div>

                            @foreach (var band in Enum.GetValues<TempoBand>())
                            {
                                <div class="det-row @(band is TempoBand.TripletOrDotted ? "finding" : null)">
                                    <span class="band-name">
                                        <span class="band-title">@BandName(band)</span>
                                        <span class="rule mono">@BandRule(band)</span>
                                    </span>
                                    @foreach (var detector in Detectors)
                                    {
                                        var reads = _detectors.Reads(detector, band).Count;

                                        <span class="det-cell">
                                            <span class="bar" style="width: @Percent(reads, _detectors.Largest)"></span>
                                            <button class="count mono @(_open == (detector, band) ? "open" : null)"
                                                    @onclick="() => Toggle(detector, band)" disabled="@(reads is 0)">
                                                @reads
                                            </button>
                                        </span>
                                    }
                                </div>

                                @if (_open is { } open && open.Band == band)
                                {
                                    var songs = _detectors.Reads(open.Detector, open.Band);

                                    <div class="band-songs">
                                        <div class="band-line">
                                            <span class="band-label">@BandSentence(open.Detector, open.Band, songs.Count)</span>
                                            <div class="actions">
                                                <button class="outline" @onclick="() => Copy(open.Detector, open.Band)">
                                                    @(_copied ? "Copied" : "Copy as text")
                                                </button>
                                                <button class="outline" @onclick="() => _open = null">Close</button>
                                            </div>
                                        </div>

                                        <div class="song-row song-head">
                                            <span>Song</span>
                                            <span class="numeric">Warp</span>
                                            <span class="numeric">Read</span>
                                            <span class="numeric">Ratio</span>
                                        </div>
                                        @foreach (var read in _allSongs ? songs : songs.Take(SongsShown))
                                        {
                                            <div class="song-row">
                                                <span>@read.Song.Name</span>
                                                <span class="numeric">@TempoCounts.Whole(read.Warped)</span>
                                                <span class="numeric">@TempoCounts.Whole(read.Read)</span>
                                                <span class="numeric quiet">@read.Ratio.ToString("0.00", CultureInfo.InvariantCulture)</span>
                                            </div>
                                        }
                                        @if (!_allSongs && songs.Count > SongsShown)
                                        {
                                            <p class="fold">
                                                @(songs.Count - SongsShown) more ·
                                                <button class="link" @onclick="() => _allSongs = true">show all</button>
                                            </p>
                                        }
                                    </div>
                                }
                            }
                        </div>

                        <div class="misses">
                            <div class="misses-head">
                                <span class="band-label">Where the misses land · detected ÷ warped</span>
                                <span class="quiet">exact matches left out</span>
                            </div>

                            @foreach (var detector in Detectors)
                            {
                                <div class="strip-row">
                                    <span class="strip-name">@DetectorHead(detector)</span>
                                    <div class="strip">
                                        @foreach (var height in _strips[detector])
                                        {
                                            <span style="height: @(height)px"></span>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="strip-row">
                                <span></span>
                                <div class="ticks">
                                    @foreach (var (ratio, label) in Ticks)
                                    {
                                        <span class="tick @(ratio is 2.0 / 3 or 0.75 ? "strong" : null)"
                                              style="left: @Position(ratio)">
                                            <span class="tick-mark"></span>
                                            <span class="mono">@label</span>
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </section>
                }

                @if (_distribution.Unkeyed.Count > 0)
                {
                    <section id="p-unkeyed">
                        <h3>@("file".ToQuantity(_distribution.Unkeyed.Count)) with no key</h3>
                        <details class="opener">
                            <summary>
                                Show the files
                                <span class="aside">Ableton holds no key for these either</span>
                            </summary>
                            <ul class="unkeyed">
                                @foreach (var file in _distribution.Unkeyed)
                                {
                                    <li>@file</li>
                                }
                            </ul>
                        </details>
                    </section>
                }
            </div>
        </div>
    }
</div>

@code {
    private const int KeysShown = 8;
    private const int ArtistsShown = 12;
    private const int SongsShown = 8;
    private const int StripBins = 64;
    private const int StripHeight = 64;
    private const double StripLow = 0.4;
    private const double StripHigh = 2.2;

    private static readonly Detector[] Detectors = [Detector.Keytag, Detector.Beatdetect];

    private static readonly (double Ratio, string Label)[] Ticks =
    [
        (0.5, "½"),
        (2.0 / 3, "2/3"),
        (0.75, "3/4"),
        (1, "1"),
        (4.0 / 3, "4/3"),
        (1.5, "3/2"),
        (2, "2"),
    ];

    private KeyDistribution _distribution = null!;
    private IReadOnlyList<GenreGap> _gaps = [];
    private TempoCounts _tempo = null!;
    private ArtistCounts _artists = null!;
    private DetectorBands _detectors = null!;
    private IReadOnlyList<DriftCount> _drift = [];
    private Dictionary<Detector, int[]> _strips = [];
    private IReadOnlyList<(string? Value, int Songs)> _familiarity = [];

    private bool _reading;
    private int? _queued;
    private bool _allKeys;
    private bool _allArtists;
    private (Detector Detector, TempoBand Band)? _open;
    private bool _allSongs;
    private bool _copied;

    private ElementReference _index;
    private IJSObjectReference? _module;
    private IJSObjectReference? _watch;

    private IReadOnlyList<TrackRowFacts> Unjudged =>
        [
            .. (Tracks.Current?.Rows ?? [])
                .Where(row => row is { IsLibraryOnly: true, Verdict: null, IsAddedByUrl: false })
                .Select(row => row.Facts),
        ];

    private IEnumerable<KeyCount> Ordered =>
        _distribution.Counts.OrderByDescending(c => c.Tracks).ThenBy(c => c.Key);

    private int Represented => _distribution.Counts.Count(c => c.Tracks > 0);

    private int GenreLargest => _distribution.Genres.Select(g => g.Tracks).DefaultIfEmpty().Max();

    private IEnumerable<(string Id, string Label, int Count)> Index =>
        new (string Id, string Label, int Count, bool Drawn)[]
        {
            ("p-key", "By key", Represented, true),
            ("p-tempo", "By tempo", _tempo.Warped, _tempo.Warped > 0),
            ("p-genre", "By genre", _distribution.Genres.Count(g => g.Tracks > 0), true),
            ("p-familiarity", "By familiarity", _familiarity.Count(f => f is { Value: not null, Songs: > 0 }), true),
            ("p-artist", "By artist", _artists.Artists.Count, _artists.Artists.Count > 0),
            ("p-detectors", "Detectors", _detectors.Songs, _detectors.Songs > 0),
            ("p-unkeyed", "No key", _distribution.Unkeyed.Count, _distribution.Unkeyed.Count > 0),
        }
            .Where(entry => entry.Drawn)
            .Select(entry => (entry.Id, entry.Label, entry.Count));

    protected override void OnInitialized() => Count(Summary.Current);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _distribution.FileCount is 0)
            return;

        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Counts.razor.js");
        _watch = await _module.InvokeAsync<IJSObjectReference>("watch", _index);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_watch is not null)
            {
                await _watch.InvokeVoidAsync("dispose");
                await _watch.DisposeAsync();
            }

            if (_module is not null)
                await _module.DisposeAsync();
        }
        // The circuit is already gone when the tab is closed.
        catch (JSDisconnectedException) { }
    }

    private void Count(KeyDistribution distribution)
    {
        _distribution = distribution;
        _gaps = GenreGaps.From(GenreRecords.Read().Values);
        _tempo = TempoCounts.From(distribution.Songs);
        _artists = ArtistCounts.From(distribution.Songs);
        _detectors = DetectorBands.From(distribution.Songs);
        _drift = DriftCount.From(distribution.Songs);

        var strips = Detectors.ToDictionary(detector => detector, Strip);
        var tallest = strips.Values.SelectMany(bins => bins).DefaultIfEmpty().Max();
        _strips = strips.ToDictionary(pair => pair.Key, pair => Scaled(pair.Value, tallest));

        var familiarity = FamiliarityRecords.Read();
        var written = distribution
            .Songs.Select(song => familiarity.GetValueOrDefault(song.Song)?.Written)
            .ToList();

        _familiarity =
        [
            .. FamiliarityVocabulary.All.Select(value => ((string?)value, written.Count(w => w == value))),
            (null, written.Count(w => w is null)),
        ];
    }

    private async Task Reread()
    {
        _reading = true;

        Count(await Task.Run(Summary.Refresh));

        _reading = false;
    }

    private async Task QueueUnjudged()
    {
        _reading = true;

        try
        {
            _queued = Adding.QueueUnjudged(Unjudged);

            await Tracks.RefreshAsync();
        }
        finally
        {
            _reading = false;
        }
    }

    private void Toggle(Detector detector, TempoBand band)
    {
        _open = _open == (detector, band) ? null : (detector, band);
        _allSongs = false;
        _copied = false;
    }

    private async Task Copy(Detector detector, TempoBand band)
    {
        var reads = _detectors.Reads(detector, band);
        var text = new StringBuilder().AppendLine(BandSentence(detector, band, reads.Count));

        foreach (var read in reads)
            text.AppendLine(
                $"{read.Song.Name} · {TempoCounts.Whole(read.Warped)} · {TempoCounts.Whole(read.Read)} · {read.Ratio.ToString("0.00", CultureInfo.InvariantCulture)}"
            );

        await Js.InvokeVoidAsync("navigator.clipboard.writeText", text.ToString());
        _copied = true;
    }

    /// <summary>Column heights for one detector's misses, on a log₂ axis shared by both strips.</summary>
    private int[] Strip(Detector detector)
    {
        var bins = new int[StripBins];

        foreach (var miss in _detectors.Misses(detector))
        {
            var at = (Math.Log2(miss.Ratio) - Math.Log2(StripLow)) / (Math.Log2(StripHigh) - Math.Log2(StripLow));

            if (at is >= 0 and < 1)
                bins[(int)(at * StripBins)]++;
        }

        return bins;
    }

    private static int[] Scaled(int[] bins, int largest) =>
        [.. bins.Select(count => largest is 0 || count is 0 ? 0 : Math.Max(1, count * StripHeight / largest))];

    private static string Position(double ratio) =>
        Percent((Math.Log2(ratio) - Math.Log2(StripLow)) / (Math.Log2(StripHigh) - Math.Log2(StripLow)) * 100, 100);

    private static string DetectorHead(Detector detector) =>
        detector switch
        {
            Detector.Keytag => "keytag, recommended",
            Detector.Beatdetect => "beatdetect, raw",
            _ => detector.ToString(),
        };

    private string BandName(TempoBand band) =>
        band switch
        {
            TempoBand.Exact => "Exact",
            TempoBand.Close => "Close",
            TempoBand.HalfOrDouble => "Half or double",
            TempoBand.TripletOrDotted when _detectors.ReadsFastToo => "Triplet or dotted",
            TempoBand.TripletOrDotted => "Two-thirds or three-quarters",
            _ => "Wrong",
        };

    private string BandRule(TempoBand band) =>
        band switch
        {
            TempoBand.Exact => "within 0.5",
            TempoBand.Close => "within 2",
            TempoBand.HalfOrDouble => "×½ · ×2 · ±2",
            TempoBand.TripletOrDotted when _detectors.ReadsFastToo => "×2/3 · ×3/4 · ×4/3 · ×3/2 · ±2",
            TempoBand.TripletOrDotted => "×2/3 · ×3/4 · ±2",
            _ => "anything else",
        };

    private string BandSentence(Detector detector, TempoBand band, int songs) =>
        $"{(detector is Detector.Keytag ? "keytag" : "beatdetect")} · {"song".ToQuantity(songs)} "
        + band switch
        {
            TempoBand.Exact => "read exactly",
            TempoBand.Close => "read within 2",
            TempoBand.HalfOrDouble => "read at half or double",
            TempoBand.TripletOrDotted when _detectors.ReadsFastToo => "read as a triplet or dotted tempo",
            TempoBand.TripletOrDotted => "read at two-thirds or three-quarters",
            _ => "read wrong",
        };

    private static string Percent(double part, double whole) =>
        $"{(whole is 0 ? 0 : part * 100 / whole).ToString("0.#", CultureInfo.InvariantCulture)}%";
}
