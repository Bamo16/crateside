    private int Backfill(Func<TrackRow, bool> matches) =>
        Rows.Count(row => row.IsBackfill && matches(row));

    public void Dispose()
    {
        Tracks.Changed -= OnChanged;
        Spend.Changed -= OnChanged;
    }

    protected override void OnInitialized()
    {
        Tracks.Changed += OnChanged;
        Spend.Changed += OnChanged;

        _staging = Paths.StagingFolder;
        _library = Paths.LibraryFolder;

        _playlist = Playlist.PlaylistId ?? string.Empty;
        var saved = PlaylistStore.Read();
        _refresh = saved.RefreshMinutes ?? PlaylistSettings.DefaultRefreshMinutes;
        _consume = saved.ConsumeOnArrival;
        _retention = RetentionStore.Read();
        _days = _retention.Days;
        LoadSpendDown();
    }

    // After the first paint, so the page opens before the playlist and channel are read from YouTube.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Tracks.EnsureFreshAsync(TimeSpan.FromSeconds(30));
        await Load();
        StateHasChanged();
    }

    // Raised on a worker thread, never the circuit's, so the render is marshalled back.
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    // Takes effect on the next poll, not at the next restart.
    private void SaveRefresh(int minutes)
    {
        _refresh = minutes;
        PlaylistStore.SaveRefreshMinutes(minutes);
    }

    private void SaveConsume(bool consume)
    {
        _consume = consume;
        PlaylistStore.SaveConsumeOnArrival(consume);
    }

    private static string RefreshLabel(int minutes) =>
        minutes switch
        {
            0 => "Never",
            60 => "1 hour",
            _ => $"{minutes} min",
        };

    private void Reveal(Folder folder)
    {
        _folderProblem = null;

        try
        {
            if (folder.IsFile)
                Process.Start("explorer.exe", $"/select,\"{folder.Path}\"");
            else
                Process.Start(new ProcessStartInfo(folder.Path) { UseShellExecute = true });
        }
        catch (Exception ex)
        {
            _folderProblem = $"Could not open {folder.Path}: {ex.Message}";
        }
    }

    private void Chosen(Place place, string folder)
    {
        _choosing = null;

        if (place is Place.Staging)
            _staging = folder;
        else
            _library = folder;

        Overrides.Remember(_staging, _library);
        _foldersChanged = true;
    }

    private async Task Save()
    {
        _playlistProblem = PlaylistReference.Problem(_playlist);

        if (_playlistProblem is not null)
            return;

        Playlist.SetPlaylist(_playlist);
        _playlist = Playlist.PlaylistId ?? string.Empty;

        await Load();
    }

    private async Task Consent()
    {
        _working = true;
        _consentProblem = null;

        try
        {
            await Authorizer.ConsentAsync();
        }
        catch (Exception ex)
        {
            _consentProblem = $"Consent did not complete: {ex.Message}";
        }
        finally
        {
            _working = false;
        }

        await Load();
    }

    private async Task SignOut()
    {
        await Authorizer.SignOutAsync();

        _confirming = false;
        _channel = null;
    }

    private async Task RemoveProcessed()
    {
        _working = true;
        _removeProblem = null;

        try
        {
            _removals = await WorkLists.RemoveProcessedAsync();
            _confirming = false;

            await Load();
        }
        catch (PlaylistUnavailableException ex)
        {
            _removeProblem = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }

    /// <summary>Reads enough to preview what removal would do; the removal derives its set again.</summary>
    private async Task Load()
    {
        if (!Playlist.IsConfigured)
            return;

        try
        {
            _processed = (await WorkLists.ReadAsync()).FullyProcessed.Count;

            if (Authorizer.IsAuthorized)
                _channel = await Authorizer.GetAuthorizedChannelAsync();
        }
        catch (PlaylistUnavailableException ex)
        {
            _processed = null;
            _removeProblem = ex.Message;
        }
    }

    private sealed record Folder(
        string Name,
        string Gist,
        string Path,
        bool IsFile,
        Place? Place = null
    );

    private enum Place
    {
        Staging,
        Library,
    }
