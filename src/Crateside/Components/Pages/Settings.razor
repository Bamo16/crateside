@page "/settings"
@layout Crateside.Components.Layout.BareLayout
@rendermode InteractiveServer

@implements IDisposable

@using Crateside.Core.Orchestration.Loop
@using Crateside.Core.Queue
@using Crateside.Core.Quota
@using Crateside.Core.Tracks
@using Humanizer

@inject QueueService Playlist
@inject TracksService Tracks
@inject WindowRoll Roll
@inject PauseStore Remembered

<PageTitle>Settings</PageTitle>

<div class="settings">
    <PageHeader Active="BrandNav.Tab.Settings" Shape="PageHeader.Shapes.Flush" />

    <div class="body">
        <section>
            <h2>Playlist</h2>
            <p class="detail">
                The queue crateside works from. Paste the playlist's URL or just its ID.
            </p>

            <div class="field">
                <input type="text" placeholder="Playlist ID, or the playlist URL"
                       @bind="_playlist" @bind:event="oninput" />
                <button class="primary" @onclick="Save" disabled="@(!HasPendingChange)">Save</button>
            </div>

            @if (_playlistProblem is { } problem)
            {
                <p class="problem">@problem</p>
            }
            else if (Playlist.PlaylistId is { Length: > 0 } current)
            {
                <a class="out" href="@($"https://www.youtube.com/playlist?list={current}")"
                   target="_blank" rel="noopener">Open on YouTube</a>
            }
        </section>

        <section>
            <h2>Looking for new tracks</h2>
            <p class="detail">
                The playlist is added to from other devices and <code>Sample Staging</code> is
                emptied in Ableton. Neither tells crateside anything, so the only way either is
                noticed is to look. This is how often the Tracks page looks; the stages read the
                queue on their own two-minute loop regardless, so work starts either way.
            </p>

            <div class="field">
                <select @bind="_refresh" @bind:after="SaveRefresh">
                    @foreach (var minutes in RefreshChoices)
                    {
                        <option value="@minutes">@RefreshLabel(minutes)</option>
                    }
                </select>
            </div>

            <p class="detail">
                Nearly free at any setting: the playlist read pages at fifty, the API's maximum, so
                the whole list is one quota unit against a daily ten thousand — 288 a day at five
                minutes, 48 at thirty.
            </p>
        </section>

        <section>
            <h2>Library backfill</h2>
            <p class="detail">
                Library tracks tagged by hand before crateside have no verdict. Library's
                <em>Queue them for judging</em> hands them here, and they are judged one at a time:
                one track whenever the Claude window has sat at 0% for fifteen minutes, then nothing
                for five hours. Judging's own pause does not hold them back, and nothing else is
                judged this way. <em>Work this first</em> on one of them judges it straight away.
            </p>

            <div class="field">
                <label>
                    <input type="checkbox" checked="@Roll.IsEnabled" @onchange="ToggleBackfill" />
                    Judge the library backfill, one track per idle Claude window
                </label>
            </div>

            <ul class="counts">
                <li><span class="mono">@Backfill(row => row is { Verdict: null, GaveUpAt: null })</span> waiting</li>
                <li><span class="mono">@Backfill(row => row is { Verdict: not null })</span> judged</li>
                @if (Backfill(row => row is { Verdict: null, GaveUpAt: not null }) is > 0 and var stuck)
                {
                    <li class="attention">
                        <span class="mono">@stuck</span> gave up, so they cannot be judged from
                        their uploads; see each row
                    </li>
                }
                <li class="@(NotQueued > 0 ? "attention" : null)">
                    <span class="mono">@NotQueued</span> unjudged in the library and not queued
                </li>
            </ul>

            <p class="detail">@NextWindow</p>
        </section>

        @if (!Playlist.HasCredential)
        {
            <section>
                <h2>API key</h2>
                <p class="detail">
                    Reading the playlist needs one. Set it once from the repo root, then restart:
                </p>
                <pre><code>dotnet user-secrets set "Queue:ApiKey" "&lt;key&gt;" --project src\Crateside\Crateside.csproj</code></pre>
                <p class="detail">
                    A read-only key restricted to the YouTube Data API is enough. See
                    <code>docs/secrets.md</code>.
                </p>
            </section>
        }

        <section>
            <h2>Removing from the playlist</h2>

            @if (!Playlist.CanAuthorize)
            {
                <p class="detail">
                    Removing needs the user's consent, which an API key cannot give. Create a
                    <em>Desktop app</em> OAuth client, then:
                </p>
                <pre><code>dotnet user-secrets set "Queue:ClientId" "&lt;id&gt;" --project src\Crateside\Crateside.csproj
dotnet user-secrets set "Queue:ClientSecret" "&lt;secret&gt;" --project src\Crateside\Crateside.csproj</code></pre>
            }
            else if (!Playlist.IsAuthorized)
            {
                <p class="detail">
                    Opens a browser. The write token lapses about weekly, so expect to do this
                    again — reading never stops working in the meantime.
                </p>
                <button class="primary" @onclick="Consent" disabled="@_working">
                    @(_working ? "Waiting for consent…" : "Grant access to remove items")
                </button>
            }
            else
            {
                @* Deleting from a playlist owned by a different channel fails as a bare 403. *@
                <p class="detail">
                    Authorized as <strong>@(_channel ?? "…")</strong>. Removal only works if that
                    channel owns the playlist.
                </p>

                <p class="detail">
                    An entry is a message, not a record: once crateside has stored what it needs,
                    the entry has done its job.
                </p>

                <div class="field">
                    <label>
                        <input type="checkbox" checked="@_consume" @onchange="SaveConsume" />
                        Empty the playlist as crateside takes tracks on
                    </label>
                </div>

                <p class="detail">
                    Every entry crateside has recorded goes on the next scan, not only ones that
                    arrive after this is ticked. A playlist deletion cannot be undone from here.
                </p>

                <p class="detail">
                    Not free, unlike reading: a removal costs fifty quota units against a daily ten
                    thousand, so emptying a hundred entries spends half a day's worth. Each entry is
                    offered once and never retried, so a removal that fails stays failed rather than
                    coming back on the next scan.
                </p>

                @if (Playlist.LeftInPlaylist is { Count: > 0 } left)
                {
                    <p class="detail">
                        Removal failed for @("entry".ToQuantity(left.Count)), still in the playlist:
                    </p>

                    <ul class="left-behind">
                        @foreach (var record in left)
                        {
                            <li>
                                <strong>@record.Title</strong>
                                <span class="detail">@record.RemovalFailure!.Reason</span>
                                @if (record.RemovalFailure.CanSucceedLater)
                                {
                                    <button class="outline" @onclick="() => Playlist.RetryRemoval(record.VideoId)">
                                        Try again
                                    </button>
                                }
                            </li>
                        }
                    </ul>
                }

                @if (_processed is { } processed)
                {
                    <p class="detail">
                        @("track".ToQuantity(processed)) here @(processed is 1 ? "has" : "have") a
                        verdict and stems on disk. Removing them leaves their stems exactly where
                        they are — a track's files sit in Sample Staging long after it has left the
                        playlist.
                    </p>
                }

                <div class="actions">
                    @if (_confirming)
                    {
                        <button class="danger" @onclick="RemoveProcessed" disabled="@_working">
                            @(_working ? "Removing…" : "Yes, remove them")
                        </button>
                        <button class="outline" @onclick="() => _confirming = false" disabled="@_working">
                            Cancel
                        </button>
                        <span class="detail">Re-checked at the moment of removal, not from this page.</span>
                    }
                    else
                    {
                        <button class="outline" @onclick="() => _confirming = true"
                                disabled="@(_processed is null or 0)">
                            Remove processed tracks
                        </button>
                        <button class="outline" @onclick="SignOut">Forget access</button>
                    }
                </div>
            }

            @if (_error is { } error)
            {
                <p class="problem">@error</p>
            }

            @if (_removals is { Count: > 0 })
            {
                <p class="detail">
                    Removed @_removals.Count(result => result.Removed) of @_removals.Count.
                </p>

                @foreach (var failed in _removals.Where(result => !result.Removed))
                {
                    <p class="problem">@failed.Title — @failed.Reason</p>
                }
            }
        </section>
    </div>
</div>

@code {
    /// <summary>The intervals worth offering. Never, then coarser as it gets less urgent.</summary>
    private static readonly int[] RefreshChoices = [0, 1, 5, 15, 30, 60];

    private int _refresh;
    private bool _consume;
    private string _playlist = string.Empty;
    private string? _playlistProblem;

    private string? _channel;
    private int? _processed;
    private bool _confirming;
    private bool _working;
    private string? _error;
    private IReadOnlyList<RemovalResult>? _removals;

    private bool HasPendingChange =>
        PlaylistReference.TryParse(_playlist, out var parsed) && parsed != Playlist.PlaylistId;

    private IReadOnlyList<TrackRow> Rows => Tracks.Current?.Rows ?? [];

    private int NotQueued => Rows.Count(row => row is { IsLibraryOnly: true, Verdict: null, IsAddedByUrl: false });

    private string NextWindow =>
        (Roll.IsEnabled, Roll.RolledAt) switch
        {
            (false, _) => "Off, so the backfill waits.",
            (true, { } rolled) when DateTimeOffset.UtcNow - rolled < WindowRoll.Window =>
                $"Last judged one at {rolled.ToLocalTime():h:mm tt}; the next goes after {(rolled + WindowRoll.Window).ToLocalTime():h:mm tt}, once a window sits idle.",
            _ => "The next goes as soon as a window sits at 0% for fifteen minutes.",
        };

    private int Backfill(Func<TrackRow, bool> matches) =>
        Rows.Count(row => row.IsBackfill && matches(row));

    public void Dispose()
    {
        Tracks.Changed -= OnChanged;
        Roll.Changed -= OnChanged;
    }

    // Raised on a worker thread, never the circuit's, so the render is marshalled back.
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void ToggleBackfill(ChangeEventArgs e)
    {
        if (e.Value is true)
            Roll.Enable();
        else
            Roll.Disable();

        Remembered.RememberBackfill(Roll.IsEnabled);
    }

    protected override async Task OnInitializedAsync()
    {
        Tracks.Changed += OnChanged;
        Roll.Changed += OnChanged;

        await Tracks.EnsureFreshAsync(TimeSpan.FromSeconds(30));

        _playlist = Playlist.PlaylistId ?? string.Empty;
        _refresh = Playlist.RefreshMinutes;
        _consume = Playlist.ConsumeOnArrival;

        await Load();
    }

    // Takes effect on the next poll, not at the next restart.
    private void SaveRefresh() => Playlist.SetRefreshMinutes(_refresh);

    private void SaveConsume(ChangeEventArgs e)
    {
        _consume = e.Value is true;
        Playlist.SetConsumeOnArrival(_consume);
    }

    private static string RefreshLabel(int minutes) =>
        minutes switch
        {
            0 => "Never — only when I ask",
            1 => "Every minute",
            _ => $"Every {minutes} minutes",
        };

    private async Task Save()
    {
        _playlistProblem = PlaylistReference.Problem(_playlist);

        if (_playlistProblem is not null)
            return;

        Playlist.SetPlaylist(_playlist);
        _playlist = Playlist.PlaylistId ?? string.Empty;

        await Load();
    }

    private async Task Consent()
    {
        _working = true;
        _error = null;

        try
        {
            await Playlist.ConsentAsync();
        }
        catch (Exception e)
        {
            _error = $"Consent did not complete: {e.Message}";
        }
        finally
        {
            _working = false;
        }

        await Load();
    }

    private async Task SignOut()
    {
        await Playlist.SignOutAsync();

        _confirming = false;
        _channel = null;
    }

    private async Task RemoveProcessed()
    {
        _working = true;
        _error = null;

        try
        {
            _removals = await Playlist.RemoveProcessedAsync();
            _confirming = false;

            await Load();
        }
        catch (QueueUnavailableException e)
        {
            _error = e.Message;
        }
        finally
        {
            _working = false;
        }
    }

    /// <summary>
    /// Reads enough to preview what removal would do; the removal derives its set again.
    /// </summary>
    private async Task Load()
    {
        if (!Playlist.IsConfigured)
            return;

        try
        {
            _processed = (await Playlist.ReadAsync()).FullyProcessed.Count;

            if (Playlist.IsAuthorized)
                _channel = await Playlist.GetAuthorizedChannelAsync();
        }
        catch (QueueUnavailableException e)
        {
            _processed = null;
            _error = e.Message;
        }
    }
}
