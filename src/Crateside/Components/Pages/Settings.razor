    private int NotQueued => Rows.Count(row => row is { IsLibraryOnly: true, Verdict: null, IsAddedByUrl: false, HasUpload: true });

    private int _spendHours;
    private int _spendWeekly;
    private int _spendSession;

    private SpendDownSettings PendingSpendDown =>
        new()
        {
            WindowHours = _spendHours,
            WeeklyCeiling = _spendWeekly,
            SessionCeiling = _spendSession,
        };

    private string SpendDownNote =>
        Spend.State switch
        {
            SpendDownState.Off => "Off, so the backlog waits.",
            SpendDownState.Waiting(var opens, var resets) =>
                $"Opens {opens.ToLocalTime():ddd h:mm tt}, {"hour".ToQuantity(Spend.Settings.WindowHours)} before the weekly reset at {resets.ToLocalTime():ddd h:mm tt}.",
            SpendDownState.Open(var weekly, var resets) =>
                $"Open: weekly use at {weekly:N0}%, judging until {Spend.Settings.WeeklyCeiling}% or the reset at {resets.ToLocalTime():ddd h:mm tt}.",
            SpendDownState.Spent(var weekly, var resets) =>
                $"Weekly use at {weekly:N0}%, the ceiling reached; nothing more until the reset at {resets.ToLocalTime():ddd h:mm tt}.",
            SpendDownState.CutOff(var resumes) =>
                $"A track was cut off by the usage limit; Library backfill resumes when the 5-hour window rolls at {resumes.ToLocalTime():ddd h:mm tt}.",
            SpendDownState.SessionFull(var session, { } resets) =>
                $"The 5-hour window is at {session:N0}%; Library backfill waits for it to reset at {resets.ToLocalTime():h:mm tt}.",
            SpendDownState.SessionFull(var session, _) =>
                $"The 5-hour window is at {session:N0}%; Library backfill waits for it to reset.",
            SpendDownState.Unread => "On, but Claude use or the weekly reset could not be read, so nothing is judged.",
            _ => "On; the first check comes within five minutes of starting.",
        };

    private void SaveSpendDown()
    {
        Spend.Remember(PendingSpendDown);
        LoadSpendDown();
    }

    private void LoadSpendDown() =>
        (_spendHours, _spendWeekly, _spendSession) = (
            Spend.Settings.WindowHours,
            Spend.Settings.WeeklyCeiling,
            Spend.Settings.SessionCeiling
        );

