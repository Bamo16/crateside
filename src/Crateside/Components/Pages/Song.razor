@page "/song/{VideoId}"
@layout Crateside.Components.Layout.BareLayout
@rendermode InteractiveServer
@implements IDisposable
@using Crateside.Core
@using Crateside.Core.Ledger
@using Crateside.Core.Tracks
@inject EvidenceService Evidence
@inject TracksService Tracks
@inject IServiceProvider Services
@inject NavigationManager Navigation

<PageTitle>@(Name ?? "Track details") · crateside</PageTitle>

<PageHeader Active="BrandNav.Tab.Tracks" Shape="PageHeader.Shapes.Bar" />

<div class="body">
    <a class="back" href="">← Tracks</a>

    @if (_row is null && _run is null)
    {
        <h1>Track details</h1>
        <p class="notice">
            @(Tracks.Current is null ? "Reading tracks…" : $"crateside has no track for {VideoId}.")
        </p>
    }
    else
    {
        <h1>@Name</h1>
        <p class="meta">@Meta</p>

        @if (_row is not null)
        {
            <TrackFindings Row="_row" />
        }

        <section class="band @(_row?.IsLibraryOnly is true ? "library-only" : null)">
            <div class="cell">
                <span class="label">@(_row?.IsLibraryOnly is true ? "Key · tagged in Ableton" : "Key")</span>
                <span class="mono value key @(Key is null ? "empty" : null)">@(KeyText.Spell(Key) ?? "—")</span>
                <span class="sub">@KeyNote</span>
            </div>
            <div class="cell">
                <span class="label">Confidence</span>
                <span class="mono value conf @KeyText.ConfidenceTone(Confidence)">@KeyText.Confidence(Confidence)</span>
                <span class="sub">@(Verdict is { } judged ? $"judged {judged.Timestamp.ToLocalTime():yyyy-MM-dd}" : "never judged")</span>
            </div>
            <div class="cell">
                <span class="label">BPM</span>
                <span class="mono value bpm @(_row?.State is TrackState.ReadyToWarp ? "ready" : null) @(Bpm is null ? "empty" : null)">
                    @(Bpm is { } bpm ? bpm.ToString("N0") : "—")
                </span>
                <span class="sub @(_run?.BpmConflicts is true ? "conflict" : null)">@BpmNote</span>
            </div>
            <div class="cell where">
                <span class="label">Where it is</span>
                @if (_row is not null)
                {
                    <StateChip Row="_row" />
                    <span class="next">@_row.Next</span>
                }
                @if (HasEvidenceSection)
                {
                    <a class="why" href="@($"song/{VideoId}#evidence")">Why @Verdicted ↓</a>
                }
            </div>
        </section>

        <div class="columns">
            <div class="main">
                @if (_row is not null)
                {
                    <section class="samples">
                        <StemList Editor="_stems" Row="_row" />
                    </section>
                }

                @if (HasEvidenceSection)
                {
                    <section id="evidence" class="evidence-section">
                        <h2>Why @Verdicted</h2>
                        @if (_run is null)
                        {
                            <p class="summary">
                                Judged @Verdict?.Timestamp.ToLocalTime().ToString("yyyy-MM-dd"), before crateside
                                kept evidence. The verdict stands; its reasons were not saved.
                            </p>
                        }
                        else
                        {
                            <p class="summary">@Summary(_run)</p>
                            <Evidence Run="_run" />
                        }
                    </section>
                }
            </div>

            <aside class="rail">
                @if (_row is not null && _stems.IsConfirming(_row))
                {
                    <StemConfirm Editor="_stems" Row="_row" />
                }
                @if (_stems.Problem is { } problem)
                {
                    <p class="problem">@problem</p>
                }

                @if (_row is not null)
                {
                    var uploads = Uploads(_row);

                    <section class="rail-section">
                        <h3>Change</h3>
                        <TrackActions Row="_row" Editor="_stems" ShowDetailsLink="false" Removed="OnRemoved" />
                        <TrackEdits Row="_row" />
                    </section>

                    <section class="rail-section">
                        <h3>@(uploads.Count is 1 ? "Upload" : "Uploads")</h3>
                        @foreach (var (id, role) in uploads)
                        {
                            <UploadCard @key="id" VideoId="@id" Role="@role" />
                        }
                    </section>

                    <section class="rail-section">
                        <h3>Genre</h3>
                        <GenreStrip Row="_row" />
                    </section>
                }
            </aside>
        </div>
    }
</div>

@code {
    [Parameter]
    public required string VideoId { get; set; }

    private TrackRow? _row;
    private RunEvidence? _run;
    private StemEditor _stems = null!;

    private LedgerRun? Verdict => _row?.Verdict;

    private string? Name => _row?.Title ?? _run?.DisplayName;

    private string? Key => _row is null ? _run?.Key : _row.Key ?? LibraryKey;

    private string Verdicted => KeyText.Spell(Key) ?? "this verdict";

    private bool HasEvidenceSection => Verdict is not null || _run is not null;

    private KeyConfidence Confidence => _row?.Confidence ?? KeyConfidence.Unknown;

    private double? Bpm => _row?.Bpm ?? _run?.Bpm;

    /// <summary>A library-only track has no verdict, so its key is whatever Ableton was told.</summary>
    private string? LibraryKey =>
        _row is { IsLibraryOnly: true } row
            ? row.Samples.Select(sample => sample.AbletonKey).OfType<string>().FirstOrDefault()
            : null;

    private string Meta =>
        string.Join(
            " · ",
            new[]
            {
                _row?.Genre?.Written ?? _row?.Genre?.Suggested,
                _row is null ? null : "upload".ToQuantity(Uploads(_row).Count),
            }.OfType<string>()
        );

    private string KeyNote =>
        _row switch
        {
            { Verdict: { IsCollapsed: true, ModalKey: { } modal } } =>
                $"really {modal}, tagged as {KeyText.Spell(Key)}",
            { Samples.Count: 0 } => "no samples yet",
            { Samples: var samples } =>
                $"tagged in Ableton on {samples.Count(IsTaggedWithKey)} of {"sample".ToQuantity(samples.Count)}",
            null => string.Empty,
        };

    private string BpmNote =>
        _run switch
        {
            { BpmConflicts: true, BeatdetectBpm: { } rough } => $"beatdetect {rough:F1} · conflict",
            { BeatdetectBpm: { } rough, Bpm: { } bpm } when Math.Abs(rough - bpm) < 1.5 =>
                "beatdetect agrees",
            { BeatdetectBpm: { } rough } => $"beatdetect {rough:F1} · half or double",
            _ => Bpm is null ? "not measured" : "no cross-check",
        };

    protected override async Task OnInitializedAsync()
    {
        _stems = ActivatorUtilities.CreateInstance<StemEditor>(Services);
        _stems.Changed += OnStemsChanged;
        Tracks.Changed += OnChanged;

        await Tracks.EnsureFreshAsync(TimeSpan.FromSeconds(30));
        Read();
        await _stems.LoadAsync();
    }

    protected override void OnParametersSet() => Read();

    public void Dispose()
    {
        Tracks.Changed -= OnChanged;
        _stems.Changed -= OnStemsChanged;
        _stems.Dispose();
    }

    private void OnStemsChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnRemoved((string Title, string Note) removed) => Navigation.NavigateTo(string.Empty);

    private bool IsTaggedWithKey(TrackSample sample) =>
        Key is { } key && key.Equals(sample.AbletonKey, StringComparison.OrdinalIgnoreCase);

    private void Read()
    {
        _row = Tracks.Current?.Rows.FirstOrDefault(row =>
            row.VideoId.Equals(VideoId, StringComparison.Ordinal)
        );
        _run = Verdict is { Song: var song } ? Evidence.ForSong(song) : Evidence.ForVideoId(VideoId);
    }

    // Raised on a worker thread, never the circuit's, so the render is marshalled back.
    private void OnChanged() =>
        _ = InvokeAsync(() =>
        {
            Read();
            StateHasChanged();
        });

    /// <summary>Every upload this track has used, the one it is cut from first, with its role.</summary>
    private static List<(string VideoId, string Role)> Uploads(TrackRow row)
    {
        var cutFrom =
            row.StatedSourceUrl is { } stated && YouTubeUrl.TryGetVideoId(stated, out var swapped)
                ? swapped
                : row.VideoId;

        return
        [
            .. row
                .Facts.Uploads.Prepend(cutFrom)
                .Distinct(StringComparer.Ordinal)
                .Select(id => (id, Role(row, id, cutFrom))),
        ];
    }

    private static string Role(TrackRow row, string videoId, string cutFrom) =>
        row.Plan.AddedSources.FirstOrDefault(source => source.VideoId == videoId) switch
        {
            { } added => $"added source · {added.Label}",
            null when videoId == cutFrom => "cut from",
            null when videoId == row.VideoId => "the playlist's upload",
            _ => "old upload",
        };

    private static string Summary(RunEvidence run) =>
        run.Sources.Count is 0
            ? $"No human sources; {"detector".ToQuantity(run.Algorithms.Count)} and the chord check."
            : $"{run.Sources.Count(source => source.Stance is SourceStance.Agrees)} of {"source".ToQuantity(run.Sources.Count)} agree, with {"detector".ToQuantity(run.Algorithms.Count)} alongside.";
}
