@page "/song/{TrackKey}"
@layout Crateside.Components.Layout.BareLayout
@rendermode InteractiveServer
@implements IDisposable
@using Crateside.Core
@using Crateside.Core.Ledger
@using Crateside.Core.Orchestration.Verdict
@using Crateside.Core.Tempo
@using Crateside.Core.Tracks
@using Microsoft.Extensions.Options
@inject TrackDetailsReader Details
@inject TracksService Tracks
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject BarJudging Judging
@inject PersonsKey Person
@inject IOptions<JudgeOptions> Judge
@inject VerdictControl Verdicts

<PageTitle>@(Name ?? "Track details") · crateside</PageTitle>

<PageHeader Active="BrandNav.Tab.Tracks" Shape="PageHeader.Shapes.Bar" />

<div class="body">
    <a class="back" href="tracks">← Tracks</a>

    @if (_row is null && _run is null)
    {
        <h1>Track details</h1>
        <p class="notice">
            @(Tracks.Current is null ? "Reading tracks…" : $"crateside has no track for {TrackKey}.")
        </p>
    }
    else
    {
        <header class="hs">
            <div class="hs-cover"><Cover TrackKey="@TrackKey" Side="320" /></div>
            <div class="hs-title">
                <h1>@Name</h1>
                <p class="meta">@Meta@if (YouTubeId is { } watch)
                {<text>@(Meta.Length > 0 ? " · " : null)<a href="@($"https://www.youtube.com/watch?v={watch}")" target="_blank" rel="noopener noreferrer">YouTube ↗</a></text>}</p>
            </div>

            <div class="cells @(HasFoot ? "has-foot" : null) @(_row?.IsLibraryOnly is true ? "library-only" : null)">
                <div class="cell">
                    <div class="cell-head">
                        <span class="label">@(_row?.IsLibraryOnly is true ? "Key · tagged in Ableton" : "Key")</span>
                        <div class="line">
                            @if (Center is { } center && ModeText.Lead(center, Mixed) is { } lead)
                            {
                                <span class="mono lead">@lead <span class="arrow">→</span></span>
                            }
                            <span class="mono value key @(Key is null ? "empty" : null)">@(KeyText.Spell(Key) ?? "—")</span>
                        </div>
                        <span class="note">
                            @if (Center is { } reasoned && ModeText.Reason(reasoned, Mixed) is { } reason)
                            {
                                <text>@reason&#32;</text>
                            }
                            <ProseText Text="@KeyNote" Inline="true" />
                        </span>
                    </div>
                    <div class="cell-foot">
                        @if (OtherSections is { Count: > 0 } others)
                        {
                            <ul class="sections">
                                @foreach (var part in others)
                                {
                                    <li>
                                        <a class="section-pick" href="@($"song/{Uri.EscapeDataString(TrackKey)}#evidence")" title="What was found for this section" @onclick="() => _section = part.Label">
                                            <span class="section-label"><ProseText Text="@part.Label" Inline="true" /></span>
                                            <span class="mono section-key">@(ModeText.Arrow(part.Center, false) ?? ModeText.Tag(part.Center))</span>
                                        </a>
                                        @if (part.IsHypothesis)
                                        {
                                            <span class="note hypothesis">possible key change (the judge's reading, unconfirmed)@(part.Start is { } from ? $" · from {TempoFormat.Clock(from)}" : null)</span>
                                            @if (StretchOf(part) is { } proposed && Judging.Of(TrackKey) is not { IsRunning: true })
                                            {
                                                <a class="outline invite" href="@WarpViewLink" @onclick="() => Suggest(proposed)">Judge these bars ↓</a>
                                            }
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                <div class="cell">
                    <div class="cell-head">
                        <span class="label">Confidence</span>
                        <div class="line">
                            <span class="mono value conf @KeyText.ConfidenceTone(Confidence) @(Verdict?.DecidedBy is DecidedBy.Person ? "call" : null)">@KeyText.Headline(Verdict?.DecidedBy, Confidence)</span>
                        </div>
                        <span class="note">@ConfidenceNote</span>
                    </div>
                    <div class="cell-foot">
                        @if (Judging.Of(TrackKey) is { IsRunning: true } running)
                        {
                            <span class="judging-chip"><span class="dot"></span>judging from bars</span>
                            <span class="note">
                                @JudgeText.Spans(running.Direction.Windows) · @JudgeText.Brief(running) · started @running.StartedAt.ToLocalTime().ToString("h:mm tt")
                            </span>
                        }
                        else if (Invitation is { } invitation)
                        {
                            <span class="invitation">@invitation</span>
                            <a class="outline invite" href="@WarpViewLink" @onclick="() => _openRequests++">Judge from these bars ↓</a>
                        }
                    </div>
                </div>

                <div class="cell">
                    <div class="cell-head">
                        <span class="label">BPM</span>
                        <div class="line">
                            <span class="mono value bpm @(_row?.State is TrackState.ReadyToWarp ? "ready" : null) @(Bpm is null ? "empty" : null) @(Bpm?.IsApproximate is true ? "approx" : null) @(Bpm?.IsEstimate is true ? "estimate" : null)">@(Bpm?.Text ?? "—")@if (Bpm is { Mark: not OffMark.None })
                            {<OffMarkGlyph Mark="Bpm.Mark" Large="true" />}</span>
                        </div>
                        <span class="note">@(Bpm?.Note ?? "not measured")</span>
                    </div>
                    <div class="cell-foot">
                        @if (Bpm?.Explanation is { } explanation)
                        {
                            <span class="explain">@explanation@if (Bpm.Mark is not OffMark.None)
                            {<text> </text><a href="@WarpViewLink">True up in Warp ↓</a>}</span>
                        }
                        @if (Tempo is { Drifts: true } drifting)
                        {
                            <TempoStrip Tempo="drifting" />
                        }
                    </div>
                </div>

                <div class="cell where">
                    <div class="cell-head">
                        <span class="label">Where it is</span>
                        <div class="line where-line">
                            @if (_row is not null)
                            {
                                <StateChip Row="_row" />
                            }
                        </div>
                        <span class="note where-note">
                            @if (_row is not null)
                            {
                                <span class="next">@_row.Next</span>
                            }
                            @if (HasEvidenceSection)
                            {
                                <a class="why" href="@($"song/{Uri.EscapeDataString(TrackKey)}#evidence")">Why @Verdicted ↓</a>
                            }
                        </span>
                    </div>
                    <div class="cell-foot">
                        @if (_row?.RunningSince is { } since)
                        {
                            <span class="mono elapsed">
                                @Clock.Elapsed(since)@(Expected is { } expected ? $" of about {expected.Humanize()}" : null)
                            </span>
                            @if (Expected is { } estimate)
                            {
                                <span class="progress"><span style="width: @Percent(since, estimate)%"></span></span>
                            }
                        }
                    </div>
                </div>
            </div>
        </header>

        @if (_row is not null)
        {
            <Player Row="_row" Editor="_stems" />
            <TrackFindings Row="_row" />
        }

        @if (HasFlow)
        {
            <StageFlowStrip Row="_row!" />
        }

        <div class="columns">
            <div class="main">
                @if (_row is not null)
                {
                    <section class="samples">
                        <StemList Editor="_stems" Row="_row" OnSelect="path => _selectedWarp = path" />
                    </section>

                    <WarpView Row="_row" @bind-SelectedPath="_selectedWarp" Run="_run" OpenRequests="_openRequests" Suggested="_suggested" @bind-SelectedSection="_section" />
                }

                @if (_row is not null)
                {
                    <KeyPicker Row="_row" Run="_run ?? _pending" />
                }

                @if (HasEvidenceSection)
                {
                    <section id="evidence" class="evidence-section">
                        @if (_run is null && _pending is { } pending)
                        {
                            <Evidence Run="pending" Row="_row" Heading="What was found" Summary="Nothing is decided yet: the detectors' readings and the pages the lookup found."
                                      Withheld="true" Pending="true" />
                        }
                        else if (_run is null)
                        {
                            <h2>Why @Verdicted</h2>
                            <p class="summary">
                                Judged @Verdict?.Timestamp.ToLocalTime().ToString("yyyy-MM-dd"), before crateside
                                kept evidence. The verdict stands; its reasons were not saved.
                            </p>
                        }
                        else
                        {
                            <Evidence Run="_run" Row="_row" Tempo="Tempo" Heading="@($"Why {HeadingKey}")" Summary="@RunSummary.Of(_run)" Subject="ShareOf(_run)"
                                      Withheld="Confidence is KeyConfidence.Withheld"
                                      WarpViewLink="@(_row is null ? null : WarpViewLink)" @bind-SelectedSection="_section" />
                        }
                    </section>
                }

                @if (_row is not null)
                {
                    <ActivityLog Row="_row" Header="CopyHeader(_row)" />
                }
            </div>

            <aside class="rail">
                @if (_row is not null)
                {
                    <SideStack Row="_row" Editor="_stems" OnTrackDetails="true" Uploads="_row.Uploads"
                               Removed="OnRemoved" />
                }
            </aside>
        </div>
    }
</div>

@code {
    private string WarpViewLink => $"{new Uri(Navigation.Uri).GetLeftPart(UriPartial.Query)}#warp-view";

    [Parameter]
    public required string TrackKey { get; set; }

    private TrackRow? _row;
    private RunEvidence? _run;
    private RunEvidence? _pending;
    private StemEditor _stems = null!;
    private Timer? _clock;
    private string? _selectedWarp;
    private int _openRequests;
    private RunWindow? _suggested;
    private string? _section;

    private LedgerRun? Verdict => _row?.Verdict;

    private ShareSubject? ShareOf(RunEvidence run) =>
        Name is { } name
            ? new(name, YouTubeId, HeadingKey, KeyText.Headline(Verdict?.DecidedBy, Confidence), Bpm?.Text)
            : null;

    private string? Name => _row?.Title ?? _run?.DisplayName;

    private string? Key => _row is null ? _run?.Key : _row.Key ?? LibraryKey;

    private string Verdicted =>
        _pending is not null ? "no ruling"
        : Center is { IsModal: true } modal ? ModeText.Named(modal) : KeyText.Spell(Key) ?? "this verdict";

    /// <summary>The head of Why: the key in full, since the band keeps the short form beside it.</summary>
    private string HeadingKey =>
        Confidence is KeyConfidence.Withheld ? "no key"
        : Center is { } center ? ModeText.Named(center)
        : Key?.Replace("#", "♯", StringComparison.Ordinal) ?? "this verdict";

    /// <summary>The verdict's tonal center, where it is the one tagged.</summary>
    private TonalCenter? Center =>
        _row is null ? _run?.Center : _row.Key is not null ? Verdict?.Center : null;

    private bool Mixed => _row is null ? _run?.Mixed is true : Verdict?.Mixed is true;

    private IReadOnlyList<Section> Sections => _row is null ? _run?.Sections ?? [] : Verdict?.Sections ?? [];

    /// <summary>The stretch the judge proposed for a section: from its start to the next section's, or to the end.</summary>
    private RunWindow? StretchOf(Section part) =>
        part.Start is { } start
            ? new RunWindow(
                start,
                Sections.Where(other => other.Start > start).Select(other => other.Start).Min()
                    ?? double.MaxValue,
                part.Label,
                WindowAsker.User
            )
            : null;

    private void Suggest(RunWindow stretch)
    {
        _suggested = stretch;
        _openRequests++;
    }

    private IReadOnlyList<Section> OtherSections =>
        [.. Sections.Where(section => section.Center != Center)];

    /// <summary>A library-only track never ran through crateside, so it has no stages to draw.</summary>
    private bool HasFlow => _row is { IsLibraryOnly: false };

    private bool HasEvidenceSection => Verdict is not null || _run is not null || _pending is not null;

    private KeyConfidence Confidence => _row?.Confidence ?? KeyConfidence.Unknown;

    /// <summary>When it was judged, and from which of the user's bars where it was judged from some.</summary>
    private string ConfidenceNote =>
        (Verdict, _run?.Windows.Where(window => window.AskedBy is WindowAsker.User).ToList()) switch
        {
            ({ } judged, [_, ..] yours) when _run!.Timestamp == judged.Timestamp =>
                $"judged from {JudgeText.Spans(yours)} · {Clock.Ago(judged.Timestamp)}",
            ({ DecidedBy: DecidedBy.Judge } judged, _) =>
                $"judged {judged.Timestamp.ToLocalTime():yyyy-MM-dd}",
            ({ } decided, _) =>
                $"{KeyText.Byline(decided.DecidedBy)} · {decided.Timestamp.ToLocalTime():yyyy-MM-dd}",
            _ when _row?.WaitingForPerson is true => "waiting for you",
            _ when _row is { WaitingForJudge: true, Refusal: { } refusal } row =>
                refusal.Says(row.Judge),
            _ when _row is { WaitingForJudge: true, Judge: JudgeStanding.Paused } =>
                "waiting for the judge or you",
            _ when _pending is not null => "no ruling yet",
            _ => "never judged",
        };

    /// <summary>Why to judge it from bars, where the verdict is withheld or the detectors split and the warp view is there to do it in.</summary>
    private string? Invitation =>
        _row is { HasUpload: true, Samples.Count: > 0 } && Judge.Value.IsConfigured
            ? JudgeText.Invitation(Confidence, _run)
            : null;

    private TrackTempo? Tempo => _row is null ? TrackTempo.Of(null, null, _run?.Bpm) : _row.Bpm;

    private FormattedTempo? Bpm => Tempo is { } tempo ? TempoFormat.Format(tempo) : null;

    /// <summary>How long the running stage should take, where there is an estimate: only separation has one.</summary>
    private TimeSpan? Expected =>
        _row is { State: TrackState.Separating, Recipe.Passes: > 0 } row ? row.Recipe.Estimate : null;

    /// <summary>A library-only track has no verdict, so its key is whatever Ableton was told.</summary>
    private string? LibraryKey =>
        _row is { IsLibraryOnly: true } row
            ? row.Samples.Select(sample => sample.AbletonKey).OfType<string>().FirstOrDefault()
            : null;

    private string Meta
    {
        get
        {
            string?[] parts =
            [
                _row?.Genre is { Genres: [_, ..] genres } ? string.Join(", ", genres) : null,
                .. _row?.Release?.Describe() ?? [],
                _row is { Uploads.Count: > 1 } ? "upload".ToQuantity(_row.Uploads.Count) : null,
                _row is { HasUpload: true } && !IsOnYouTube ? "imported file" : null,
            ];

            return string.Join(" · ", parts.OfType<string>());
        }
    }

    private string CutFrom => _row?.Uploads is [{ } first, ..] ? first.TrackKey : TrackKey;

    private bool IsOnYouTube => _row is { HasUpload: true } && TrackKeys.IsVideoId(CutFrom);

    /// <summary>The upload the files are cut from, for the header's link; none for an imported file.</summary>
    private string? YouTubeId => IsOnYouTube ? CutFrom : null;

    /// <summary>Whether a cell has more than a note to say, which grows the strip a second row.</summary>
    private bool HasFoot =>
        OtherSections.Count > 0
        || Judging.Of(TrackKey) is { IsRunning: true }
        || Invitation is not null
        || Bpm?.Explanation is not null
        || Tempo is { Drifts: true }
        || _row?.RunningSince is not null;

    private string KeyNote =>
        _row switch
        {
            _ when Sections.FirstOrDefault(section => section.Center == Center) is { } primary =>
                $"the {primary.Label}, and the tag follows it",
            { Samples.Count: 0 } => "no samples yet",
            { Samples: var samples } =>
                $"tagged in Ableton on {samples.Count(IsTaggedWithKey)} of {"sample".ToQuantity(samples.Count)}",
            null => string.Empty,
        };

    protected override async Task OnInitializedAsync()
    {
        _stems = ActivatorUtilities.CreateInstance<StemEditor>(Services);
        _stems.Changed += OnStemsChanged;
        Tracks.Changed += OnChanged;
        Judging.Changed += OnChanged;
        Verdicts.Changed += OnChanged;

        await Tracks.EnsureFreshAsync(TimeSpan.FromSeconds(30));
        Read();
        await _stems.LoadAsync();

        _clock = new Timer(_ => OnTick(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    protected override void OnParametersSet() => Read();

    public void Dispose()
    {
        Tracks.Changed -= OnChanged;
        Judging.Changed -= OnChanged;
        Verdicts.Changed -= OnChanged;
        _stems.Changed -= OnStemsChanged;
        _stems.Dispose();
        _clock?.Dispose();
    }

    // Only a running stage has a clock to move.
    private void OnTick()
    {
        if (_row?.RunningSince is not null)
            _ = InvokeAsync(StateHasChanged);
    }

    private static int Percent(DateTimeOffset since, TimeSpan expected) =>
        (int)Math.Clamp((DateTimeOffset.UtcNow - since) / expected * 100, 0, 100);

    private void OnStemsChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnRemoved((string Title, string Note) removed) => Navigation.NavigateTo(string.Empty);

    private bool IsTaggedWithKey(TrackSample sample) =>
        Key is { } key && key.Equals(sample.AbletonKey, StringComparison.OrdinalIgnoreCase);

    private void Read()
    {
        (_row, _run) = Details.Find(TrackKey);

        // Pausing judging does not rebuild the rows, so the standing is read live.
        _row = _row is null ? null : _row with { Judge = Judge.Value.Standing(Verdicts.IsPaused) };
        _pending = _run is null && _row is { Verdict: null, HasUpload: true }
            ? Person.PendingFor(BarJudging.OrderFor(_row))
            : null;
    }

    // Raised on a worker thread, never the circuit's, so the render is marshalled back.
    private void OnChanged() =>
        _ = InvokeAsync(() =>
        {
            Read();
            StateHasChanged();
        });

    private IReadOnlyList<string> CopyHeader(TrackRow row) =>
        [
            row.Title,
            row.HasUpload ? $"video {row.TrackKey}" : "no source recorded",
            $"state {row.ChipLabel}",
            $"verdict {KeyText.Spell(Key) ?? "—"} · {KeyText.Confidence(Confidence)}",
        ];
}
