@page "/"
@page "/tracks"
@layout Crateside.Components.Layout.BareLayout
@rendermode InteractiveServer
@implements IDisposable

@using System.Diagnostics
@using Crateside.Core.Ledger
@using Crateside.Core.Orchestration
@using Crateside.Core.Queue
@using Crateside.Core.Quota
@using Crateside.Core.Staging
@using Crateside.Core.Tracks
@using Humanizer

@inject TracksService Source
@inject QueueService Playlist
@inject JobStore Jobs
@inject StemRecut Recut
@inject TrackRename Rename
@inject DrainControl Separation
@inject VerdictControl Judging
@inject QuotaReader Quota

<PageTitle>Tracks</PageTitle>

<div class="tracks">
    <header class="frozen">
        <BrandNav Active="BrandNav.Tab.Tracks" />

        <div class="cell activity">
            <div class="label-row">
                <span class="label">Separation</span>
                <span class="mono waiting">@Waiting(TrackState.JudgedInLine) waiting</span>
            </div>
            @{
                var separating = RowIn(TrackState.Separating);
            }
            <div class="activity-line">
                <span class="dot @(Separation.IsPaused ? "amber" : separating is null ? "idle" : "teal")"></span>
                <span class="subject">@(separating?.Title ?? (Separation.IsPaused ? "paused" : "idle"))</span>
                @if (separating?.RunningSince is { } since)
                {
                    <span class="mono elapsed">@Elapsed(since) elapsed</span>
                }
                <button class="outline" @onclick="ToggleSeparation">
                    @(Separation.IsPaused ? "Resume" : "Pause")
                </button>
            </div>
            <div class="bar">
                @if (separating is not null)
                {
                    <div class="sweep"></div>
                }
            </div>
        </div>

        <div class="cell activity">
            <div class="label-row">
                <span class="label">Judging</span>
                <span class="mono waiting">@Waiting(TrackState.Queued) waiting</span>
            </div>
            @{
                var judging = RowIn(TrackState.Judging);
            }
            <div class="activity-line">
                <span class="dot @(Judging.IsPaused ? "amber" : judging is null ? "idle" : "teal")"></span>
                <span class="subject">@(judging?.Title ?? (Judging.IsPaused ? "paused" : "idle"))</span>
                @if (judging?.RunningSince is { } judgingSince)
                {
                    <span class="mono elapsed">@Elapsed(judgingSince) elapsed</span>
                }
                <button class="outline" @onclick="ToggleJudging">
                    @(Judging.IsPaused ? "Resume" : "Pause")
                </button>
            </div>
            <div class="bar">
                @if (judging is not null)
                {
                    <div class="sweep"></div>
                }
            </div>
        </div>

        <div class="cell quota">
            <div class="label-row">
                <span class="label">Claude quota</span>
                @if (_quota.ResetsAt is { } resets)
                {
                    <span class="mono waiting">resets @resets.ToLocalTime().ToString("h:mm tt").ToLowerInvariant()</span>
                }
            </div>
            <div class="quota-figure">
                <span class="mono percent">@(_quota.Utilization is { } used ? $"{used:N0}%" : "—")</span>
                <span class="of">of this 5-hour window</span>
            </div>
            <div class="bar">
                <div class="fill" style="width: @($"{Math.Clamp(_quota.Utilization ?? 0, 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture)}%")"></div>
            </div>
        </div>
    </header>

    <div class="filters">
        @foreach (var filter in Enum.GetValues<TrackFilter>())
        {
            <button class="pill @(filter == _filter ? "on " + Tone(filter) : "off")"
                    @onclick="() => _filter = filter">
                @Name(filter)
                <span class="mono count @Tone(filter)">@Rows.Count(filter)</span>
            </button>
        }
        @* The playlist read is cached for two minutes, so a track added on your phone shows up
           within about that -- but nothing on this page redraws in the meantime, and there was no
           way to say "go and look now". A list read costs one quota unit, the same as any cheaper
           probe would, so this is simply that read. *@
        <button class="status" @onclick="Resync" disabled="@_syncing">
            @(_syncing ? "checking the playlist…" : Synced)
        </button>
    </div>

    <div class="heads @(_filter is TrackFilter.InStaging ? "roomy" : null)">
        <span></span>
        <span>Song</span>
        <span>Key</span>
        <span>Confidence</span>
        <span class="right">BPM</span>
        <span>State</span>
        @if (_filter is TrackFilter.InStaging)
        {
            <span>Since</span>
        }
    </div>

    @if (_view is null)
    {
        <p class="notice">Reading the queue…</p>
    }
    else if (Source.LastError is { } error)
    {
        <p class="notice error">The playlist could not be read: @error</p>
    }
    else if (!Shown.Any())
    {
        <p class="notice">Nothing in this view.</p>
    }
    else
    {
        @foreach (var row in Shown)
        {
            var open = _expanded == row.VideoId;

            <div id="@Anchor(row)"
                 class="row @(_filter is TrackFilter.InStaging ? "roomy" : null) @(open ? "open" : null)"
                 @onclick="() => Expand(row)">
                <span class="chevron mono">@(open ? "⌄" : "›")</span>

                <span class="song">
                    @row.Title
                    @if (row.AuditNote is { } note)
                    {
                        <span class="flag">@note</span>
                    }
                    @* A count rather than "rename failed": these are files not carrying the stated
                       name, which is what was measured. Why they are not is not known from here. *@
                    @if (row.AwaitingRename > 0)
                    {
                        <span class="flag">@("file".ToQuantity(row.AwaitingRename)) not renamed</span>
                    }
                    else if (row.IsRenamed)
                    {
                        <span class="flag neutral">renamed</span>
                    }
                </span>

                <span class="mono key @(row.Key is null ? "none" : null)">@(Spell(row.Key) ?? "—")</span>

                <span class="mono conf @ConfidenceTone(row.Confidence)">@Confidence(row.Confidence)</span>

                <span class="mono bpm right @(row.State is TrackState.ReadyToWarp ? "ready" : null) @(row.Bpm is null ? "none" : null)">
                    @(row.Bpm is { } bpm ? bpm.ToString("N0") : "—")
                </span>

                <span>
                    <span class="chip @ChipClass(row.ChipStyle)">
                        @if (row.ChipHasDot)
                        {
                            <span class="chip-dot"></span>
                        }
                        @row.ChipLabel
                    </span>
                </span>

                @* The chip already says what state the track is in, so a sentence repeating it in
                   the next column was a column of noise. It moved into the expanded panel, where
                   the few states that genuinely add something -- the GPU queue position, what to
                   do about a track that gave up -- are read on purpose rather than skimmed. *@
                @if (_filter is TrackFilter.InStaging)
                {
                    <span class="since">
                        @(row.StagedSince is { } staged ? $"staged {staged.Humanize()}" : "—")
                    </span>
                }
            </div>

            @if (open)
            {
                <div class="panel">
                    @* Spans both columns and sits above everything, because the name is the one
                       thing every state of a track has and the only one the user supplies. *@
                    <div class="name-strip @(_renaming == row.VideoId ? "editing" : null)">
                        @if (_renaming == row.VideoId)
                        {
                            <div class="name-edit">
                                <input class="name-input" value="@_name"
                                       @oninput="e => _name = e.Value?.ToString() ?? string.Empty"
                                       @onkeydown="e => OnRenameKey(e, row)" />
                                <p class="name-note">
                                    Derived <strong>@Derived(row)</strong> · from @From(row.NameSource).
                                    Your name wins over the ledger, the staging board and the playlist.
                                </p>
                            </div>

                            <div class="name-side">
                                <p class="detail">@row.RenameDetail</p>

                                <div class="actions">
                                    <button class="primary" disabled="@(_working || !StemFileName.IsUsable(_name))"
                                            @onclick="() => ConfirmRename(row)">
                                        Rename · @row.RenameScope
                                    </button>
                                    <button class="outline" @onclick="CancelRename" disabled="@_working">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            @* The row above already says the name, so saying it again here was a
                               line of nothing. What it cannot say is where the name came from, or
                               that the files are under a different one — which is the question
                               the button beside it answers. *@
                            <span class="name-from">
                                @if (row.DerivedTitle is { } derived)
                                {
                                    <text>renamed by you · was <strong>@derived</strong></text>
                                }
                                else
                                {
                                    <text>named from @From(row.NameSource)</text>
                                }
                                @if (row.NameOnDisk is { } onDisk)
                                {
                                    <text> · files say <strong>@onDisk</strong></text>
                                }
                            </span>

                            @if (row.CanRename)
                            {
                                <button class="outline" @onclick="() => StartRename(row)" disabled="@_working">
                                    Rename
                                </button>
                                @if (row.IsRenamed)
                                {
                                    <button class="outline" @onclick="() => RevertRename(row)" disabled="@_working">
                                        Revert
                                    </button>
                                }
                            }
                            else
                            {
                                @* crateside writes nothing in Mashup Samples, tag store included,
                                   so the only honest offer is none. *@
                                <span class="name-from">· rename it in Ableton</span>
                            }
                        }
                    </div>

                    @if (row.CanChangePlan)
                    {
                        @* The plan rather than the files, because there are no files yet: what a
                           track before separation can say is what it is going to become. *@
                        <div class="stems">
                            <div class="panel-head">Will separate into</div>

                            <div class="stem-heads">
                                <span>Stem</span>
                                <span>Status</span>
                                <span></span>
                                <span></span>
                            </div>

                            @foreach (var preset in SeparationRecipe.Standard.Presets)
                            {
                                var kept = row.Recipe.Presets.Contains(preset, StringComparer.Ordinal);

                                <div class="stem @(kept ? null : "skipped")">
                                    <span class="stem-label mono">@preset</span>
                                    <span class="mono stem-tag">@(kept ? "not yet" : "skipped")</span>
                                    <span></span>
                                    <span class="stem-note">
                                        @(kept ? null : "instrumental source — no vocal to lift")
                                    </span>
                                </div>
                            }

                            @if (row.Recipe.KeepSource)
                            {
                                <div class="stem">
                                    <span class="stem-label mono">source</span>
                                    <span class="mono stem-tag">not yet</span>
                                    <span></span>
                                    <span class="stem-note">the release itself, kept whole</span>
                                </div>
                            }

                            @if (row.Recipe.ExtractDrums)
                            {
                                <div class="stem guide">
                                    <span class="stem-label mono">
                                        drums <span class="kind">warp guide</span>
                                    </span>
                                    <span class="mono stem-tag">not yet</span>
                                    <span></span>
                                    <span class="stem-note">
                                        for placing markers; deleted after warping
                                    </span>
                                </div>
                            }

                            @* The whole of the user's say in what gets separated, and the last
                               moment anyone can say it: the evidence run is unattended and the
                               verdict run is a headless session. *@
                            <div class="release">
                                <span class="release-label">Release</span>
                                <select value="@Chosen(row.IsInstrumentalRelease)"
                                        @onchange="e => SetInstrumental(row, e)">
                                    <option value="false">has vocals</option>
                                    <option value="true">no vocals</option>
                                </select>
                                <span class="release-hint">the stems follow from this</span>
                            </div>
                        </div>
                    }
                    else if (row.Samples.Count > 0 || row.HasWarpGuide)
                    {
                        var pending = PendingFor(row);

                        <div class="stems">
                            <div class="panel-head">
                                @StemsHeading(row)@if (pending is not null)
                                {
                                    <span class="pending"> · re-cut pending</span>
                                }
                            </div>

                            <div class="stem-heads">
                                <span>Sample</span>
                                <span>Ableton key</span>
                                <span>Where it is</span>
                                <span></span>
                            </div>

                            @* Where the file is, never whether it has been warped. The move out of
                               staging is what crateside reads warping from (ADR 0007), and that is
                               good enough to call a track done -- but nobody here watched anyone
                               warp anything, so the row names the folder and stops. *@
                            @foreach (var sample in row.Samples)
                            {
                                <div class="stem @(pending is null ? null : "going")">
                                    <span class="stem-label">@sample.Label</span>
                                    <span class="mono stem-tag @TagTone(sample)">@Tag(sample)</span>
                                    @if (pending is null)
                                    {
                                        <span class="mono stem-where @(sample.IsInLibrary ? "good" : null)">
                                            @(sample.IsInLibrary ? "Mashup Samples" : "Sample Staging")
                                        </span>
                                        <span class="stem-note"></span>
                                    }
                                    else
                                    {
                                        <span class="mono stem-where gone">removed</span>
                                        <span class="stem-note">deleted from Sample Staging</span>
                                    }
                                </div>
                            }

                            @* Dashed and dimmed because it is not a sample. Its tag column stays
                               empty rather than reading "never tagged": crateside tags a guide like
                               anything else, and it is kept out for being used up (ADR 0004). *@
                            @if (row.HasWarpGuide)
                            {
                                <div class="stem guide">
                                    <span class="stem-label">
                                        Drums <span class="kind">warp guide</span>
                                    </span>
                                    <span class="mono stem-tag dim">—</span>
                                    @if (pending is null)
                                    {
                                        <span class="mono stem-where">Sample Staging</span>
                                        <span class="stem-note">
                                            for placing markers; deleted after warping
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="mono stem-where gone">removed</span>
                                        <span class="stem-note">re-made below</span>
                                    }
                                </div>
                            }

                            @* What the new recipe would put there instead. Drawn from the recipe
                               rather than from anything on disk, because none of it exists yet. *@
                            @if (pending is { } plan)
                            {
                                var first = true;

                                foreach (var preset in plan.Recipe.Presets)
                                {
                                    <div class="stem coming">
                                        <span class="stem-label mono">@preset</span>
                                        <span class="mono stem-tag">@(Spell(row.Key) ?? "—")</span>
                                        <span class="mono stem-where new">new</span>
                                        <span class="stem-note">
                                            @(first ? "tagged from the existing verdict" : null)
                                        </span>
                                    </div>

                                    first = false;
                                }

                                if (plan.Recipe.KeepSource)
                                {
                                    <div class="stem coming">
                                        <span class="stem-label mono">source</span>
                                        <span class="mono stem-tag">@(Spell(row.Key) ?? "—")</span>
                                        <span class="mono stem-where new">new</span>
                                        <span class="stem-note">the release itself, kept whole</span>
                                    </div>
                                }

                                if (plan.Recipe.ExtractDrums)
                                {
                                    <div class="stem coming guide">
                                        <span class="stem-label mono">
                                            drums <span class="kind">warp guide</span>
                                        </span>
                                        <span class="mono stem-tag">@(Spell(row.Key) ?? "—")</span>
                                        <span class="mono stem-where new">new</span>
                                        <span class="stem-note">
                                            for placing markers; deleted after warping
                                        </span>
                                    </div>
                                }
                            }

                            @* Locked once anything has left for the library: crateside changes what
                               is in staging and nothing else, and the way back in is the user's own
                               drag. *@
                            @if (row.Samples.Any(sample => sample.IsInLibrary))
                            {
                                <div class="release">
                                    <span class="release-label">Release</span>
                                    <span class="locked">@ReleaseWord(row.IsInstrumentalRelease)</span>
                                    <span class="release-hint">
                                        @("file".ToQuantity(row.Samples.Count(s => s.IsInLibrary)))
                                        in Mashup Samples. Move them back to Sample Staging to
                                        change this.
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="release">
                                    <span class="release-label">Release</span>
                                    <select value="@Chosen(pending is null ? row.IsInstrumentalRelease : !row.IsInstrumentalRelease)"
                                            class="@(pending is null ? null : "changed")"
                                            @onchange="e => ProposeRecut(row, e)">
                                        <option value="false">has vocals</option>
                                        <option value="true">no vocals</option>
                                    </select>
                                    @if (pending is null)
                                    {
                                        <span class="release-hint">
                                            the stems follow from this · changing it re-cuts
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="release-hint">
                                            was <strong>@ReleaseWord(row.IsInstrumentalRelease)</strong>
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="side">
                        @if (PendingFor(row) is { } confirm)
                        {
                            <p class="warning">
                                @if (confirm.Refusal is { } refusal)
                                {
                                    @refusal
                                }
                                else
                                {
                                    <text>
                                        Re-cutting removes
                                        @("file".ToQuantity(confirm.Removing.Count))
                                        from Sample Staging.
                                    </text>
                                }
                            </p>

                            <p class="detail">
                                Anything you have done to them in Ableton is lost.
                                @if (row.Key is { } key)
                                {
                                    <text>The key stays @Spell(key) — </text>
                                }
                                detection does not run again, so no quota is spent. The downloaded
                                audio is still on disk; nothing is re-downloaded. About
                                @confirm.Recipe.Estimate.Humanize() on the GPU.
                            </p>

                            <div class="actions">
                                @if (confirm.IsPossible)
                                {
                                    <button class="danger" @onclick="() => ConfirmRecut(row)" disabled="@_working">
                                        @(_working
                                            ? "Re-cutting…"
                                            : $"Re-cut · remove {"file".ToQuantity(confirm.Removing.Count)}")
                                    </button>
                                }
                                <button class="outline" @onclick="CancelRecut" disabled="@_working">
                                    Keep as is
                                </button>
                            </div>
                        }
                        else
                        {
                        <p class="what-next @NextTone(row)">@row.Next</p>
                        <p class="detail">@row.Detail</p>

                        <div class="actions">
                            @if (row.Folder is not null)
                            {
                                <button class="outline" @onclick="() => OpenFolder(row)">Open folder</button>
                            }
                            @* The evidence page has existed all along and lost its only link when
                               the staging board went. It is the whole of what was judged and why:
                               the detectors, the candidates, the human sources. *@
                            @if (row.Verdict is not null)
                            {
                                <a class="outline" href="@($"song/{row.VideoId}")">Why this key</a>
                            }
                            @if (row.GaveUpAt is not null)
                            {
                                <button class="outline" @onclick="() => Retry(row)">Retry</button>
                            }
                            @if (row.IsHeld)
                            {
                                <button class="primary" @onclick="() => SetHeld(row, false)">Release hold</button>
                            }
                            else if (row.PlaylistItemId is not null && row.State is not TrackState.Done)
                            {
                                <button class="outline" @onclick="() => SetHeld(row, true)">Hold</button>
                            }
                            @* Consent is the settings page's business; without it removal is a bare
                               403, so the button is absent rather than broken. *@
                            @if (row.PlaylistItemId is { } playlistItemId && Playlist.IsAuthorized)
                            {
                                <button class="outline" @onclick="() => Remove(row, playlistItemId)">
                                    Remove from playlist
                                </button>
                            }
                        </div>
                        }

                        @if (_problem is { } problem)
                        {
                            <p class="problem">@problem</p>
                        }
                    </div>
                </div>
            }
        }
    }

    @* Bottom-right and outside the list, because it is about a track the user is not currently
       looking at. The one interruption this page makes. *@
    @if (_toasts.Count > 0)
    {
        <div class="toasts">
            @foreach (var toast in _toasts)
            {
                <div class="toast">
                    <span class="eyebrow">Ready to warp</span>
                    <span class="toast-song">@toast.Title</span>
                    <span class="mono toast-figure">@Figure(toast)</span>
                    <span class="toast-foot">
                        @Waiting(toast)
                        @* An anchor rather than an interop call: the browser's own fragment jump
                           lands the row clear of the frozen header via scroll-margin-top, and
                           scrollIntoView on a sticky layout is what the design warned off. *@
                        <a class="show" href="@($"#{Anchor(toast)}")" @onclick="() => Show(toast)">
                            Show row
                        </a>
                    </span>
                </div>
            }
        </div>
    }
</div>

@code {
    private TracksView? _view;
    private TrackFilter _filter = TrackFilter.All;
    private QuotaSnapshot _quota = QuotaSnapshot.Unknown;

    /// <summary>How long a toast stays up. Long enough to read and act on, short enough to ignore.</summary>
    private static readonly TimeSpan ToastLife = TimeSpan.FromSeconds(20);

    /// <summary>
    /// How often the page redraws itself for the clock rather than for a change.
    /// </summary>
    /// <remarks>
    /// The elapsed counters and the synced line are read off <em>now</em>, and nothing publishes
    /// the passing of time — so without this they froze at whatever they said when the last stage
    /// change arrived, which is why judging always read "0:02 elapsed". One second, because that
    /// is the granularity the elapsed clock is written in. The synced line deliberately is not,
    /// and rounds to the minute.
    /// </remarks>
    private static readonly TimeSpan Tick = TimeSpan.FromSeconds(1);

    // One at a time, and by video ID rather than by index: the list is rebuilt on every change,
    // so a position would open whichever row happened to land there.
    private string? _expanded;
    private string? _problem;

    // Newest first. Which tracks have been announced is the singleton's business; this is only
    // what is currently on screen, and it goes with the circuit.
    private readonly List<TrackRow> _toasts = [];

    private readonly CancellationTokenSource _circuit = new();

    private System.Threading.Timer? _clock;
    private bool _syncing;
    private bool _working;

    // The proposal, not the change: nothing runs until it is confirmed. Only one row is open at a
    // time, so one field is the whole of the state.
    private string? _recutting;
    private RecutPlan? _plan;

    private string? _renaming;
    private string _name = string.Empty;

    private IReadOnlyList<TrackRow> Rows => _view?.Rows ?? [];

    private IEnumerable<TrackRow> Shown => Rows.Where(row => row.Matches(_filter));

    protected override async Task OnInitializedAsync()
    {
        Source.Changed += OnChanged;
        Source.ReadyToWarp += OnReadyToWarp;
        Separation.Changed += OnChanged;
        Judging.Changed += OnChanged;

        // Arriving at the page is a reason to look again. Warping happens in Ableton and moves
        // files crateside never hears about, so the hub cannot invalidate this — and the staging
        // view is the one thing the user opens the page to check.
        await Source.EnsureFreshAsync(TimeSpan.FromSeconds(30));

        _view = Source.Current;
        _quota = await Quota.ReadAsync();

        _clock = new System.Threading.Timer(_ => Redraw(), null, Tick, Tick);
    }

    private void Redraw()
    {
        if (_circuit.IsCancellationRequested)
            return;

        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The circuit went away between the check above and the call. Nothing to draw.
        }
    }

    /// <summary>
    /// Drops the cached playlist and reads it again — "go and look", rather than "show me what you
    /// last saw".
    /// </summary>
    /// <remarks>
    /// The invalidate is the point: the read is cached for two minutes, so pressing this straight
    /// after adding a track on your phone would otherwise hand back the same list.
    /// </remarks>
    private async Task Resync()
    {
        _syncing = true;

        try
        {
            Playlist.Invalidate();

            await Source.RefreshAsync(_circuit.Token);
        }
        finally
        {
            _syncing = false;
        }
    }

    /// <summary>
    /// When the playlist was last read, to the minute.
    /// </summary>
    /// <remarks>
    /// To the minute because it is the only thing here that would otherwise tick every second
    /// without anything having happened, and a counter moving for its own sake reads as activity.
    /// The elapsed clocks move by the second because something genuinely is.
    /// </remarks>
    private string Synced =>
        _view?.ReadAt is not { } read ? "playlist not read yet"
        : DateTimeOffset.UtcNow - read is { TotalMinutes: < 1 } ? "playlist synced just now"
        : $"playlist synced {(DateTimeOffset.UtcNow - read).Humanize(minUnit: TimeUnit.Minute)} ago";

    public void Dispose()
    {
        Source.Changed -= OnChanged;
        Source.ReadyToWarp -= OnReadyToWarp;
        Separation.Changed -= OnChanged;
        Judging.Changed -= OnChanged;

        _clock?.Dispose();

        _circuit.Cancel();
        _circuit.Dispose();
    }

    private void OnReadyToWarp(TrackRow row)
    {
        _toasts.Insert(0, row);
        _ = InvokeAsync(StateHasChanged);
        _ = Dismiss(row);
    }

    private async Task Dismiss(TrackRow row)
    {
        try
        {
            await Task.Delay(ToastLife, _circuit.Token);
        }
        catch (OperationCanceledException)
        {
            // The circuit went away while the toast was up. Nothing to take down.
            return;
        }

        _toasts.Remove(row);

        await InvokeAsync(StateHasChanged);
    }

    private void Show(TrackRow row)
    {
        // All rather than In staging: the anchor has to be in the list for the browser to reach
        // it, and All is the one filter that always contains it.
        _filter = TrackFilter.All;
        _expanded = row.VideoId;
        _problem = null;

        _toasts.Remove(row);
    }

    private static string Anchor(TrackRow row) => $"track-{row.VideoId}";

    private static string Figure(TrackRow row) =>
        string.Join(
            " · ",
            new[] { Spell(row.Key), row.Bpm?.ToString("N0") }.OfType<string>()
        );

    // Samples, not stems: an instrumental release's kept file is the source track, which is a
    // sample and no kind of stem at all (ADR 0004). The count is what is still in staging, since
    // the user empties it progressively and may already have moved some of them.
    private static string Waiting(TrackRow row) =>
        $"{"sample".ToQuantity(row.Samples.Count(sample => !sample.IsInLibrary))} in Sample Staging, key-tagged.";

    // The events are raised on a background worker's thread, never the circuit's, so the render
    // has to be marshalled back. Same discipline the queue page has always used for DrainControl.
    private void OnChanged()
    {
        _view = Source.Current;
        _ = InvokeAsync(StateHasChanged);
    }

    private void Expand(TrackRow row)
    {
        _expanded = _expanded == row.VideoId ? null : row.VideoId;
        _problem = null;

        CancelRecut();
        CancelRename();
    }

    private void StartRename(TrackRow row)
    {
        _problem = null;
        _renaming = row.VideoId;
        _name = row.Title;
    }

    private void CancelRename()
    {
        _renaming = null;
        _name = string.Empty;
    }

    /// <summary>
    /// Records the name and puts it on the files. No confirmation step, unlike a re-cut.
    /// </summary>
    /// <remarks>
    /// Nothing here is spent or destroyed: no file is deleted, no GPU is used, and Revert puts
    /// every name back. A confirmation would be asking about a decision that costs nothing.
    /// </remarks>
    private async Task ConfirmRename(TrackRow row)
    {
        if (!StemFileName.IsUsable(_name))
            return;

        await Renaming(() => Rename.Apply(row.VideoId, _name));
    }

    // The derived name comes from the row, because deriving it is this page's join across the
    // ledger, the staging board and the playlist rather than the rename's own business.
    private async Task RevertRename(TrackRow row) =>
        await Renaming(() => Rename.Revert(row.VideoId, row.DerivedTitle ?? row.Title));

    private async Task Renaming(Func<RenameOutcome> rename)
    {
        _working = true;
        _problem = null;

        try
        {
            var outcome = rename();

            // The tag note is not a failure — the files were renamed and the tagging stage puts
            // their keywords back on its own pass — but it is worth seeing.
            _problem = outcome.Problem ?? outcome.Note;

            if (outcome.Succeeded)
                CancelRename();

            await Source.RefreshAsync(_circuit.Token);
        }
        finally
        {
            _working = false;
        }
    }

    private async Task OnRenameKey(KeyboardEventArgs e, TrackRow row)
    {
        if (e.Key is "Enter")
            await ConfirmRename(row);
        else if (e.Key is "Escape")
            CancelRename();
    }

    private static string Derived(TrackRow row) => row.DerivedTitle ?? row.Title;

    private static string From(TrackNameSource source) =>
        source switch
        {
            TrackNameSource.Ledger => "the ledger",
            TrackNameSource.StagingBoard => "the staging board",
            TrackNameSource.Playlist => "the playlist title",
            _ => "the video ID",
        };

    private RecutPlan? PendingFor(TrackRow row) =>
        _recutting == row.VideoId ? _plan : null;

    /// <summary>
    /// Works out what changing the release would cost, and shows it. Changes nothing.
    /// </summary>
    /// <remarks>
    /// Separate from <see cref="ConfirmRecut"/> because the consequence is files being deleted and
    /// six minutes of GPU, and neither belongs behind a dropdown.
    /// </remarks>
    private void ProposeRecut(TrackRow row, ChangeEventArgs e)
    {
        _problem = null;

        if (Wanted(e) == row.IsInstrumentalRelease)
        {
            CancelRecut();
            return;
        }

        _recutting = row.VideoId;
        _plan = Recut.PlanFor(row.VideoId, !row.IsInstrumentalRelease);
    }

    private void CancelRecut()
    {
        _recutting = null;
        _plan = null;
    }

    private async Task ConfirmRecut(TrackRow row)
    {
        _working = true;
        _problem = null;

        try
        {
            var outcome = Recut.Apply(row.VideoId, !row.IsInstrumentalRelease);

            _problem = outcome.Problem;

            if (outcome.Succeeded)
                CancelRecut();

            // The stages were reopened by hand, and a worker part-way through its two-minute idle
            // wait would not look again until it ended.
            Separation.Wake();

            await Source.RefreshAsync(_circuit.Token);
        }
        finally
        {
            _working = false;
        }
    }

    // bool.ToString() is "True" and the option values are "true", so the select matched no
    // option and the browser drew an empty box. Nothing was wrong with the colours.
    private static string Chosen(bool isInstrumentalRelease) =>
        isInstrumentalRelease ? "true" : "false";

    private static bool Wanted(ChangeEventArgs e) =>
        bool.TryParse(e.Value?.ToString(), out var wanted) && wanted;

    private static string ReleaseWord(bool isInstrumentalRelease) =>
        isInstrumentalRelease ? "no vocals" : "has vocals";

    // The server is this machine, so opening a folder means what it says. Nothing is read back —
    // this hands off to Explorer, and what happens next happens there.
    private void OpenFolder(TrackRow row)
    {
        if (row.Folder is not { } folder)
            return;

        try
        {
            Process.Start(new ProcessStartInfo(folder) { UseShellExecute = true });
        }
        catch (Exception e)
        {
            _problem = $"Could not open {folder}: {e.Message}";
        }
    }

    private async Task SetHeld(TrackRow row, bool held)
    {
        if (held)
            Playlist.Hold(row.VideoId);
        else
            Playlist.Release(row.VideoId);

        await Source.RefreshAsync();
    }

    // Before separation there is nothing to undo, so this is the plain recorded fact rather than
    // a re-cut. Same control, because to the user it is the same question.
    private async Task SetInstrumental(TrackRow row, ChangeEventArgs e)
    {
        Playlist.SetInstrumentalRelease(row.VideoId, Wanted(e));

        await Source.RefreshAsync(_circuit.Token);
    }

    // Every failed stage, not just the one that gave up: a track that failed twice at evidence and
    // three times at verdict is stopped by the second, and clearing only that leaves the first
    // counting against the next attempt.
    private async Task Retry(TrackRow row)
    {
        foreach (var stage in Enum.GetValues<JobStage>())
            if (Jobs.TryGet(row.VideoId, stage, out var job) && job is { Status: JobStatus.Failed })
                Jobs.Forgive(row.VideoId, stage);

        // Nothing polls the job store, so a worker part-way through its idle wait would not look
        // again for up to two minutes — long enough for the button to read as broken.
        Separation.Wake();
        Judging.Wake();

        await Source.RefreshAsync();
    }

    private async Task Remove(TrackRow row, string playlistItemId)
    {
        _problem = null;

        try
        {
            // The playlist entry is the whole of what removal targets, and the row carries it.
            var results = await Playlist.RemoveAsync(
                [
                    new QueueItem
                    {
                        PlaylistItemId = playlistItemId,
                        VideoId = row.VideoId,
                        Title = row.Title,
                    },
                ]
            );

            _problem = results.FirstOrDefault(result => !result.Removed)?.Reason;

            await Source.RefreshAsync();
        }
        catch (QueueUnavailableException e)
        {
            _problem = e.Message;
        }
    }

    private static string StemsHeading(TrackRow row) =>
        row.Folder is { } folder
            ? $"Stems · {Path.GetFileName(folder)} / {row.Title}"
            : $"Stems · {row.Title}";

    // The key Ableton actually holds, never the verdict's: on the one row where those disagree,
    // showing the verdict with a tick beside it would say the opposite of what is true.
    private static string Tag(TrackSample sample) =>
        sample switch
        {
            { AbletonKey: { } key } => $"{Spell(key)} ✓",
            { IsInLibrary: true } => "—",
            _ => "not tagged",
        };

    // A sample that has left staging is dim rather than red. Nothing here read its tag — crateside does
    // not write tags outside Sample Staging and does not trust the store elsewhere (ADR 0003) — so
    // "not tagged" would be a claim, and the honest mark is no claim at all.
    private static string TagTone(TrackSample sample) =>
        sample switch
        {
            { IsKeyTagged: true } => "good",
            { IsInLibrary: true } => "dim",
            _ => "bad",
        };

    // Two toggles rather than one, and they stop for different reasons. The GPU is audible and
    // makes the machine unusable while it runs; a verdict spends ~5.4% of a five-hour quota window
    // before it weighs anything. Sharing a button would mean stopping the GPU to save quota.
    private void ToggleSeparation()
    {
        if (Separation.IsPaused)
            Separation.Resume();
        else
            Separation.Pause();
    }

    private void ToggleJudging()
    {
        if (Judging.IsPaused)
            Judging.Resume();
        else
            Judging.Pause();
    }

    private TrackRow? RowIn(TrackState state) => Rows.FirstOrDefault(row => row.State == state);

    // Both counts are exact rather than approximate: the GPU line is every track that has been
    // judged and is waiting, and the judging line is every track with no verdict yet.
    private int Waiting(TrackState state) => Rows.Count(row => row.State == state);

    // Counted from when the stage recorded Running, which for an open job is when it started:
    // nothing reports progress in between, separation least of all.
    private static string Elapsed(DateTimeOffset since)
    {
        var span = DateTimeOffset.UtcNow - since;

        return span.TotalHours >= 1
            ? $"{(int)span.TotalHours}:{span.Minutes:00}:{span.Seconds:00}"
            : $"{(int)span.TotalMinutes}:{span.Seconds:00}";
    }

    private static string Name(TrackFilter filter) =>
        filter switch
        {
            TrackFilter.InStaging => "In staging",
            TrackFilter.InFlight => "In flight",
            TrackFilter.NeedsAttention => "Needs attention",
            _ => filter.ToString(),
        };

    // Only three things are coloured, and only where the colour means something: amber is the
    // user's turn, teal is the machine working, red needs attention.
    private static string Tone(TrackFilter filter) =>
        filter switch
        {
            TrackFilter.InStaging => "amber",
            TrackFilter.InFlight => "teal",
            TrackFilter.NeedsAttention => "red",
            _ => "plain",
        };

    private static string ChipClass(TrackChipStyle style) =>
        style switch
        {
            TrackChipStyle.TealFilled => "teal-filled",
            TrackChipStyle.TealOutline => "teal-outline",
            TrackChipStyle.AmberFilled => "amber-filled",
            TrackChipStyle.RedOutline => "red-outline",
            TrackChipStyle.RedFilled => "red-filled",
            TrackChipStyle.GreenOutline => "green-outline",
            TrackChipStyle.DashedOutline => "dashed-outline",
            _ => "neutral-outline",
        };

    private static string NextTone(TrackRow row) =>
        row.State switch
        {
            TrackState.ReadyToWarp => "amber",
            TrackState.Parked or TrackState.GaveUp => "attention",
            _ => string.Empty,
        };

    private static string Confidence(KeyConfidence confidence) =>
        confidence is KeyConfidence.Unknown ? "—" : confidence.ToString().ToUpperInvariant();

    private static string ConfidenceTone(KeyConfidence confidence) =>
        confidence switch
        {
            KeyConfidence.High => "high",
            KeyConfidence.Medium => "medium",
            KeyConfidence.Low or KeyConfidence.Withheld => "weak",
            _ => "none",
        };

    // The ledger spells keys in ASCII so they survive a filename; the screen is not a filename.
    private static string? Spell(string? key) =>
        key?.Replace("#", "♯", StringComparison.Ordinal)
            .Replace(" major", " maj", StringComparison.Ordinal)
            .Replace(" minor", " min", StringComparison.Ordinal);
}
