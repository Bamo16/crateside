@page "/"
@page "/tracks"
@layout Crateside.Components.Layout.BareLayout
@rendermode InteractiveServer
@implements IDisposable

@using System.Diagnostics
@using Crateside.Core
@using Crateside.Core.Ledger
@using Crateside.Core.Orchestration
@using Crateside.Core.Queue
@using Crateside.Core.Quota
@using Crateside.Core.Staging
@using Crateside.Core.Tracks
@using Humanizer

@inject TracksService Source
@inject QueueService Playlist
@inject JobStore Jobs
@inject StemRecut Recut
@inject SourceAdd Sources
@inject SampleAdoption Adoption
@inject TrackRemoval Removal
@inject TrackAdd Adding
@inject PresetCatalogReader Presets
@inject TrackRename Rename
@inject TrackSwap Swap
@inject DrainControl Separation
@inject StageSignals Signals
@inject QueueWriteAccess Access
@inject VerdictControl Judging
@inject WorkingSet Held
@inject QuotaReader Quota
@inject WindowRoll Roll

<PageTitle>Tracks</PageTitle>

<div class="tracks">
    <PageHeader Active="BrandNav.Tab.Tracks" Shape="PageHeader.Shapes.Shade">

        <div class="cell activity">
            <div class="label-row">
                <span class="label">Separation</span>
                <span class="mono waiting">@Waiting(TrackState.JudgedInLine) waiting</span>
            </div>
            @{
                var separating = RowIn(TrackState.Separating);
            }
            <div class="activity-line">
                <span class="dot @(Separation.IsPaused ? "amber" : separating is null ? "idle" : "teal")"></span>
                <span class="subject">@(separating?.Title ?? (Separation.IsPaused ? "paused" : "idle"))</span>
                @if (separating?.RunningSince is { } since)
                {
                    <span class="mono elapsed">@Elapsed(since) elapsed</span>
                }
                <button class="outline" @onclick="ToggleSeparation">
                    @(Separation.IsPaused ? "Resume" : "Pause")
                </button>
            </div>
            <div class="bar">
                @if (separating is not null)
                {
                    <div class="sweep"></div>
                }
            </div>
        </div>

        <div class="cell activity">
            <div class="label-row">
                <span class="label">Judging</span>
                <span class="mono waiting">@Waiting(TrackState.Queued) waiting</span>
            </div>
            @{
                var judging = RowIn(TrackState.Judging);
            }
            <div class="activity-line">
                <span class="dot @(Judging.IsPaused ? "amber" : judging is null ? "idle" : "teal")"></span>
                <span class="subject">@(judging?.Title ?? (Judging.IsPaused ? "paused" : "idle"))</span>
                @if (judging?.RunningSince is { } judgingSince)
                {
                    <span class="mono elapsed">@Elapsed(judgingSince) elapsed</span>
                }
                <button class="outline" @onclick="ToggleJudging">
                    @(Judging.IsPaused ? "Resume" : "Pause")
                </button>
            </div>
            <div class="bar">
                @if (judging is not null)
                {
                    <div class="sweep"></div>
                }
            </div>
        </div>

        <div class="cell quota">
            <div class="label-row">
                <span class="label">Claude quota</span>
                @if (_quota.ResetsAt is { } resets)
                {
                    <span class="mono waiting">resets @resets.ToLocalTime().ToString("h:mm tt").ToLowerInvariant()</span>
                }
            </div>
            <div class="quota-figure">
                <span class="mono percent">@(_quota.Utilization is { } used ? $"{used:N0}%" : "—")</span>
                <span class="of">of this 5-hour window</span>
                <button class="outline roll @(Roll.IsEnabled ? "on" : null)" @onclick="ToggleRoll"
                        title="While judging is paused, judge one track whenever a window has sat idle, so the windows keep rolling.">
                    @(Roll.IsEnabled ? "Rolling idle windows" : "Roll idle windows")
                </button>
            </div>
            <div class="bar">
                <div class="fill" style="width: @($"{Math.Clamp(_quota.Utilization ?? 0, 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture)}%")"></div>
            </div>
        </div>
    </PageHeader>

    <div class="filters">
        @foreach (var filter in Enum.GetValues<TrackFilter>())
        {
            <button class="pill @(filter == _filter ? "on " + Tone(filter) : "off")"
                    @onclick="() => _filter = filter">
                @Name(filter)
                <span class="mono count @Tone(filter)">@Rows.Count(filter)</span>
            </button>
        }
        <div class="search">
            <input type="search" placeholder="Find a track" aria-label="Find a track"
                   value="@_search" @oninput="OnSearch" />
            @if (_search.Length > 0)
            {
                <button class="clear" @onclick="ClearSearch" title="Clear">×</button>
            }
        </div>
        <button class="pill off" @onclick="ToggleAddTrack" disabled="@_working">
            + Add track
        </button>
        <button class="status" @onclick="Resync" disabled="@_syncing">
            @(_syncing ? "checking the playlist…" : Synced)
        </button>
    </div>

    @if (_addingTrack)
    {
        <div class="add-track">
            <label>
                <span>YouTube URL or video ID</span>
                <input class="mono" @ref="_trackBox" value="@_trackUrl"
                       @oninput="e => OnAddTrack(e.Value?.ToString())"
                       @onkeydown="OnAddTrackKey" />
            </label>

            <p class="add-note @(_trackPlan?.Refusal is null && _trackShortfall is null ? null : "bad")">
                @if (_trackShortfall is { } poor)
                {
                    <text>
                        This upload offers no premium format. The best it has is @poor.Quality.
                    </text>
                }
                else if (_trackPlan?.Refusal is { } why)
                {
                    @why
                }
                else if (_trackPlan?.JudgesWhatIsHere is true)
                {
                    <text>
                        The library already holds this track's samples, unjudged. Buys a verdict,
                        not a separation. Judging spends Claude quota.
                    </text>
                }
                else
                {
                    <text>
                        Runs the whole workflow — download, detect, judge, separate, stage, tag.
                        Judging spends Claude quota. It is not added to the playlist; crateside
                        keeps its own record of it.
                        @if (_trackPlan?.Song is { } song)
                        {
                            <text>keytag already has this video as <strong>@song</strong>.</text>
                        }
                    </text>
                }
            </p>

            <div class="actions">
                @if (_trackShortfall is not null)
                {
                    <button class="danger" disabled="@_working"
                            @onclick="() => ConfirmAddTrack(anyway: true)">
                        @(_working ? "Adding…" : "Add it anyway")
                    </button>
                }
                else
                {
                    <button class="primary" disabled="@(_working || _trackPlan?.IsPossible is not true)"
                            @onclick="() => ConfirmAddTrack()">
                        @(_working ? "Reading the upload…" : "Add")
                    </button>
                }
                <button class="outline" @onclick="CancelAddTrack" disabled="@_working">Cancel</button>
            </div>
        </div>
    }

    <div class="heads @(_filter is TrackFilter.InStaging ? "roomy" : null)">
        <span></span>
        <span>Song</span>
        <span>Key</span>
        <span>Confidence</span>
        <span class="right">BPM</span>
        <span>State</span>
        @if (_filter is TrackFilter.InStaging)
        {
            <span>Since</span>
        }
    </div>

    @if (_view is { PlaylistProblem: { } stale })
    {
        @* The rows below are built from what crateside has taken on, so they stand. *@
        <p class="notice error">
            The playlist could not be read, so nothing new can arrive: @stale
        </p>
    }

    @if (_view is null)
    {
        <p class="notice">Reading the queue…</p>
    }
    else if (Source.LastError is { } error)
    {
        <p class="notice error">The playlist could not be read: @error</p>
    }
    else if (!Shown.Any())
    {
        @if (_search.Length is 0)
        {
            <p class="notice">Nothing in this view.</p>
        }
        else if (Rows.Holding(_search) is { Count: > 0 } elsewhere)
        {
            <p class="notice">
                Nothing matching <strong>@_search</strong> in @Name(_filter). Found in
                @foreach (var filter in elsewhere)
                {
                    <button class="jump" @onclick="() => _filter = filter">
                        @Name(filter)
                        <span class="mono">@Found.Count(filter)</span>
                    </button>
                }
            </p>
        }
        else
        {
            <p class="notice">No track matches <strong>@_search</strong>.</p>
        }
    }
    else
    {
        @foreach (var row in Shown)
        {
            var open = _expanded == row.VideoId;

            <div id="@Anchor(row)"
                 class="row @(_filter is TrackFilter.InStaging ? "roomy" : null) @(open ? "open" : null)"
                 @onclick="() => Expand(row)">
                <span class="chevron mono">@(open ? "⌄" : "›")</span>

                <span class="song">
                    @row.Title
                    @if (row.AuditNote is { } note)
                    {
                        <span class="flag">@note</span>
                    }
                    @if (row.AwaitingRename > 0)
                    {
                        <span class="flag">@("file".ToQuantity(row.AwaitingRename)) not renamed</span>
                    }
                    else if (row.IsRenamed)
                    {
                        <span class="flag neutral">renamed</span>
                    }
                    @if (row.IsAddedByUrl)
                    {
                        <span class="flag neutral">added by URL</span>
                    }
                </span>

                <span class="mono key @(row.Key is null ? "none" : null)">@(Spell(row.Key) ?? "—")</span>

                <span class="mono conf @ConfidenceTone(row.Confidence)">@Confidence(row.Confidence)</span>

                <span class="mono bpm right @(row.State is TrackState.ReadyToWarp ? "ready" : null) @(row.Bpm is null ? "none" : null)">
                    @(row.Bpm is { } bpm ? bpm.ToString("N0") : "—")
                </span>

                <span>
                    <span class="chip @ChipClass(row.ChipStyle)">
                        @if (row.ChipHasDot)
                        {
                            <span class="chip-dot"></span>
                        }
                        @row.ChipLabel
                    </span>
                </span>

                @if (_filter is TrackFilter.InStaging)
                {
                    <span class="since">
                        @(row.StagedSince is { } staged ? $"staged {staged.Humanize()}" : "—")
                    </span>
                }
            </div>

            @if (open)
            {
                <div class="panel">
                    @if (row.ParkedFor is ParkReason.PremiumShortfall)
                    {
                        <div class="finding">
                            <div class="finding-said">
                                <strong>The download did not get premium audio.</strong>
                                @row.Acquisition?.Advisory
                            </div>

                            <button class="outline" @onclick="() => UseAnyway(row)" disabled="@_working">
                                Use it anyway
                            </button>
                        </div>
                    }
                    <div class="edits">
                        <div class="name-strip @(_renaming == row.VideoId ? "editing" : null)">
                            @if (_renaming == row.VideoId)
                            {
                                <div class="name-edit">
                                    <input class="name-input" @ref="_nameBox" value="@_name"
                                           @oninput="e => _name = e.Value?.ToString() ?? string.Empty"
                                           @onkeydown="e => OnRenameKey(e, row)" />
                                    <p class="name-note">
                                        Derived <strong>@Derived(row)</strong> · from @From(row.NameSource).
                                        Your name wins over the ledger, the staging board and the playlist.
                                    </p>
                                </div>

                                <div class="name-side">
                                    <p class="detail">@row.RenameDetail</p>

                                    <div class="actions">
                                        <button class="primary" disabled="@(_working || !StemFileName.IsUsable(_name))"
                                                @onclick="() => ConfirmRename(row)">
                                            Rename · @row.RenameScope
                                        </button>
                                        <button class="outline" @onclick="CancelRename" disabled="@_working">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span class="name-from">
                                    @if (row.DerivedTitle is { } derived)
                                    {
                                        <text>renamed by you · was <strong>@derived</strong></text>
                                    }
                                    else
                                    {
                                        <text>named from @From(row.NameSource)</text>
                                    }
                                </span>

                                @if (row.CanRename)
                                {
                                    <button class="outline" @onclick="() => StartRename(row)" disabled="@_working">
                                        Rename
                                    </button>
                                    @if (row.IsRenamed)
                                    {
                                        <button class="outline" @onclick="() => RevertRename(row)" disabled="@_working">
                                            Revert
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span class="name-from">· rename it in Ableton</span>
                                }
                            }
                        </div>

                        <div class="name-strip @(_swapping == row.VideoId ? "editing" : null)">
                            @if (_swapping == row.VideoId)
                            {
                                <div class="name-edit">
                                    <input class="name-input" @ref="_swapBox" value="@_swapUrl" placeholder="https://www.youtube.com/watch?v=…"
                                           @oninput="e => OnSwapUrl(row, e)"
                                           @onkeydown="e => OnSwapKey(e, row)" />
                                    <p class="name-note">
                                        A better upload of the same song. The playlist entry stays as it is.
                                    </p>
                                </div>

                                <div class="name-side">
                                    <p class="detail">
                                        @(_swapPlan?.Refusal ?? _swapPlan?.Detail ?? SwapPlan.DetailFor(row.Verdict is not null))
                                        @if (row.SamplesLeftInLibrary > 0)
                                        {
                                            <text>
                                                @("sample".ToQuantity(row.SamplesLeftInLibrary)) of the old upload are in
                                                Mashup Samples; crateside never writes there, so remove them yourself.
                                            </text>
                                        }
                                    </p>

                                    <div class="actions">
                                        <button class="danger" disabled="@(_working || _swapPlan?.IsPossible is not true)"
                                                @onclick="() => ConfirmSwap(row)">
                                            @(_working ? "Swapping…" : SwapScope(_swapPlan))
                                        </button>
                                        <button class="outline" @onclick="CancelSwap" disabled="@_working">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span class="name-from">
                                    @if (row.IsSourceSwapped)
                                    {
                                        <text>source swapped · cut from <strong>@row.StatedSourceUrl</strong></text>
                                    }
                                    else
                                    {
                                        <text>cut from the playlist entry's own video</text>
                                    }
                                </span>

                                <button class="outline" @onclick="() => StartSwap(row)" disabled="@_working">
                                    Swap source
                                </button>
                            }
                        </div>
                    </div>

                    @{
                        var picker = PickerFor(row);
                        var picking = _picking == row.VideoId;
                        var ticking = row.CanChangePlan || picking;
                    }

                    @if (ticking || row.Samples.Count > 0 || row.HasWarpGuide)
                    {
                        <div class="stems">
                            <div class="panel-head">
                                @(row.CanChangePlan ? "Will be cut into" : StemsHeading(row))@if (picking && !picker.IsAdditive)
                                {
                                    <span class="pending"> · re-cut pending</span>
                                }
                            </div>

                            @if (ticking)
                            {
                                <div class="stem-heads picking @(row.CanChangePlan ? "planning" : null)">
                                    <span></span>
                                    <span>Sample</span>
                                    @if (!row.CanChangePlan)
                                    {
                                        <span>Ableton key</span>
                                        <span>Where it is</span>
                                    }
                                    <span></span>
                                </div>

                                @foreach (var band in picker.Bands)
                                {
                                    <div class="stem-band">@band.Label</div>

                                    @foreach (var line in band.Lines)
                                    {
                                        <div class="stem picking @(row.CanChangePlan ? "planning" : null) @LineTone(line)"
                                             title="@(line.Kind is StemKind.Preset ? line.Description : null)"
                                             @onclick="() => Toggle(row, line)">
                                            <span class="tick @TickTone(line)">@TickMark(line)</span>

                                            <span class="stem-label">
                                                @line.Label
                                                @if (line.AddedSource is not null)
                                                {
                                                    <span class="kind">added by you</span>
                                                }
                                                else if (line.Kind is StemKind.Source)
                                                {
                                                    <span class="kind">separation source</span>
                                                }
                                                @if (line.IsNotPremium)
                                                {
                                                    <span class="premium-badge" title="The upload offered no premium audio, so this file is the best it had.">not premium</span>
                                                }
                                                @if (line.Kind is StemKind.WarpGuide)
                                                {
                                                    <span class="kind">warp guide</span>
                                                }
                                            </span>

                                            @if (!row.CanChangePlan)
                                            {
                                                <span class="mono stem-tag @(line.AbletonKey is null ? "dim" : null)">
                                                    @Tag(line, row)
                                                </span>
                                                <span class="mono stem-where @WhereTone(line)">@Where(line, picker)</span>
                                            }

                                            <span class="stem-note">@Note(line, row)</span>
                                        </div>
                                    }

                                    @if (band.Label == "Sources")
                                    {
                                        @if (_adding == row.VideoId)
                                        {
                                            <div class="add-source">
                                                <div class="add-fields">
                                                    <label>
                                                        <span>Where it is</span>
                                                        <input class="mono" placeholder="YouTube URL or video ID"
                                                               value="@_addUrl"
                                                               @oninput="e => OnAdd(row, url: e.Value?.ToString())" />
                                                    </label>
                                                    <label>
                                                        <span>What it is</span>
                                                        <input placeholder="Official Instrumental"
                                                               value="@_addLabel"
                                                               @oninput="e => OnAdd(row, label: e.Value?.ToString())" />
                                                    </label>
                                                </div>

                                                <div class="add-type">
                                                    <span class="add-type-label">Plays as</span>
                                                    @foreach (var type in Enum.GetValues<SampleType>())
                                                    {
                                                        <button class="pill @(_addType == type ? "on plain" : "off")"
                                                                @onclick="() => ChooseType(row, type)" disabled="@_working">
                                                            @type
                                                        </button>
                                                    }
                                                    <span class="add-title">@TitleNote</span>
                                                </div>

                                                <p class="add-note @(_addPlan?.Refusal is null && _shortfall is null ? null : "bad")">
                                                    @if (_shortfall is { } poor)
                                                    {
                                                        <text>
                                                            This upload offers no premium format.
                                                            The best it has is @poor.Quality, and
                                                            that is what would land in your library.
                                                        </text>
                                                    }
                                                    else
                                                    {
                                                        @(_addPlan?.Refusal ?? AddNote(row))
                                                    }
                                                </p>

                                                <div class="actions">
                                                    @if (_shortfall is not null)
                                                    {
                                                        <button class="danger" disabled="@_working"
                                                                @onclick="() => ConfirmAdd(row, anyway: true)">
                                                            @(_working ? "Adding…" : "Add it anyway")
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="primary" disabled="@(_working || _addPlan?.IsPossible is not true)"
                                                                @onclick="() => ConfirmAdd(row)">
                                                            @(_working ? "Checking…" : "Add source")
                                                        </button>
                                                    }
                                                    <button class="outline" @onclick="CancelAdding" disabled="@_working">
                                                        Cancel
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else if (_adopting == row.VideoId)
                                        {
                                            <div class="add-source">
                                                <div class="add-fields">
                                                    <label>
                                                        <span>The file</span>
                                                        <select value="@_adoptPath"
                                                                @onchange="e => OnAdopt(row, e.Value?.ToString())">
                                                            <option value="">Choose a file nothing has placed…</option>
                                                            @foreach (var candidate in _adoptCandidates)
                                                            {
                                                                <option value="@candidate">@Path.GetFileName(candidate)</option>
                                                            }
                                                        </select>
                                                    </label>
                                                    <label>
                                                        <span>What the track calls it</span>
                                                        <input value="@(_adoptPlan?.Label ?? string.Empty)" readonly
                                                               placeholder="read from the brackets in its name" />
                                                    </label>
                                                </div>

                                                <div class="add-type">
                                                    <span class="add-type-label">Plays as</span>
                                                    @foreach (var type in Enum.GetValues<SampleType>())
                                                    {
                                                        <button class="pill @(_adoptType == type ? "on plain" : "off")"
                                                                @onclick="() => ChooseAdoptType(row, type)" disabled="@_working">
                                                            @type
                                                        </button>
                                                    }
                                                </div>

                                                <p class="add-note @(_adoptPlan?.Refusal is null ? null : "bad")">
                                                    @(_adoptPlan?.Refusal ?? AdoptNote)
                                                </p>

                                                <div class="actions">
                                                    <button class="primary" disabled="@(_working || _adoptPlan?.IsPossible is not true)"
                                                            @onclick="() => ConfirmAdopt(row)">
                                                        Adopt it
                                                    </button>
                                                    <button class="outline" @onclick="CancelAdopting" disabled="@_working">
                                                        Cancel
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <button class="opener" @onclick="() => StartAdding(row)" disabled="@_working">
                                                <span class="mono">+</span>
                                                <span>Add a source</span>
                                                <span class="opener-hint">
                                                    another file of this song · kept whole, never separated
                                                </span>
                                            </button>
                                            <button class="opener" @onclick="() => StartAdopting(row)" disabled="@_working">
                                                <span class="mono">+</span>
                                                <span>Adopt a file</span>
                                                <span class="opener-hint">
                                                    one you made by hand · taken in where it is
                                                </span>
                                            </button>
                                        }
                                    }
                                }

                                @if (picking)
                                {
                                    <button class="opener closer" @onclick="() => TogglePicking(row)" disabled="@_working">
                                        <span class="mono">−</span>
                                        <span>Close</span>
                                        <span class="opener-hint">
                                            @(picker.ChangesAnything ? "nothing is changed until you confirm" : null)
                                        </span>
                                    </button>
                                }
                            }
                            else
                            {
                                <div class="stem-heads">
                                    <span>Sample</span>
                                    <span>Ableton key</span>
                                    <span>Where it is</span>
                                    <span></span>
                                </div>

                                @foreach (var sample in row.Samples)
                                {
                                    <div class="stem">
                                        <span class="stem-label">
                                            @sample.Label
                                            @if (sample.IsPremium is false)
                                            {
                                                <span class="premium-badge" title="The upload offered no premium audio, so this file is the best it had.">not premium</span>
                                            }
                                        </span>
                                        <span class="mono stem-tag @TagTone(sample)">@Tag(sample)</span>
                                        <span class="mono stem-where @(sample.IsInLibrary ? "good" : null)">
                                            @(sample.IsInLibrary ? "Mashup Samples" : "Sample Staging")
                                        </span>
                                        <span class="stem-note">
                                            @if (row.HasSeveralUploads)
                                            {
                                                var added = row.IsAddedSource(sample.SourceVideoId);
                                                var current = sample.SourceVideoId == row.VideoId;

                                                <span class="upload @(added ? "added" : current ? "current" : "superseded")">
                                                    @(added ? "added source" : current ? "new upload" : "old upload")
                                                    <span class="mono">@sample.SourceVideoId</span>
                                                </span>
                                            }
                                        </span>
                                    </div>
                                }

                                @if (row.HasWarpGuide)
                                {
                                    <div class="stem guide">
                                        <span class="stem-label">
                                            Drums <span class="kind">warp guide</span>
                                        </span>
                                        <span class="mono stem-tag dim">—</span>
                                        <span class="mono stem-where">Sample Staging</span>
                                        <span class="stem-note">
                                            for placing markers; deleted after warping
                                        </span>
                                    </div>
                                }

                                <button class="opener" @onclick="() => TogglePicking(row)" disabled="@_working">
                                    <span class="mono">+</span>
                                    <span>Change what is cut</span>
                                    <span class="opener-hint">@OpenerHint(picker)</span>
                                </button>
                            }
                        </div>
                    }

                    <div class="side">
                        @if (picking && _plan is { } confirm)
                        {
                            @if (picker.IsCutInFlight)
                            {
                                <p class="what-next @NextTone(row)">@row.Next</p>

                                <p class="detail">
                                    crateside is cutting this track. A tick is kept straight away;
                                    anything this cut does not make shows as missing once it lands,
                                    and dropping a file waits until then.
                                </p>
                            }
                            else if (confirm.Refusal is { } refusal)
                            {
                                <p class="warning">@refusal</p>
                            }
                            else if (picker.IsAdditive)
                            {
                                <p class="adding">
                                    @("more file".ToQuantity(picker.Adding)). Nothing removed.
                                </p>

                                <p class="detail">
                                    @Cost(confirm.Recipe)
                                    @if (row.Key is { } key)
                                    {
                                        <text>Tagged @Spell(key) from the verdict already in hand, so no quota is spent. </text>
                                    }
                                    @confirm.AudioDetail
                                    @Untouched(picker)
                                </p>
                            }
                            else
                            {
                                <p class="warning">
                                    Removes @("file".ToQuantity(picker.Removing)) from Sample Staging.
                                    @Balance(picker)
                                </p>

                                <p class="detail">
                                    Anything you have done to @(picker.Removing is 1 ? "it" : "them")
                                    in Ableton is lost.
                                    @Cost(confirm.Recipe)
                                    @if (row.Key is { } key)
                                    {
                                        <text>The key stays @Spell(key) — detection does not run again, so no quota is spent. </text>
                                    }
                                    @(confirm.MakesSomething ? confirm.AudioDetail : null)
                                </p>
                            }

                            <div class="actions">
                                @if (confirm.IsPossible && picker.ChangesAnything && !picker.IsCutInFlight)
                                {
                                    <button class="@(picker.IsAdditive ? "primary" : "danger")"
                                            @onclick="() => ConfirmRecut(row)" disabled="@_working">
                                        @(_working ? "Cutting…" : CutLabel(picker))
                                    </button>
                                }
                                <button class="outline" @onclick="CancelPicking" disabled="@_working">
                                    Keep as is
                                </button>
                            </div>
                        }
                        else
                        {
                        <p class="what-next @NextTone(row)">@row.Next</p>
                        <p class="detail">
                            @row.Detail
                            @if (row.CanChangePlan)
                            {
                                <text> @Cost(row.Recipe) Changes apply now — nothing has been made yet.</text>
                            }
                            @if (row.State is TrackState.Short)
                            {
                                <text> Not on disk: @Missing(row). Cutting it is @Cost(row.Recipe)</text>
                            }
                        </p>
                        @if (row.RetryNote is { } retrying)
                        {
                            <p class="detail" title="@row.Retrying?.Error">@retrying</p>
                        }
                        @if (row.Deletions.Count > 0)
                        {
                            <div class="recycled">
                                <span class="recycled-head">Sent to the Recycle Bin by crateside</span>
                                @foreach (var deletion in row.Deletions.Take(RecycledShown))
                                {
                                    <span class="recycled-line">
                                        <span class="mono">@deletion.At.ToLocalTime().ToString("d MMM")</span>
                                        @deletion.FileName
                                        <span class="recycled-why">@deletion.Reason</span>
                                    </span>
                                }
                                @if (row.Deletions.Count > RecycledShown)
                                {
                                    <span class="recycled-why">and @("earlier file".ToQuantity(row.Deletions.Count - RecycledShown))</span>
                                }
                            </div>
                        }

                        <div class="actions">
                            @if (row.Folder is not null)
                            {
                                <button class="outline" @onclick="() => OpenFolder(row)">Open folder</button>
                            }
                            @if (row.Verdict is not null)
                            {
                                <a class="outline" href="@($"song/{row.VideoId}")">Why this key</a>
                            }
                            @if (row.GaveUpAt is not null)
                            {
                                <button class="outline" @onclick="() => Retry(row)">Retry</button>
                            }
                            @if (row.State is TrackState.Short)
                            {
                                <button class="primary" @onclick="() => CutShortfall(row)" disabled="@_working">
                                    @(_working ? "Cutting…" : "Cut what is missing")
                                </button>
                            }
                            @if (Playlist.BumpedVideoId == row.VideoId)
                            {
                                <button class="primary" @onclick="ClearBump">Stop working this first</button>
                            }
                            else if (row.State is TrackState.Queued or TrackState.JudgedInLine)
                            {
                                <button class="outline" @onclick="() => Bump(row)">Work this first</button>
                            }
                            @if (row.PlaylistItemId is { } playlistItemId && Playlist.IsAuthorized)
                            {
                                <button class="outline" @onclick="() => Remove(row, playlistItemId)">
                                    Remove from playlist
                                </button>
                            }
                            else if (row.CanForget && _removing == row.VideoId)
                            {
                                <span class="confirm">@RemovalQuestion()</span>
                                <button class="danger" @onclick="() => ConfirmRemove(row)" disabled="@_working">
                                    Remove
                                </button>
                                <button class="outline" @onclick="CancelRemove" disabled="@_working">Keep</button>
                            }
                            else if (row.CanForget)
                            {
                                <button class="outline" @onclick="() => StartRemove(row)">Remove</button>
                            }
                        </div>
                        }

                        @if (_problem is { } problem)
                        {
                            <p class="problem">@problem</p>
                        }
                    </div>
                </div>
            }
        }
    }

    @if (_toasts.Count > 0 || _consentToast || _removed is not null)
    {
        <div class="toasts">
            @if (_removed is { } removed)
            {
                <div class="toast">
                    <span class="eyebrow">Removed</span>
                    <span class="toast-song">@removed.Title</span>
                    <span class="toast-foot">@removed.Note</span>
                </div>
            }
            @if (_consentToast)
            {
                <div class="toast lapsed">
                    <span class="eyebrow">Playlist access expired</span>
                    <span class="toast-song">crateside cannot empty the playlist</span>
                    <span class="toast-foot">
                        @Lapsed()
                        <a class="show" href="/settings">Refresh access</a>
                    </span>
                </div>
            }
            @foreach (var toast in _toasts)
            {
                <div class="toast">
                    <span class="eyebrow">Ready to warp</span>
                    <span class="toast-song">@toast.Title</span>
                    <span class="mono toast-figure">@Figure(toast)</span>
                    <span class="toast-foot">
                        @Waiting(toast)
                        <a class="show" href="@($"#{Anchor(toast)}")" @onclick="() => Show(toast)">
                            Show row
                        </a>
                    </span>
                </div>
            }
        </div>
    }
</div>

@code {
    private TracksView? _view;
    private TrackFilter _filter = TrackFilter.Unfinished;
    private QuotaSnapshot _quota = QuotaSnapshot.Unknown;

    private const int RecycledShown = 5;

    private const string AdoptNote =
        "crateside writes this file's provenance once, where it is, and the track keeps it. "
        + "Nothing can make it again, so dropping it from the plan later deletes it.";

    private static readonly TimeSpan ToastLife = TimeSpan.FromSeconds(20);

    /// <summary>
    /// How often the lapsed-access toast comes back. Nothing automatic renews the token, so it
    /// is said again rather than once.
    /// </summary>
    private static readonly TimeSpan TellEvery = TimeSpan.FromMinutes(30);

    private DateTimeOffset _consentUntil;

    private static readonly TimeSpan Tick = TimeSpan.FromSeconds(1);

    private string? _expanded;
    private string? _problem;

    private string _search = string.Empty;

    private readonly List<TrackRow> _toasts = [];

    private readonly CancellationTokenSource _circuit = new();

    private System.Threading.Timer? _clock;
    private bool _syncing;
    private bool _working;

    /// <summary>The row whose picker is open, or null when none is.</summary>
    private string? _picking;

    /// <summary>The plan being ticked, which is not recorded until the confirm.</summary>
    private StemPlan _wanted = StemPlan.Default;


    /// <summary>The add-a-track form, which is the second way into the work lists (ADR 0010).</summary>
    private bool _addingTrack;

    private string _trackUrl = string.Empty;
    private AddTrackPlan? _trackPlan;
    private ProbedSource? _trackShortfall;

    private void ToggleAddTrack()
    {
        if (_addingTrack)
        {
            CancelAddTrack();
            return;
        }

        _addingTrack = true;
        _problem = null;
        _focusTrack = true;
    }

    private void CancelAddTrack()
    {
        _addingTrack = false;
        _trackUrl = string.Empty;
        _trackPlan = null;
        _trackShortfall = null;
    }

    private void OnAddTrack(string? url)
    {
        _trackUrl = url ?? string.Empty;
        _trackShortfall = null;
        _trackPlan = Adding.PlanFor(_trackUrl, [.. Rows.Select(row => row.Facts)]);
    }

    /// <summary>Enter does what the button would, so on an upload found wanting it is the acceptance.</summary>
    private async Task OnAddTrackKey(KeyboardEventArgs e)
    {
        if (e.Key is "Escape")
            CancelAddTrack();
        else if (e.Key is "Enter" && _trackPlan?.IsPossible is true)
            await ConfirmAddTrack(anyway: _trackShortfall is not null);
    }

    private async Task ConfirmAddTrack(bool anyway = false)
    {
        _working = true;
        _problem = null;

        try
        {
            var outcome = await Adding.ApplyAsync(
                _trackUrl,
                [.. Rows.Select(row => row.Facts)],
                anyway,
                _circuit.Token
            );

            _problem = outcome.Problem;
            _trackShortfall = outcome.Shortfall;

            if (outcome.Succeeded)
                CancelAddTrack();

            await Source.RefreshAsync(_circuit.Token);
        }
        finally
        {
            _working = false;
        }
    }

    /// <summary>Drops crateside's own record of a pasted track. Nothing on disk is touched.</summary>
    /// <summary>The row asking to be removed, held until the user confirms.</summary>
    private string? _removing;

    private IReadOnlyList<StagingStem> _recycling = [];

    /// <summary>The last track removed, said once because its row is no longer there to say it.</summary>
    private (string Title, string Note)? _removed;

    private void StartRemove(TrackRow row)
    {
        _problem = null;
        _removing = row.VideoId;
        _recycling = Removal.Recycling(row.Facts.Uploads);
    }

    private void CancelRemove()
    {
        _removing = null;
        _recycling = [];
    }

    private string RemovalQuestion() =>
        _recycling.Count is 0
            ? "Drop crateside's record of this track? No file is touched."
            : $"Drop crateside's record and recycle {"staged file".ToQuantity(_recycling.Count)}? "
                + "Nothing in Mashup Samples is touched.";

    private async Task ConfirmRemove(TrackRow row)
    {
        _working = true;

        try
        {
            var outcome = Removal.Apply(row.VideoId, row.Facts.Uploads);

            _removed = (
                row.Title,
                outcome.Problem
                    ?? (
                        outcome.Recycled is 0
                            ? "No file was touched."
                            : $"{"staged file".ToQuantity(outcome.Recycled)} recycled."
                    )
            );
            CancelRemove();

            await Source.RefreshAsync(_circuit.Token);
        }
        finally
        {
            _working = false;
        }

        try
        {
            await Task.Delay(ToastLife, _circuit.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        _removed = null;

        await InvokeAsync(StateHasChanged);
    }
    /// <summary>The row whose add-a-source form is open, or null when none is.</summary>
    private string? _adding;

    private string _addUrl = string.Empty;
    private string _addLabel = string.Empty;
    private AddPlan? _addPlan;

    private SampleType? _addType;

    /// <summary>The row whose adopt-a-file form is open, or null when none is.</summary>
    private string? _adopting;

    private IReadOnlyList<string> _adoptCandidates = [];
    private string? _adoptPath;
    private SampleType? _adoptType;
    private AdoptPlan? _adoptPlan;

    /// <summary>The user picked the type, so the title no longer gets a say.</summary>
    private bool _addTypeChosen;

    /// <summary>The label crateside last filled in, which it may replace; one the user typed it may not.</summary>
    private string? _addLabelOffered;

    /// <summary>The video whose title was last asked for.</summary>
    private string? _titleOf;

    private string? _addTitle;
    private bool _readingTitle;

    /// <summary>What the upload offers, once it has been asked and found wanting.</summary>
    private ProbedSource? _shortfall;

    private RecutPlan? _plan;

    /// <summary>What the separator can make. Read once; empty when it could not be asked.</summary>
    private PresetCatalog _presets = PresetCatalog.Empty;

    private string? _renaming;
    private string _name = string.Empty;

    private ElementReference _nameBox;
    private ElementReference _swapBox;
    private bool _focusName;
    private bool _focusSwap;
    private bool _focusTrack;
    private ElementReference _trackBox;

    private string? _swapping;
    private string _swapUrl = string.Empty;
    private SwapPlan? _swapPlan;

    private IReadOnlyList<TrackRow> Rows => _view?.Rows ?? [];

    /// <summary>Everything answering the search, before the filter narrows it.</summary>
    private IEnumerable<TrackRow> Found => Rows.Where(row => row.Matches(_search));

    private IEnumerable<TrackRow> Shown => Found.Where(row => row.Matches(_filter));

    protected override async Task OnInitializedAsync()
    {
        Source.Changed += OnChanged;
        Source.ReadyToWarp += OnReadyToWarp;
        Separation.Changed += OnChanged;
        Judging.Changed += OnChanged;
        Roll.Changed += OnChanged;

        await Source.EnsureFreshAsync(TimeSpan.FromSeconds(30));

        _view = Source.Current;
        _quota = await Quota.ReadAsync();
        _presets = await Presets.ReadAsync(_circuit.Token);

        _clock = new System.Threading.Timer(_ => Redraw(), null, Tick, Tick);
    }

    private bool _consentToast => DateTimeOffset.UtcNow < _consentUntil;

    /// <summary>How long access has been lapsed, for the toast to say.</summary>
    private string Lapsed() =>
        Access.LapsedAt is { } at
            ? $"expired {(DateTimeOffset.UtcNow - at).Humanize()} ago"
            : "expired";

    private void Redraw()
    {
        if (_circuit.IsCancellationRequested)
            return;

        // On the clock the page already runs, so a lapse that began while this page was open
        // still surfaces without a second timer.
        if (!_consentToast && Access.ShouldTell(TellEvery))
            _consentUntil = DateTimeOffset.UtcNow + ToastLife;

        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task Resync()
    {
        _syncing = true;

        try
        {
            Playlist.Invalidate();

            await Source.RefreshAsync(_circuit.Token);
        }
        finally
        {
            _syncing = false;
        }
    }

    private string Synced =>
        _view?.ReadAt is not { } read ? "playlist not read yet"
        : DateTimeOffset.UtcNow - read is { TotalMinutes: < 1 } ? "playlist synced just now"
        : $"playlist synced {(DateTimeOffset.UtcNow - read).Humanize(minUnit: TimeUnit.Minute)} ago";

    public void Dispose()
    {
        Source.Changed -= OnChanged;
        Source.ReadyToWarp -= OnReadyToWarp;
        Separation.Changed -= OnChanged;
        Judging.Changed -= OnChanged;
        Roll.Changed -= OnChanged;

        _clock?.Dispose();

        _circuit.Cancel();
        _circuit.Dispose();
    }

    private void OnReadyToWarp(TrackRow row)
    {
        _toasts.Insert(0, row);
        _ = InvokeAsync(StateHasChanged);
        _ = Dismiss(row);
    }

    private async Task Dismiss(TrackRow row)
    {
        try
        {
            await Task.Delay(ToastLife, _circuit.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        _toasts.Remove(row);

        await InvokeAsync(StateHasChanged);
    }

    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? string.Empty;

    private void ClearSearch() => _search = string.Empty;

    private void Show(TrackRow row)
    {
        // All, and no search, because the anchor has to be in the list for the browser to reach it.
        _filter = TrackFilter.All;
        _search = string.Empty;
        _expanded = row.VideoId;
        _problem = null;

        _toasts.Remove(row);
    }

    private static string Anchor(TrackRow row) => $"track-{row.VideoId}";

    private static string Figure(TrackRow row) =>
        string.Join(
            " · ",
            new[] { Spell(row.Key), row.Bpm?.ToString("N0") }.OfType<string>()
        );

    private static string Waiting(TrackRow row) =>
        $"{"sample".ToQuantity(row.Samples.Count(sample => !sample.IsInLibrary))} in Sample Staging, key-tagged.";

    // Raised on a worker thread, never the circuit's, so the render is marshalled back.
    private void OnChanged()
    {
        _view = Source.Current;
        _ = InvokeAsync(StateHasChanged);
    }

    private void Expand(TrackRow row)
    {
        _expanded = _expanded == row.VideoId ? null : row.VideoId;
        _problem = null;

        CancelPicking();
        CancelRename();
    }

    /// <summary>
    /// A box that has just opened takes the cursor — after the render, since an element cannot be
    /// focused before it exists.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusName)
        {
            _focusName = false;

            await _nameBox.FocusAsync();
        }

        if (_focusSwap)
        {
            _focusSwap = false;

            await _swapBox.FocusAsync();
        }

        if (_focusTrack)
        {
            _focusTrack = false;

            await _trackBox.FocusAsync();
        }
    }

    /// <summary>Opens the rename box and closes the swap box, which shares the row (#19).</summary>
    private void StartRename(TrackRow row)
    {
        _problem = null;
        CancelSwap();
        _renaming = row.VideoId;
        _name = row.Title;
        _focusName = true;
    }

    private void CancelRename()
    {
        _renaming = null;
        _name = string.Empty;
    }

    private async Task ConfirmRename(TrackRow row)
    {
        if (!StemFileName.IsUsable(_name))
            return;

        await Renaming(() => Rename.Apply(row.VideoId, _name));
    }

    private async Task RevertRename(TrackRow row) =>
        await Renaming(() => Rename.Revert(row.VideoId, row.DerivedTitle ?? row.Title));

    private async Task Renaming(Func<RenameOutcome> rename)
    {
        _working = true;
        _problem = null;

        try
        {
            var outcome = rename();

            _problem = outcome.Problem ?? outcome.Note;

            if (outcome.Succeeded)
                CancelRename();

            await Source.RefreshAsync(_circuit.Token);
        }
        finally
        {
            _working = false;
        }
    }

    private async Task OnRenameKey(KeyboardEventArgs e, TrackRow row)
    {
        if (e.Key is "Enter")
            await ConfirmRename(row);
        else if (e.Key is "Escape")
            CancelRename();
    }

    private void StartSwap(TrackRow row)
    {
        _problem = null;
        CancelRename();
        _swapping = row.VideoId;
        _swapUrl = string.Empty;
        _swapPlan = null;
        _focusSwap = true;
    }

    private void CancelSwap()
    {
        _swapping = null;
        _swapUrl = string.Empty;
        _swapPlan = null;
    }

    /// <summary>Re-plans as the URL is typed, so the button says what it would do.</summary>
    private void OnSwapUrl(TrackRow row, ChangeEventArgs e)
    {
        _swapUrl = e.Value?.ToString() ?? string.Empty;
        _swapPlan = _swapUrl.Length is 0 ? null : Swap.PlanFor(row.VideoId, _swapUrl);
    }

    private async Task OnSwapKey(KeyboardEventArgs e, TrackRow row)
    {
        if (e.Key is "Enter")
            await ConfirmSwap(row);
        else if (e.Key is "Escape")
            CancelSwap();
    }

    private async Task ConfirmSwap(TrackRow row)
    {
        _working = true;
        _problem = null;

        try
        {
            var outcome = await Swap.ApplyAsync(row.VideoId, _swapUrl, _circuit.Token);

            _problem = outcome.Problem;

            if (outcome.Succeeded)
            {
                CancelSwap();
                Signals.Wake(JobStage.Download, JobStage.Separation);
            }

            await Source.RefreshAsync(_circuit.Token);
        }
        finally
        {
            _working = false;
        }
    }

    /// <summary>Accepts this download's audio, so the track goes on to the verdict.</summary>
    private async Task UseAnyway(TrackRow row)
    {
        _working = true;
        _problem = null;

        try
        {
            if (!Held.AcceptAcquisition(row.VideoId))
                _problem = "There is no downloaded audio for this track any more, so it will be fetched again.";

            // Judging is paused by default, so this only puts the track back in line for it.
            Judging.Wake();

            await Source.RefreshAsync(_circuit.Token);
        }
        finally
        {
            _working = false;
        }
    }

    private static string SwapScope(SwapPlan? plan) =>
        plan?.Removing is { Count: > 0 } removing
            ? $"Swap source · remove {"file".ToQuantity(removing.Count)}"
            : "Swap source";

    private static string Derived(TrackRow row) => row.DerivedTitle ?? row.Title;

    private static string From(TrackNameSource source) =>
        source switch
        {
            TrackNameSource.Files => "the file names",
            TrackNameSource.Ledger => "the ledger",
            TrackNameSource.Resolved => "what StemForge will call it",
            TrackNameSource.Playlist => "the playlist title",
            _ => "the video ID",
        };

    /// <summary>
    /// The track's files as lines to tick, against the plan being edited or its own.
    /// </summary>
    private StemPicker PickerFor(TrackRow row) =>
        StemPicker.For(row, _presets, _picking == row.VideoId ? _wanted : null);

    /// <summary>
    /// Opens the picker, or shuts it again. Looking is not the start of anything.
    /// </summary>
    private void TogglePicking(TrackRow row)
    {
        _problem = null;

        if (_picking == row.VideoId)
        {
            CancelPicking();
            return;
        }

        _picking = row.VideoId;
        _wanted = row.Plan;
        _plan = null;

        CancelRename();
        CancelSwap();
    }

    private void CancelPicking()
    {
        _picking = null;
        _wanted = StemPlan.Default;
        _plan = null;

        CancelAdding();
    }

    private void StartAdding(TrackRow row)
    {
        CancelAdding();
        CancelAdopting();

        _problem = null;
        _adding = row.VideoId;
    }

    /// <summary>What an added source is, said where the boxes to describe one are.</summary>
    private static string AddNote(TrackRow row) =>
        "Another file of this song, kept whole and never separated. keytag records it as this "
        + "song so it stages beside the stems"
        + (row.Key is { } key ? $" and takes the key, {Spell(key)}." : ", and takes the key once this track has one.")
        + " No quota, no GPU.";

    private void CancelAdding()
    {
        _adding = null;
        _addUrl = string.Empty;
        _addLabel = string.Empty;
        _addPlan = null;
        _shortfall = null;
        _addType = null;
        _addTypeChosen = false;
        _addLabelOffered = null;
        _titleOf = null;
        _addTitle = null;
        _readingTitle = false;
    }

    private void StartAdopting(TrackRow row)
    {
        CancelAdding();
        CancelAdopting();

        _problem = null;
        _adopting = row.VideoId;
        _adoptCandidates = Adoption.Candidates();
    }

    private void CancelAdopting()
    {
        _adopting = null;
        _adoptCandidates = [];
        _adoptPath = null;
        _adoptType = null;
        _adoptPlan = null;
    }

    private void OnAdopt(TrackRow row, string? path)
    {
        _adoptPath = path is { Length: > 0 } ? path : null;
        _adoptType = SampleTypes.InferredFrom(StemFileName.PresetOf(_adoptPath ?? string.Empty));
        _adoptPlan = Adoption.PlanFor(row.Facts, _adoptPath, _adoptType);
    }

    private void ChooseAdoptType(TrackRow row, SampleType type)
    {
        _adoptType = type;
        _adoptPlan = Adoption.PlanFor(row.Facts, _adoptPath, _adoptType);
    }

    private async Task ConfirmAdopt(TrackRow row)
    {
        _working = true;

        try
        {
            _problem = Adoption.Apply(row.Facts, _adoptPath, _adoptType);

            if (_problem is null)
                CancelAdopting();

            await Source.RefreshAsync(_circuit.Token);
        }
        finally
        {
            _working = false;
        }
    }

    /// <summary>Re-reads what adding would do on every keystroke, so the refusal arrives early.</summary>
    private void OnAdd(TrackRow row, string? url = null, string? label = null)
    {
        _addUrl = url ?? _addUrl;
        _addLabel = label ?? _addLabel;
        _shortfall = null;

        if (YouTubeUrl.TryGetVideoId(_addUrl, out var videoId) && videoId != _titleOf)
            _ = ReadTitleAsync(row, videoId);

        Replan(row);
    }

    private void ChooseType(TrackRow row, SampleType type)
    {
        _addTypeChosen = true;
        Offer(type);
        Replan(row);
    }

    /// <summary>Suggests a type from what the upload is called, until the user has picked one.</summary>
    private async Task ReadTitleAsync(TrackRow row, string videoId)
    {
        _titleOf = videoId;
        _addTitle = null;
        _readingTitle = true;

        if (!_addTypeChosen)
            _addType = null;

        string? title;

        try
        {
            title = await Sources.TitleOfAsync(videoId, _circuit.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        // The URL moved on while this was being asked.
        if (_titleOf != videoId || _adding != row.VideoId)
            return;

        _readingTitle = false;
        _addTitle = title;

        if (!_addTypeChosen && SampleTypes.InferredFrom(title) is { } inferred)
            Offer(inferred);

        Replan(row);
        await InvokeAsync(StateHasChanged);
    }

    private void Offer(SampleType type)
    {
        _addType = type;

        if (_addLabel.Length > 0 && _addLabel != _addLabelOffered)
            return;

        _addLabel = SampleTypes.LabelFor(type);
        _addLabelOffered = _addLabel;
    }

    private void Replan(TrackRow row) =>
        _addPlan = Sources.PlanFor(row.Facts, _addUrl, _addLabel, _addType);

    private string? TitleNote =>
        _readingTitle ? "Reading the upload's title…"
        : _addTitle is not { } title ? null
        : _addTypeChosen || _addType is null ? $"“{title}”"
        : $"“{title}”, so {_addType} is suggested";

    /// <summary>
    /// Adds the source, or comes back with what the upload actually offers before anything is
    /// fetched (ADR 0019).
    /// </summary>
    private async Task ConfirmAdd(TrackRow row, bool anyway = false)
    {
        _working = true;
        _problem = null;

        try
        {
            var outcome = await Sources.ApplyAsync(
                row.Facts,
                _addUrl,
                _addLabel,
                _addType,
                anyway,
                _circuit.Token
            );

            _problem = outcome.Problem;
            _shortfall = outcome.Shortfall;

            if (outcome.Succeeded)
            {
                CancelPicking();
                Signals.Wake(JobStage.Download);
            }

            await Source.RefreshAsync(_circuit.Token);
        }
        finally
        {
            _working = false;
        }
    }

    /// <summary>
    /// Ticks one line: recorded at once before separation, only proposed after it, when the
    /// confirm is what spends anything.
    /// </summary>
    private async Task Toggle(TrackRow row, StemChoice line)
    {
        if (line.IsPinned)
            return;

        if (row.IsCutInFlight)
        {
            await ToggleInFlight(row, line);

            return;
        }

        var plan = _picking == row.VideoId ? _wanted : row.Plan;

        var wanted = line switch
        {
            // Unticking an added source drops it from the plan; there is nothing to re-fetch,
            // so it is never ticked back on from here.
            { AddedSource: { } added } => plan.Dropping(added.Label),
            { Kind: StemKind.Source } => plan.TogglingSource(),
            _ => plan.Toggling(line.PresetId!),
        };

        if (row.CanChangePlan)
        {
            // Nothing has been made, so there is nothing to confirm and nothing to lose.
            Playlist.SetPlan(row.VideoId, wanted);

            // Producing what was just ticked is a copy or a fetch, not a wait: without this the
            // stage is part-way through a two-minute idle delay and would not look again (#48).
            Signals.Wake(JobStage.Download, JobStage.Separation);

            await Source.RefreshAsync(_circuit.Token);

            return;
        }

        _wanted = wanted;

        // Only once a tick has actually moved: until then there is nothing to confirm and the
        // side column has no business offering to.
        // A short track has something to confirm even when the plan is unchanged: making up the
        // shortfall is a re-cut of its own (#38).
        _plan =
            wanted.AsksTheSameAs(row.Plan) && !row.IsShort ? null
            : Recut.PlanFor(row.VideoId, wanted, _presets, row.Inventory);
    }

    /// <summary>
    /// Records a tick on a track already in a cut and makes nothing; an untick waits, since the
    /// separator may be writing that very file (ADR 0027).
    /// </summary>
    private async Task ToggleInFlight(TrackRow row, StemChoice line)
    {
        _problem = null;

        if (line.IsWanted)
        {
            _problem = "crateside is cutting this track. You can drop files once it has finished.";

            return;
        }

        var wanted = line switch
        {
            { Kind: StemKind.Source } => row.Plan.TogglingSource(),
            _ => row.Plan.Toggling(line.PresetId!),
        };

        Playlist.SetPlan(row.VideoId, wanted);

        _wanted = wanted;
        _plan = null;

        // A kept source is a copy the download stage makes whatever the GPU is doing.
        Signals.Wake(JobStage.Download);

        await Source.RefreshAsync(_circuit.Token);
    }

    private async Task ConfirmRecut(TrackRow row)
    {
        _working = true;
        _problem = null;

        try
        {
            var outcome = Recut.Apply(row.VideoId, _wanted, _presets, row.Inventory);

            _problem = outcome.Problem;

            if (outcome.Succeeded)
                CancelPicking();

            // A worker part-way through its two-minute idle wait would not look again.
            Signals.Wake(JobStage.Download, JobStage.Separation);

            await Source.RefreshAsync(_circuit.Token);
        }
        finally
        {
            _working = false;
        }
    }

    /// <summary>Makes what the plan already asks for and disk lacks, leaving the plan as it is.</summary>
    private async Task CutShortfall(TrackRow row)
    {
        _working = true;
        _problem = null;

        try
        {
            _problem = Recut.Apply(row.VideoId, row.Plan, _presets, row.Inventory).Problem;

            Signals.Wake(JobStage.Separation);

            await Source.RefreshAsync(_circuit.Token);
        }
        finally
        {
            _working = false;
        }
    }

    private string Missing(TrackRow row) =>
        string.Join(
            ", ",
            row.Shortfall.Presets.Select(id => _presets.ById(id)?.DisplayName ?? id)
        );

    /// <summary>What the opener says it would let you reach, without opening it.</summary>
    private static string OpenerHint(StemPicker picker)
    {
        var unmade = picker.Lines.Count(line =>
            line is { State: StemState.NotMade, Kind: StemKind.Preset }
        );

        return unmade is 0
            ? "the source track"
            : $"{"more preset".ToQuantity(unmade)}, the source track";
    }

    /// <summary>The mark in a line's first cell: a tick, an empty box, or a pinned dot.</summary>
    private static string TickMark(StemChoice line) =>
        line switch
        {
            { Kind: StemKind.WarpGuide } => "●",
            { Kind: StemKind.Unrecognised } => "✓",
            { IsWanted: true } => "✓",
            _ => string.Empty,
        };

    private static string? TickTone(StemChoice line) =>
        line switch
        {
            { IsPinned: true } => "pinned",
            { State: StemState.Coming } => "coming",
            { State: StemState.Going } => "going",
            { IsWanted: true } => "on",
            _ => null,
        };

    private static string? LineTone(StemChoice line) =>
        line switch
        {
            { Kind: StemKind.WarpGuide } => "guide",
            { Kind: StemKind.Unrecognised } => "unrecognised",
            { State: StemState.Coming } => "coming",
            { State: StemState.Going } => "going",
            { State: StemState.NotMade } => "unmade",
            _ => null,
        };

    /// <summary>
    /// The key cell: what Ableton holds, or what the file would be tagged with. A library file
    /// with no key reads <c>—</c>, since nobody asked (ADR 0003).
    /// </summary>
    private static string Tag(StemChoice line, TrackRow row) =>
        (line, row.Key) switch
        {
            ({ AbletonKey: { } tagged }, _) => Spell(tagged) ?? tagged,
            ({ IsInLibrary: true }, _) => "—",
            ({ State: StemState.Coming }, { } key) => Spell(key) ?? key,
            ({ State: StemState.Kept }, _) => "untagged",
            _ => "—",
        };

    /// <summary>
    /// A coming line in flight says only "coming", since nothing records whether the running cut
    /// has it.
    /// </summary>
    private static string Where(StemChoice line, StemPicker picker) =>
        line switch
        {
            { State: StemState.Coming } => picker.IsCutInFlight ? "coming" : "new",
            { State: StemState.Going } => "removed",
            { State: StemState.NotMade, Kind: StemKind.Source } => "not kept",
            { State: StemState.NotMade } => "not made",
            { IsInLibrary: true } => "Mashup Samples",
            _ => "Sample Staging",
        };

    private static string? WhereTone(StemChoice line) =>
        line switch
        {
            { State: StemState.Coming } => "new",
            { State: StemState.Going } => "gone",
            { State: StemState.NotMade } => "dim",
            { IsInLibrary: true } => "good",
            _ => null,
        };

    private static string? Note(StemChoice line, TrackRow row) =>
        line switch
        {
            { State: StemState.Going } => "deleted from Sample Staging, with its .asd",
            { Kind: StemKind.WarpGuide, IsOnDisk: true } => "already cut — no new guide is made",
            { Kind: StemKind.WarpGuide, IsWanted: true } => "cut alongside the new files",
            { Kind: StemKind.WarpGuide } => "nothing is being made, so no guide is needed",
            { IsInLibrary: true, State: StemState.Kept } => "in Mashup Samples — not crateside's to remove",
            { Kind: StemKind.Unrecognised } => line.Description,
            { State: StemState.Kept } when row.HasSeveralUploads => string.Join(
                " · ",
                line.Uploads
            ),
            { State: StemState.Kept } => "kept",
            // A preset's description is nine lines of wrapped text across the panel; it reads
            // on hover instead, where it is wanted only once.
            { Kind: StemKind.Preset } => null,
            _ => line.Description,
        };

    /// <summary>What the button does, named by what it costs.</summary>
    private static string CutLabel(StemPicker picker) =>
        picker switch
        {
            { IsAdditive: true } => $"Cut {"more file".ToQuantity(picker.Adding)}",
            { Adding: 0 } => $"Remove {"file".ToQuantity(picker.Removing)}",
            _ => $"Cut {picker.Adding} · remove {picker.Removing}",
        };

    /// <summary>How many of the ticked lines survive untouched.</summary>
    private static string Balance(StemPicker picker) =>
        $"{picker.Adding} new, {picker.Keeping} kept.";

    private static string Untouched(StemPicker picker) =>
        picker.Keeping is 0
            ? string.Empty
            : $"The {"file".ToQuantity(picker.Keeping)} already in Sample Staging "
                + $"{(picker.Keeping is 1 ? "is" : "are")} untouched.";

    /// <summary>What the GPU is being asked for, or nothing where it is not being asked.</summary>
    private static string Cost(SeparationRecipe recipe) =>
        recipe.Passes is 0
            ? string.Empty
            : $"{"pass".ToQuantity(recipe.Passes)} on the GPU, about {recipe.Estimate.Humanize()}.";

    private void OpenFolder(TrackRow row)
    {
        if (row.Folder is not { } folder)
            return;

        try
        {
            Process.Start(new ProcessStartInfo(folder) { UseShellExecute = true });
        }
        catch (Exception e)
        {
            _problem = $"Could not open {folder}: {e.Message}";
        }
    }

    /// <summary>
    /// Waiting is the only time this means anything: once a stage has the track, the work lists
    /// have already been read.
    /// </summary>
    private async Task Bump(TrackRow row)
    {
        Playlist.Bump(row.VideoId);

        await Source.RefreshAsync(_circuit.Token);
    }

    private async Task ClearBump()
    {
        Playlist.ClearBump();

        await Source.RefreshAsync(_circuit.Token);
    }

    private async Task Retry(TrackRow row)
    {
        List<JobStage> forgiven = [];

        foreach (var stage in Enum.GetValues<JobStage>())
            if (Jobs.TryGet(row.VideoId, stage, out var job) && job is { Status: JobStatus.Failed })
            {
                Jobs.Forgive(row.VideoId, stage);
                forgiven.Add(stage);
            }

        // Every stage was forgivable, so waking only two left the rest to wait out the interval.
        Signals.Wake([.. forgiven]);

        await Source.RefreshAsync();
    }

    private async Task Remove(TrackRow row, string playlistItemId)
    {
        _problem = null;

        try
        {
            var results = await Playlist.RemoveAsync(
                [
                    new QueueItem
                    {
                        PlaylistItemId = playlistItemId,
                        VideoId = row.VideoId,
                        Title = row.Title,
                    },
                ]
            );

            _problem = results.FirstOrDefault(result => !result.Removed)?.Reason;

            await Source.RefreshAsync();
        }
        catch (QueueUnavailableException e)
        {
            _problem = e.Message;
        }
    }

    private static string StemsHeading(TrackRow row) =>
        row.Folder is { } folder
            ? $"Stems · {Path.GetFileName(folder)} / {row.Title}"
            : $"Stems · {row.Title}";

    // The key Ableton holds, never the verdict's — on a row where they disagree, the verdict
    // with a tick beside it would say the opposite of what is true.
    private static string Tag(TrackSample sample) =>
        sample switch
        {
            { AbletonKey: { } key } => $"{Spell(key)} ✓",
            { IsInLibrary: true } => "—",
            _ => "not tagged",
        };

    // Dim, not red: nothing read this file's tag, so "not tagged" would be a claim (ADR 0003).
    private static string TagTone(TrackSample sample) =>
        sample switch
        {
            { IsKeyTagged: true } => "good",
            { IsInLibrary: true } => "dim",
            _ => "bad",
        };

    private void ToggleSeparation()
    {
        if (Separation.IsPaused)
            Separation.Resume();
        else
            Separation.Pause();
    }

    private void ToggleJudging()
    {
        if (Judging.IsPaused)
            Judging.Resume();
        else
            Judging.Pause();
    }

    private void ToggleRoll()
    {
        if (Roll.IsEnabled)
            Roll.Disable();
        else
            Roll.Enable();
    }

    private TrackRow? RowIn(TrackState state) => Rows.FirstOrDefault(row => row.State == state);

    private int Waiting(TrackState state) => Rows.Count(row => row.State == state);

    private static string Elapsed(DateTimeOffset since)
    {
        var span = DateTimeOffset.UtcNow - since;

        return span.TotalHours >= 1
            ? $"{(int)span.TotalHours}:{span.Minutes:00}:{span.Seconds:00}"
            : $"{(int)span.TotalMinutes}:{span.Seconds:00}";
    }

    private static string Name(TrackFilter filter) =>
        filter switch
        {
            TrackFilter.InStaging => "In staging",
            TrackFilter.InFlight => "In flight",
            TrackFilter.NeedsAttention => "Needs attention",
            _ => filter.ToString(),
        };

    private static string Tone(TrackFilter filter) =>
        filter switch
        {
            TrackFilter.InStaging => "amber",
            TrackFilter.InFlight => "teal",
            TrackFilter.NeedsAttention => "red",
            _ => "plain",
        };

    private static string ChipClass(TrackChipStyle style) =>
        style switch
        {
            TrackChipStyle.TealFilled => "teal-filled",
            TrackChipStyle.TealOutline => "teal-outline",
            TrackChipStyle.AmberFilled => "amber-filled",
            TrackChipStyle.RedOutline => "red-outline",
            TrackChipStyle.RedFilled => "red-filled",
            TrackChipStyle.GreenOutline => "green-outline",
            TrackChipStyle.DashedOutline => "dashed-outline",
            _ => "neutral-outline",
        };

    private static string NextTone(TrackRow row) =>
        row.State switch
        {
            TrackState.ReadyToWarp => "amber",
            TrackState.Parked or TrackState.GaveUp or TrackState.Short => "attention",
            _ => string.Empty,
        };

    private static string Confidence(KeyConfidence confidence) =>
        confidence is KeyConfidence.Unknown ? "—" : confidence.ToString().ToUpperInvariant();

    private static string ConfidenceTone(KeyConfidence confidence) =>
        confidence switch
        {
            KeyConfidence.High => "high",
            KeyConfidence.Medium => "medium",
            KeyConfidence.Low or KeyConfidence.Withheld => "weak",
            _ => "none",
        };

    // The ledger spells keys in ASCII so they survive a filename. The screen is not one.
    private static string? Spell(string? key) =>
        key?.Replace("#", "♯", StringComparison.Ordinal)
            .Replace(" major", " maj", StringComparison.Ordinal)
            .Replace(" minor", " min", StringComparison.Ordinal);
}
