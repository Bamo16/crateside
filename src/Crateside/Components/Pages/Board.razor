@page "/"
@using Crateside.Core.Ledger
@using Crateside.Core.Staging
@inject StagingBoardService BoardService
@inject EvidenceService Evidence
@rendermode InteractiveServer

<PageTitle>Staging board — crateside</PageTitle>

<header class="board-header">
    <div>
        <h1>Staging board</h1>
        <p class="subtitle">What is in front of me right now.</p>
    </div>
    <button class="refresh" @onclick="Refresh" disabled="@_reading">
        @(_reading ? "Reading…" : "Refresh")
    </button>
</header>

@if (_songs is null)
{
    <p class="empty">Reading the staging folder…</p>
}
else if (_songs.Count == 0)
{
    <p class="empty">
        Nothing staged. <code>@BoardService.StagingRoot</code> holds no stems — everything has been
        worked and moved out, which is what an empty board means.
    </p>
}
else
{
    <p class="summary">
        @("song".ToQuantity(_songs.Count)),
        @("stem".ToQuantity(_songs.Sum(s => s.Stems.Count))) —
        @_songs.Count(s => s.IsFullyTagged) fully tagged.
    </p>

    <table class="board">
        <thead>
            <tr>
                <th>Song</th>
                <th>Key</th>
                <th class="bpm">BPM</th>
                <th>Stems</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var song in _songs)
            {
                <tr class="@(song.IsFullyTagged ? "done" : null)">
                    <td>
                        @if (song.Verdict is not null)
                        {
                            @* Expanding is the cheap look; the page is the full record. Only
                               offered where there is a run to show. *@
                            <button class="song-name expander" @onclick="() => Toggle(song)"
                                    title="Show why this key was given">
                                <span class="caret">@(IsExpanded(song) ? "▾" : "▸")</span>
                                @song.DisplayName
                            </button>
                        }
                        else
                        {
                            <span class="song-name">@song.DisplayName</span>
                        }
                        @if (song.StaleTaggedStems.Count > 0)
                        {
                            <span class="flag stale"
                                  title="Tagged in Ableton with a key that is not the current verdict — a supersede left it behind.">
                                stale tag
                            </span>
                        }
                    </td>
                    <td>
                        @if (song.Key is { } key)
                        {
                            <a class="key" href="@($"partners?key={Uri.EscapeDataString(key)}")"
                               title="Find partners for @key">@key</a>
                            <span class="confidence @song.Confidence.ToString().ToLowerInvariant()">
                                @song.Confidence.ToString().ToUpperInvariant()
                            </span>
                        }
                        else if (song.AwaitingDetection)
                        {
                            <span class="muted">not detected</span>
                        }
                        else
                        {
                            <span class="muted" title="detect-key ran and declined to give a single safe tag.">
                                no safe tag
                            </span>
                        }
                    </td>
                    @* Rounded: the BPM is a warp starting point good to ±2-3, so a decimal
                       is false precision and it misaligns the column against whole values. *@
                    <td class="bpm">
                        @(song is { Bpm: { } bpm } ? Math.Round(bpm).ToString("0") : "—")
                    </td>
                    <td>
                        <ul class="stems">
                            @foreach (var stem in song.Stems)
                            {
                                <li class="@StemClass(stem)" title="@stem.FileName">
                                    <span class="mark">@(stem.IsKeyTagged ? "✓" : "○")</span>
                                    @stem.Label
                                    @if (stem.HasPartialKey)
                                    {
                                        <span class="flag partial" title="Tagged with a tonic but no Major/Minor keyword — half a key.">
                                            half
                                        </span>
                                    }
                                    else if (stem.KeyDisagreesWithVerdict)
                                    {
                                        <span class="flag stale" title="@($"Ableton has {stem.AbletonKey}.")">
                                            @stem.AbletonKey
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    </td>
                </tr>
                @if (IsExpanded(song))
                {
                    <tr class="evidence-row">
                        <td colspan="4">
                            @if (_expandedRun is { } run)
                            {
                                <Evidence Run="run" />
                                @if (song.SourceVideoId is { Length: > 0 } videoId)
                                {
                                    <a class="full-record" href="@($"song/{videoId}")">
                                        Open the full record →
                                    </a>
                                }
                            }
                            else
                            {
                                <p class="muted">No run recorded for this song.</p>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<StagingSong>? _songs;
    private bool _reading;

    // One at a time: the panel is tall, and several open at once turns the board into a wall
    // of evidence, which is the thing the board exists to avoid.
    private string? _expandedSong;
    private RunEvidence? _expandedRun;

    protected override void OnInitialized() => Refresh();

    private void Refresh()
    {
        _reading = true;

        try
        {
            _songs = BoardService.Read();
        }
        finally
        {
            _reading = false;
        }
    }

    private bool IsExpanded(StagingSong song) =>
        song.Verdict is { Song: { } identity } && identity == _expandedSong;

    private void Toggle(StagingSong song)
    {
        if (song.Verdict is not { Song: { } identity })
            return;

        if (identity == _expandedSong)
        {
            (_expandedSong, _expandedRun) = (null, null);

            return;
        }

        // Read on expand rather than with the board: the machine block is the bulk of every
        // ledger line, and a board of ten songs would pay for ten of them to show none.
        (_expandedSong, _expandedRun) = (identity, Evidence.ForSong(identity));
    }

    private static string StemClass(StagingStem stem) =>
        stem switch
        {
            { HasPartialKey: true } => "stem partial",
            { KeyDisagreesWithVerdict: true } => "stem stale",
            { IsKeyTagged: true } => "stem tagged",
            _ => "stem untagged",
        };
}
