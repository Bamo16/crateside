@page "/tools"
@layout Crateside.Components.Layout.BareLayout
@rendermode InteractiveServer
@implements IAsyncDisposable

@using Crateside.Components.Tools
@using Crateside.Core.Familiarity
@using Crateside.Core.Ledger
@using Crateside.Core.Library
@using Crateside.Core.Pairing
@using Crateside.Core.Tracks

@inject LibrarySummary Library
@inject FamiliarityStore FamiliarityRecords
@inject TracksService Tracks
@inject ToolsMemory Memory
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>Tools · crateside</PageTitle>

<PageHeader Active="BrandNav.Tab.Tools" Shape="PageHeader.Shapes.Bar" />

<div class="body">
    <header class="page-header">
        <h1>Tools</h1>
        <p class="subtitle">Small helpers for building a mashup, used on the spot, all working from one track.</p>
    </header>

    <div class="columns">
        <div class="col working-col">
            <WorkingOn Track="_track" Songs="Warped" Familiarity="@TrackFamiliarity" DetailsHref="@DetailsHref"
                       Centre="Picked" BpmText="@_bpmText"
                       OnPick="Pick" OnCentre="PickCentre" OnBpm="TypeBpm" />
        </div>

        <div class="col tools-col">
            @if (_rePitchOpen)
            {
                <RePitchTool Centre="Own" Tempo="Tempo" IsTrack="_track is not null"
                             Shift="_shift" OnShift="ChooseShift"
                             Max="_rePitchMax" OnMax="max => Change(() => { _rePitchMax = max; _shift = Math.Clamp(_shift, -max, max); })"
                             OnToggle="ToggleRePitch" />
            }
            else
            {
                <button class="folded-tool" @onclick="ToggleRePitch">
                    <span class="mono chevron">▸</span>
                    <strong>Re-Pitch</strong>
                    @if (_shift is not 0 && Shown is { } shown)
                    {
                        <span>
                            <span class="mono">@MashupPartner.FormatShift(_shift)</span>
                            @if (Tempo is { } tempo)
                            {
                                <text> · </text><span class="mono">@TempoFormat.Format(tempo.Shifted(_shift)).Text</span><text> BPM</text>
                            }
                            · @ModeText.Named(shown), sent to Partners
                        </span>
                    }
                    else
                    {
                        <span class="quiet">no shift chosen</span>
                    }
                </button>
            }

            <PartnersTool Own="Own" Shift="_shift" Centre="Shown" Mixed="Mixed" IsTrack="_track is not null"
                          HasVerdict="_track?.Run?.Centre is not null"
                          Sections="Sections" Primary="Primary" Section="_section"
                          OnSection="ChooseSection"
                          Partners="_partners" Lowest="_lowest" Highest="_highest"
                          OnSpan="ChooseSpan"
                          OnBack="() => Change(() => _shift = 0)">
                <Wheel>
                    <CamelotWheel Working="WheelWorking" Own="WheelOwn" Partners="_partners" />
                </Wheel>
            </PartnersTool>
        </div>

        <div class="col wheel-col">
            <span class="caps">Camelot wheel</span>
            <CamelotWheel Working="WheelWorking" Own="WheelOwn" Partners="_partners" />
            <div class="legend">
                <span><i class="swatch working"></i>working from</span>
                <span><i class="swatch near"></i>mixes as is</span>
                <span><i class="swatch far"></i>a shift away</span>
                <span><i class="swatch own"></i>where you started</span>
                <span class="note">Outer ring major (B), inner ring minor (A). A neighbour on the wheel is a fifth; straight in or out is the relative.</span>
            </div>
        </div>
    </div>
</div>

@code {
    private const string RePitchCookie = "crateside.tools.repitch";

    private LibrarySong? _track;
    private TonalCentre? _hand;
    private int? _section;
    private string _bpmText = string.Empty;
    private int _shift;
    private int _lowest;
    private int _highest;
    private bool _rePitchOpen = true;
    private int _rePitchMax = Core.Pairing.RePitch.DefaultMaxShift;
    private IReadOnlyList<MashupPartner> _partners = [];
    private IJSObjectReference? _module;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>Whether Re-Pitch is folded, read from the cookie while prerendering, so the first paint is already right.</summary>
    [PersistentState]
    public bool? RePitchFolded { get; set; }

    [SupplyParameterFromQuery(Name = "track")]
    public string? TrackFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "key")]
    public string? KeyFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "bpm")]
    public string? BpmFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "shift")]
    public int? ShiftFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "lo")]
    public int? LowestFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "hi")]
    public int? HighestFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "section")]
    public int? SectionFromQuery { get; set; }

    private IReadOnlyList<LibrarySong> Warped =>
        [.. Library.Current.Songs.Where(song => song.Tempo is not null)];

    private IReadOnlyList<Section> Sections => _track?.Run?.Sections ?? [];

    private int? Primary =>
        _track?.Run?.Centre is { } centre
        && Sections.ToList().FindIndex(section => section.Centre == centre) is var index and >= 0
            ? index
            : null;

    /// <summary>The centre before any shift: the chosen section's, the track's, or the one picked.</summary>
    private TonalCentre? Own =>
        _track is null ? _hand
        : _section is { } index ? Sections[index].Centre
        : _track.Centre;

    /// <summary>A mixed verdict's primary pairs as its collapse; a section has no mix of its own.</summary>
    private bool Mixed => _track?.Run is { Mixed: true } && _section is null;

    private TonalCentre? Shown => Own?.Transposed(_shift);

    /// <summary>What the key picker shows: the centre as it pairs.</summary>
    private TonalCentre? Picked => Own is { } own ? Core.Pairing.Partners.Basis(own, Mixed) : null;

    private MusicKey? WheelWorking => Shown is { } shown ? MusicKey.Of(shown) : null;

    private MusicKey? WheelOwn => Own is { } own ? MusicKey.Of(own) : null;

    /// <summary>The track's tempo while one is picked, else the figure typed, which counts as vouched.</summary>
    private TrackTempo? Tempo =>
        _track?.Bpm
        ?? (Core.Pairing.RePitch.TryParseBpm(_bpmText, out var typed) ? TrackTempo.Typed(typed.Value) : null);

    private string? TrackFamiliarity =>
        _track is null ? null : FamiliarityRecords.Read().GetValueOrDefault(_track.Song)?.Written;

    private string? DetailsHref =>
        _track is null
            ? null
            : Tracks.Current?.Rows.FirstOrDefault(row => row.Song.Equals(_track.Song, StringComparison.OrdinalIgnoreCase)) is { } row
                ? $"song/{Uri.EscapeDataString(row.VideoId)}"
                : null;

    protected override void OnInitialized()
    {
        RePitchFolded ??= HttpContext?.Request.Cookies[RePitchCookie] is "folded";
        _rePitchOpen = RePitchFolded is not true;

        if (TrackFromQuery is null && KeyFromQuery is null && BpmFromQuery is null && Memory.Query is { Length: > 0 } last)
        {
            Navigation.NavigateTo($"tools{last}", replace: true);
            return;
        }

        if (TrackFromQuery is { } id && Warped.FirstOrDefault(song => song.Song.Equals(id, StringComparison.OrdinalIgnoreCase)) is { } track)
        {
            Select(track);
            _section = SectionFromQuery is { } section && section >= 0 && section < Sections.Count && section != Primary ? section : null;
        }
        else
        {
            _hand = ParseCentre(KeyFromQuery);
            _bpmText = BpmFromQuery ?? string.Empty;
        }

        _shift = Math.Clamp(ShiftFromQuery ?? 0, -Core.Pairing.RePitch.MaxShift, Core.Pairing.RePitch.MaxShift);
        _rePitchMax = Math.Max(_rePitchMax, Math.Abs(_shift));

        var widest = Core.Pairing.Partners.WidestShift;
        var lowest = Math.Clamp(LowestFromQuery ?? 0, -widest, widest);
        var highest = Math.Clamp(HighestFromQuery ?? 0, -widest, widest);
        (_lowest, _highest) = lowest <= highest ? (lowest, highest) : (0, 0);

        Recalculate();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Tools.razor.js");
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
                await _module.DisposeAsync();
        }
        // The circuit is already gone when the tab is closed.
        catch (JSDisconnectedException) { }
    }

    private void Select(LibrarySong track)
    {
        _track = track;
        _hand = null;
        _section = null;
        _bpmText = track.Bpm is { } tempo ? TempoFormat.Format(tempo).Figure : string.Empty;
    }

    private Task Pick(LibrarySong track) =>
        Change(() =>
        {
            Select(track);
            _shift = 0;
        });

    private Task PickCentre(TonalCentre? centre) =>
        Change(() =>
        {
            _track = null;
            _section = null;
            _hand = centre;
            _shift = 0;
        });

    private Task TypeBpm(string bpm) =>
        Change(() =>
        {
            _hand = Picked;
            _track = null;
            _section = null;
            _bpmText = bpm;
        });

    private Task ChooseShift(int shift) => Change(() => _shift = shift);

    // A Re-Pitch shift was a shift of the previous source.
    private Task ChooseSection(int? section) =>
        Change(() =>
        {
            _section = section;
            _shift = 0;
        });

    private Task ChooseSpan((int Lowest, int Highest) span) => Change(() => (_lowest, _highest) = span);

    private async Task ToggleRePitch()
    {
        _rePitchOpen = !_rePitchOpen;

        if (_module is not null)
            await _module.InvokeVoidAsync("remember", RePitchCookie, _rePitchOpen ? "open" : "folded");
    }

    /// <summary>Applies a change, recomputes the partners, and puts the state in the address.</summary>
    private async Task Change(Action change)
    {
        change();
        Recalculate();

        Memory.Query = Query();

        if (_module is not null)
            await _module.InvokeVoidAsync("replace", $"tools{Memory.Query}");
    }

    private void Recalculate() =>
        _partners = Shown is { } shown
            ? Core.Pairing.Partners.For(Core.Pairing.Partners.Basis(shown, Mixed), _lowest, _highest)
            : [];

    /// <summary>A key from the address: <c>a-dorian</c>, or a 24-key name from before modes.</summary>
    private static TonalCentre? ParseCentre(string? text) =>
        text?.Split('-') is [var tonic, var mode]
        && TonalCentre.Tonics.FirstOrDefault(known => known.Equals(tonic, StringComparison.OrdinalIgnoreCase)) is { } known
            ? mode.ToLowerInvariant() switch
            {
                "major" => new(known, DiatonicMode.Ionian),
                "minor" => new(known, DiatonicMode.Aeolian),
                _ when Enum.TryParse<DiatonicMode>(mode, ignoreCase: true, out var diatonic) => new(known, diatonic),
                _ => null,
            }
            : TonalCentre.FromKey(text);

    private static string Slug(TonalCentre centre) =>
        $"{centre.Tonic.ToLowerInvariant()}-{(centre.IsModal ? centre.Mode.ToString().ToLowerInvariant() : centre.Collapsed.Split(' ')[1])}";

    private string Query()
    {
        var parts = new List<string>();

        if (_track is not null)
        {
            parts.Add($"track={Uri.EscapeDataString(_track.Song)}");

            if (_section is { } section)
                parts.Add($"section={section}");
        }
        else
        {
            if (_hand is { } hand)
                parts.Add($"key={Uri.EscapeDataString(Slug(hand))}");

            if (_bpmText.Trim().Length > 0)
                parts.Add($"bpm={Uri.EscapeDataString(_bpmText.Trim())}");
        }

        if (_shift is not 0)
            parts.Add($"shift={_shift}");

        if ((_lowest, _highest) is not (0, 0))
            parts.Add($"lo={_lowest}&hi={_highest}");

        return parts.Count is 0 ? string.Empty : $"?{string.Join('&', parts)}";
    }
}
