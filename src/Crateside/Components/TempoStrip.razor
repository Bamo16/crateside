@using System.Globalization

@if (Tempo.Windows is { Count: > 0 } windows)
{
    var slots = windows.Max(window => window.Index) + 1;

    <div class="strip">
        <div class="edges mono"><span>@High</span><span>@Low</span></div>
        <div class="plot">
            <div class="shown" style="top: @Top(Tempo.Value)"></div>
            <div class="slots">
                @for (var i = 0; i < slots; i++)
                {
                    var index = i;

                    @if (windows.FirstOrDefault(window => window.Index == index) is { Bpm: > 0 } window)
                    {
                        <div class="slot" title="@TempoFormat.Window(index, window.Bpm)">
                            <span class="tick" style="top: @Top(window.Bpm)"></span>
                        </div>
                    }
                    else
                    {
                        <div class="slot"></div>
                    }
                }
            </div>
        </div>
        <span></span>
        <div class="times mono"><span>@TempoFormat.Clock(0)</span><span>@TempoFormat.Clock(slots * 30)</span></div>
    </div>
}

@code {
    /// <summary>A drifting tempo; the strip shows where in the track it drifts (handoff 13, 2b).</summary>
    [Parameter, EditorRequired]
    public required TrackTempo Tempo { get; set; }

    private int Low => Tempo.Range is var (low, _) ? TempoFormat.Edge(low, up: false) : 0;

    private int High => Math.Max(Low + 1, Tempo.Range is var (_, high) ? TempoFormat.Edge(high, up: true) : 0);

    private string Top(double figure) =>
        string.Create(CultureInfo.InvariantCulture, $"{Math.Clamp((High - figure) / (High - Low), 0, 1) * 100:0.0}%");
}
