@using Crateside.Core.Orchestration.Jobs
@using Crateside.Core.Tracks
@inject JobStore Jobs
@inject ActionLog Actions

<div class="flow">
    <div class="pass">
        <span>Pass @_flow.Pass · @_flow.Reason</span>
        @if (_flow.Pass > 1)
        {
            <a href="@($"song/{Uri.EscapeDataString(Row.TrackKey)}#activity")">@("earlier pass".ToQuantity(_flow.Pass - 1)) ↓</a>
        }
    </div>

    <div class="steps">
        @foreach (var (step, index) in _flow.Steps.Select((step, index) => (step, index)))
        {
            @if (index > 0)
            {
                <span class="rule"></span>
            }
            <span class="chip @Class(step.State)">
                @Glyph(step.State) @step.Label@(step.Note is { } note ? $" · {note}" : null)
            </span>
        }
    </div>
</div>

@code {
    private StageFlow _flow = new(1, string.Empty, []);

    [Parameter, EditorRequired]
    public required TrackRow Row { get; set; }

    protected override void OnParametersSet() =>
        _flow = StageFlow.For(
            Row,
            stage => Jobs.TryGet(Row.TrackKey, stage, out var job) ? job : null,
            Actions.For(Row.TrackKey)
        );

    private static string Glyph(FlowState state) =>
        state switch
        {
            FlowState.Done => "✓",
            FlowState.Running or FlowState.YourTurn => "●",
            FlowState.Skipped => "–",
            FlowState.Parked or FlowState.GaveUp => "■",
            _ => "○",
        };

    private static string Class(FlowState state) =>
        state switch
        {
            FlowState.Done => "done",
            FlowState.Running => "running",
            FlowState.YourTurn => "yours",
            FlowState.Skipped => "skipped",
            FlowState.Parked => "parked",
            FlowState.GaveUp => "gave-up",
            _ => "not-yet",
        };
}
