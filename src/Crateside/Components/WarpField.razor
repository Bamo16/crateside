<div class="field" data-field>
    <div class="braces" data-braces hidden>
        <span class="brace-bar" data-brace="body" role="button" tabindex="0" aria-label="Loop: move both braces"></span>
        <span class="brace-end start" data-brace="start" role="slider" tabindex="0"></span>
        <span class="brace-end end" data-brace="end" role="slider" tabindex="0"></span>
    </div>
    <span class="seekline" data-seekline aria-hidden="true" hidden></span>
    <span class="playhead" data-playhead aria-hidden="true"></span>
</div>
