@using Crateside.Core.Orchestration.Jobs
@using Humanizer

@{
    var view = Feed.PageOf(Query);
    var news = Feed.NewSince(Query);
}

<div class="activity">
    <div class="filters">
        <span class="caps">Stage</span>
        <button class="pill @(Query.Stages.Count is 0 ? "on plain" : "off")" aria-pressed="@(Query.Stages.Count is 0)"
                @onclick="() => Change(Query with { Stages = new HashSet<JobStage>() })">
            All <span class="mono count">@Feed.Count(null).ToString("N0")</span>
        </button>
        @foreach (var (stage, label) in Stages)
        {
            var on = Query.Stages.Contains(stage);
            <button class="pill @(on ? "on plain" : "off")" aria-pressed="@on" @onclick="() => ToggleStage(stage)">
                @label <span class="mono count">@Feed.Count(stage).ToString("N0")</span>
            </button>
        }
        <span class="divider"></span>
        <button class="pill @(Query.FailedOnly ? "on red" : "off")" aria-pressed="@Query.FailedOnly"
                @onclick="() => Change(Query with { FailedOnly = !Query.FailedOnly })">
            Failed or canceled <span class="mono count">@Feed.FailedOrCanceled.ToString("N0")</span>
        </button>
        <span class="hint">Pick several stages; All clears them. Remembered with the folds.</span>
    </div>

    <div class="box">
        @if (news > 0)
        {
            <button class="new" @onclick="() => Change(Query with { Page = 1, AnchorSequence = null }, keepAnchor: true)">
                ↑ @news new since you paged away · back to page 1
            </button>
        }

        @if (view.Total is 0)
        {
            <p class="none">
                Nothing with these filters yet.
                <button class="link" @onclick="() => Change(new ActivityQuery { PageSize = Query.PageSize })">Clear them</button>
            </p>
        }
        else
        {
            <div class="head row-grid" aria-hidden="true">
                <span></span>
                <span>Started</span>
                <span>Stage</span>
                <span>Track</span>
                <span>Result · click for all of it</span>
                <span class="took">Took</span>
            </div>

            string? bucket = null;
            ActivityAction? above = null;

            @foreach (var action in view.Actions)
            {
                var group = ActivityFeed.BucketOf(action.StartedAt, Now);
                var starts = group.Label != bucket;
                var name = NameOf(action.TrackKey);
                var open = _open.Contains(action.Sequence);
                var took = action.Took(Now);
                var recent = action.State is ActivityState.Done && Now - action.FinishedAt < ActivityFeed.Recent;
                var lead = action.State switch
                {
                    ActivityState.Failed => "failed: ",
                    ActivityState.Canceled => "canceled: ",
                    _ => string.Empty,
                };

                if (starts)
                {
                    bucket = group.Label;
                    <div class="bucket">
                        <span class="caps">@group.Label</span>
                        @if (group.Range.Length > 0)
                        {
                            <span class="mono range">@group.Range</span>
                        }
                    </div>
                }

                <div class="row row-grid @action.State.ToString().ToLowerInvariant()">
                    <span class="glyph" aria-label="@action.State.ToString().ToLowerInvariant()">
                        @switch (action.State)
                        {
                            case ActivityState.Running:
                                <span class="dot"></span>
                                break;
                            case ActivityState.Done:
                                <span class="mono check @(recent ? "recent" : null)">✓</span>
                                break;
                            case ActivityState.Failed:
                                <span class="cross">✕</span>
                                break;
                            default:
                                <span class="mono dash">–</span>
                                break;
                        }
                    </span>
                    <span class="mono at" title="@Ago(action)">@action.StartedAt.ToLocalTime().ToString("t")</span>
                    <span class="stage">@StageName(action.Stage)</span>
                    @if (!starts && above is { } previous && previous.TrackKey == action.TrackKey)
                    {
                        <span class="track same" aria-label="@name"><span class="rule"></span></span>
                    }
                    else
                    {
                        <a class="track" href="song/@Uri.EscapeDataString(action.TrackKey)" title="@name">@name</a>
                    }
                    <button class="result" aria-expanded="@open" title="@(lead + action.Text)"
                            @onclick="() => Toggle(action.Sequence)">
                        <span class="text">@(lead + action.Text)@(action.IsRunning ? " …" : null)</span>
                        <span class="mono caret">@(open ? "▾" : "▸")</span>
                    </button>
                    <span class="mono took">@Took(took, action.IsRunning)</span>
                </div>

                if (open)
                {
                    <div class="detail row-grid">
                        <div class="body">
                            <p class="whole">@(lead + action.Text)</p>
                            <p class="mono meta">@Meta(action, took)</p>
                            <p class="links">
                                <a href="song/@Uri.EscapeDataString(action.TrackKey)">Track details →</a>
                                <a class="quiet" href="song/@Uri.EscapeDataString(action.TrackKey)#activity">Its activity log →</a>
                            </p>
                        </div>
                    </div>
                }

                above = action;
            }
        }

        <div class="more">
            <span class="mono range-count">@(view.Total is 0 ? "0" : $"{view.First:N0}–{view.First + view.Actions.Count - 1:N0}") of @view.Total.ToString("N0")</span>
            <span class="per-page">
                Per page
                @foreach (var size in ActivityFeed.PageSizes)
                {
                    <button class="pill @(Query.PageSize == size ? "on plain" : "off")" aria-pressed="@(Query.PageSize == size)"
                            @onclick="() => Change(Query with { PageSize = size })">@size</button>
                }
            </span>
            <nav class="pager" aria-label="Pages">
                <button class="pill off" disabled="@(view.Page is 1)" @onclick="() => GoTo(view.Page - 1)">‹ Newer</button>
                @foreach (var link in ActivityFeed.PageLinks(view.Page, view.Pages))
                {
                    if (link is { } number)
                    {
                        <button class="pill @(number == view.Page ? "on plain" : "off") number" aria-current="@(number == view.Page ? "page" : null)"
                                @onclick="() => GoTo(number)">@number</button>
                    }
                    else
                    {
                        <span class="gap">…</span>
                    }
                }
                <button class="pill off" disabled="@(view.Page == view.Pages)" @onclick="() => GoTo(view.Page + 1)">Older ›</button>
            </nav>
        </div>
    </div>
</div>

@code {
    private static readonly (JobStage Stage, string Label)[] Stages =
    [
        (JobStage.Download, "Download"),
        (JobStage.Evidence, "Detection"),
        (JobStage.Verdict, "Judging"),
        (JobStage.Separation, "Separation"),
        (JobStage.Handoff, "Handoff"),
        (JobStage.Tagging, "Tagging"),
    ];

    private readonly HashSet<int> _open = [];

    [Parameter, EditorRequired]
    public required ActivityFeed Feed { get; set; }

    [Parameter, EditorRequired]
    public required ActivityQuery Query { get; set; }

    [Parameter, EditorRequired]
    public required Func<string, string> NameOf { get; set; }

    [Parameter, EditorRequired]
    public required DateTimeOffset Now { get; set; }

    [Parameter]
    public EventCallback<ActivityQuery> OnQuery { get; set; }

    public static string StageName(JobStage stage) => Stages.First(entry => entry.Stage == stage).Label;

    /// <summary>A duration as the table shows it: <c>3 min 21 s</c>, <c>14 s</c>, <c>&lt;1 s</c>.</summary>
    public static string Duration(TimeSpan span) =>
        span.TotalSeconds switch
        {
            < 1 => "<1 s",
            < 60 => $"{(int)span.TotalSeconds} s",
            _ when span.Seconds is 0 && span.Hours is 0 => $"{(int)span.TotalMinutes} min",
            _ when span.TotalHours < 1 => $"{(int)span.TotalMinutes} min {span.Seconds} s",
            _ => $"{(int)span.TotalHours} h {span.Minutes} min",
        };

    private static string Took(TimeSpan? took, bool running) =>
        took is not { } span ? "—" : running ? $"{Duration(span)} so far" : Duration(span);

    private string Ago(ActivityAction action) =>
        Now - action.StartedAt is { TotalMinutes: < 1 }
            ? "just now"
            : $"{(Now - action.StartedAt).Humanize(minUnit: TimeUnit.Minute)} ago";

    private string Meta(ActivityAction action, TimeSpan? took)
    {
        var parts = new List<string> { $"started {action.StartedAt.ToLocalTime():T}" };

        if (action.FinishedAt is { } finished)
        {
            var verb = action.State switch
            {
                ActivityState.Failed => "failed",
                ActivityState.Canceled => "canceled",
                ActivityState.Held => "held",
                _ => "finished",
            };
            parts.Add($"{verb} {finished.ToLocalTime():T}");
        }

        if (took is { } span)
            parts.Add(action.IsRunning ? $"running {Duration(span)}" : Duration(span));

        parts.Add(action.Id);

        return string.Join(" · ", parts);
    }

    private Task ToggleStage(JobStage stage)
    {
        HashSet<JobStage> stages = [.. Query.Stages];

        if (!stages.Remove(stage))
            stages.Add(stage);

        return Change(Query with { Stages = stages });
    }

    private void Toggle(int sequence)
    {
        if (!_open.Remove(sequence))
            _open.Add(sequence);
    }

    /// <summary>Leaving page 1 holds the list still at its newest start; coming back lets new rows in.</summary>
    private Task GoTo(int number) =>
        number <= 1
            ? Change(Query with { Page = 1, AnchorSequence = null }, keepAnchor: true)
            : Change(
                Query with
                {
                    Page = number,
                    AnchorSequence = Query.AnchorSequence ?? Feed.Actions.FirstOrDefault()?.Sequence,
                },
                keepAnchor: true
            );

    /// <summary>A change of filter or page size starts over at page 1, live.</summary>
    private Task Change(ActivityQuery query, bool keepAnchor = false) =>
        OnQuery.InvokeAsync(keepAnchor ? query : query with { Page = 1, AnchorSequence = null });
}
