<button class="refresh @(Busy ? "busy" : null)" title="@Title" aria-label="@Title" disabled="@Busy" @onclick="OnClick">
    <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8" />
        <path d="M21 3v5h-5" />
    </svg>
</button>

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    /// <summary>Spins the icon and ignores clicks until the refresh it started has finished.</summary>
    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }
}
