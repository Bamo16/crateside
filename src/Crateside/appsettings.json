{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Four lines per request, and a failure's whole stack trace, for calls whose callers already
      // handle a failure (the quota poll shows "unknown").
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Everything crateside reads. Defaults live in CratesidePaths; these are here so the
  // paths are discoverable and overridable without a rebuild. All read-only.
  "Paths": {
    "StagingFolder": "P:\\RYAN\\Ableton\\Sample Staging",
    "LibraryFolder": "P:\\RYAN\\Ableton\\Mashup Samples"
  },

  // Whether staged stems take a warp their siblings already have, without being asked
  // (ADR 0043), and what stems of an upload nothing is warped on get: Off, or OnTheGrid (one
  // marker on a beat, the clip starting on it; ADR 0047, 0048, 0054). Settings overrides
  // StarterWarps.
  "Warps": {
    "LendAutomatically": true,
    "StarterWarps": "OnTheGrid"
  },

  // The integrated loudness (LUFS) every sample's default clip is given a gain to reach, and the
  // floor below which a stem is residue and stays at 0 dB, as drums do (ADR 0059). Changing either
  // re-levels every saved sidecar within a minute.
  "Loudness": {
    "TargetLufs": -14,
    "FloorLufs": -24
  },

  // The playlist ID is not a secret, and is normally set from the Queue page rather than
  // here — the UI writes it to %APPDATA%\crateside\queue.json, which wins over this. This
  // is only a seed for a first run. The API key is a secret and is never in either place;
  // it lives in user-secrets. See docs/secrets.md.
  "Queue": {
    "PlaylistId": ""
  }
}
